<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartStore</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/SmartStore.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" />
    <!-- Boxicons -->
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    <!-- Chatbot CSS -->
    <link rel="stylesheet" href="~/css/chatbot.css" asp-append-version="true" />
</head>
<body>
    <main role="main">
        @RenderBody()
    </main>

    <!-- Chatbot Toggle Trigger -->
    <button class="chatbot-toggle" title="SmartStore Chatbot">
        <i class='bx bx-message-square-dots'></i>
    </button>

    <!-- Chatbot Window -->
    <div class="chatbot-window">
        <div class="chatbot-header">
            <div class="chatbot-header-info">
                <div class="chatbot-header-logo">
                    <i class='bx bx-bot'></i>
                </div>
                <div class="chatbot-header-text">
                    <h3>SmartStore Bot</h3>
                    <span>نشط الآن</span>
                </div>
            </div>
            <button class="chatbot-close"><i class='bx bx-x'></i></button>
        </div>
        <div class="chatbot-messages">
            <!-- Messages will be rendered dynamically -->
        </div>
        <div class="chatbot-footer">
            <input type="text" class="chatbot-input" placeholder="اكتب رسالتك هنا..." />
            <button class="chatbot-send-btn">
                <i class='bx bx-send'></i>
            </button>
        </div>
    </div>

    <!-- Chatbot JS -->
    <script src="~/js/chatbot.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
