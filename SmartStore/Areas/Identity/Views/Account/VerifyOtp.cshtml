@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Verify Code";
    var email = TempData["OtpEmail"]?.ToString();
    var code = TempData["OtpCode"]?.ToString();
    TempData.Keep("OtpEmail");
    TempData.Keep("OtpCode");
}

<!-- Verify Code Navigation Header -->
<div class="auth-nav-header">
    <a asp-area="Identity" asp-controller="Account" asp-action="ForgotPassword" class="back-btn-circle" title="Back">
        <i class='bx bx-chevron-left'></i>
    </a>
</div>

<div class="auth-form-header">
    <h2>Verify Code</h2>
    <p>Please enter the code we just sent to email <span style="font-weight: 600; color: var(--ink);">@email</span></p>
</div>

<!-- ── Developer Testing Banner ── -->
@if (!string.IsNullOrEmpty(code))
{
    <div class="auth-alert alert-success" style="margin-bottom: 16px;">
        <i class='bx bx-code-alt' style="font-size: 16px;"></i>
        <div>
            <strong>[Dev Mode]</strong> Simulated OTP: <strong style="font-size: 15px; color: var(--success);">@code</strong>
        </div>
    </div>
}

<form asp-area="Identity" asp-controller="Account" asp-action="VerifyOtp" method="post" class="auth-form" id="otpForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Email" value="@email" />
    <input type="hidden" name="Code" id="fullOtpCode" />

    <div asp-validation-summary="ModelOnly" class="auth-alert alert-error"></div>

    <div class="otp-grid">
        <input type="text" maxlength="1" class="otp-input" id="otp1" required autocomplete="off" inputmode="numeric" placeholder="-" />
        <input type="text" maxlength="1" class="otp-input" id="otp2" required autocomplete="off" inputmode="numeric" placeholder="-" />
        <input type="text" maxlength="1" class="otp-input" id="otp3" required autocomplete="off" inputmode="numeric" placeholder="-" />
        <input type="text" maxlength="1" class="otp-input" id="otp4" required autocomplete="off" inputmode="numeric" placeholder="-" />
    </div>

    <button type="submit" class="auth-submit-btn" id="verifySubmitBtn">
        <span id="submitLabel">Verify</span>
        <div class="btn-spinner" id="verifySpinner"></div>
    </button>
</form>

<div class="auth-footer-note">
    Didn't receive OTP? <a asp-area="Identity" asp-controller="Account" asp-action="ForgotPassword">Resend code</a>
</div>

@section Scripts {
<script>
(function () {
    const inputs = document.querySelectorAll(".otp-input");
    const fullCodeInput = document.getElementById("fullOtpCode");

    // Auto-focus first input
    inputs[0]?.focus();

    inputs.forEach((input, index) => {
        input.addEventListener("input", (e) => {
            // Allow only numbers
            e.target.value = e.target.value.replace(/[^0-9]/g, '');

            if (e.target.value.length === 1 && index < inputs.length - 1) {
                inputs[index + 1].focus();
            }
            combineOtp();
        });

        input.addEventListener("keydown", (e) => {
            if (e.key === "Backspace" && e.target.value.length === 0 && index > 0) {
                inputs[index - 1].focus();
            }
        });

        // Paste handler
        input.addEventListener("paste", (e) => {
            const pasteData = e.clipboardData.getData("text").trim();
            if (/^\d{4}$/.test(pasteData)) {
                inputs.forEach((inp, idx) => {
                    inp.value = pasteData[idx];
                });
                combineOtp();
                inputs[3].focus();
            }
            e.preventDefault();
        });
    });

    function combineOtp() {
        let code = "";
        inputs.forEach(input => code += input.value);
        if (fullCodeInput) fullCodeInput.value = code;
    }

    // Spinner on submit
    const form = document.getElementById("otpForm");
    if (form) {
        form.addEventListener("submit", function (e) {
            combineOtp();
            if (fullCodeInput && fullCodeInput.value.length === 4) {
                const btn = document.getElementById("verifySubmitBtn");
                const spinner = document.getElementById("verifySpinner");
                const label = document.getElementById("submitLabel");
                
                if (btn) btn.disabled = true;
                if (spinner) spinner.style.display = "inline-block";
                if (label) label.style.display = "none";
            } else {
                e.preventDefault();
            }
        });
    }
})();
</script>
}
