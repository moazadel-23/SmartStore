@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Verify Code";
    var email = TempData["OtpEmail"]?.ToString();
    var code = TempData["OtpCode"]?.ToString();
    // Keep TempData values for post request or resend
    TempData.Keep("OtpEmail");
    TempData.Keep("OtpCode");
}

<div class="auth-form-header">
    <a asp-area="Identity" asp-controller="Account" asp-action="ForgotPassword" class="auth-back-link">
        <i class='bx bx-arrow-back'></i> Back
    </a>
    <h2>Verify Code</h2>
    <p>Enter the 4-digit code sent to your email address.</p>
</div>

<!-- ── Developer Testing Banner ── -->
@if (!string.IsNullOrEmpty(code))
{
    <div class="auth-alert alert-success" style="margin-bottom: 24px;">
        <i class='bx bx-code-alt'></i>
        <div>
            <strong>[Development Mode]</strong><br />
            Simulated OTP Code: <strong style="font-size: 16px; color: var(--success);">@code</strong>
        </div>
    </div>
}

<div class="otp-illustration">
    <svg class="otp-svg" viewBox="0 0 100 100" width="80" height="80" xmlns="http://www.w3.org/2000/svg">
        <!-- phone -->
        <rect x="36" y="15" width="28" height="56" rx="5" fill="#f3f0ff" stroke="#6c5ce7" stroke-width="2" />
        <!-- phone notch -->
        <line x1="46" y1="19" x2="54" y2="19" stroke="#6c5ce7" stroke-width="2" stroke-linecap="round" />
        <!-- envelope message overlapping -->
        <rect x="18" y="32" width="34" height="22" rx="3" fill="#ffffff" stroke="#6c5ce7" stroke-width="2.2" />
        <path d="M18 36 l17 9 l17 -9" stroke="#6c5ce7" stroke-width="1.8" fill="none" stroke-linejoin="round" />
    </svg>
</div>

<form asp-area="Identity" asp-controller="Account" asp-action="VerifyOtp" method="post" class="auth-form" id="otpForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Email" value="@email" />
    <input type="hidden" name="Code" id="fullOtpCode" />

    <div asp-validation-summary="ModelOnly" class="auth-alert alert-error"></div>

    <div class="otp-grid">
        <input type="text" maxlength="1" class="otp-input" id="otp1" required autocomplete="off" inputmode="numeric" />
        <input type="text" maxlength="1" class="otp-input" id="otp2" required autocomplete="off" inputmode="numeric" />
        <input type="text" maxlength="1" class="otp-input" id="otp3" required autocomplete="off" inputmode="numeric" />
        <input type="text" maxlength="1" class="otp-input" id="otp4" required autocomplete="off" inputmode="numeric" />
    </div>

    <button type="submit" class="auth-submit-btn">
        Verify Code
    </button>
</form>

<div class="auth-footer-note">
    Didn't receive the code? <a asp-area="Identity" asp-controller="Account" asp-action="ForgotPassword">Resend</a>
</div>

@section Scripts {
<script>
(function () {
    const inputs = document.querySelectorAll(".otp-input");
    const fullCodeInput = document.getElementById("fullOtpCode");

    // Auto-focus first input
    inputs[0]?.focus();

    inputs.forEach((input, index) => {
        input.addEventListener("input", (e) => {
            // Allow only numbers
            e.target.value = e.target.value.replace(/[^0-9]/g, '');

            if (e.target.value.length === 1 && index < inputs.length - 1) {
                inputs[index + 1].focus();
            }
            combineOtp();
        });

        input.addEventListener("keydown", (e) => {
            if (e.key === "Backspace" && e.target.value.length === 0 && index > 0) {
                inputs[index - 1].focus();
            }
        });

        // Paste handler
        input.addEventListener("paste", (e) => {
            const pasteData = e.clipboardData.getData("text").trim();
            if (/^\d{4}$/.test(pasteData)) {
                inputs.forEach((inp, idx) => {
                    inp.value = pasteData[idx];
                });
                combineOtp();
                inputs[3].focus();
            }
            e.preventDefault();
        });
    });

    function combineOtp() {
        let code = "";
        inputs.forEach(input => code += input.value);
        if (fullCodeInput) fullCodeInput.value = code;
    }
})();
</script>
}
