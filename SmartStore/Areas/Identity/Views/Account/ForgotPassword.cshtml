@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Forgot Password";
}

<!-- ── Page Header ── -->
<div class="auth-form-header">
    <a asp-area="Identity" asp-controller="Account" asp-action="Login" class="auth-back-link">
        <i class='bx bx-arrow-back'></i> Back to Sign In
    </a>
    <h2>Forgot Password?</h2>
    <p>No worries! Enter your email and we'll send you a reset link.</p>
</div>

<!-- ── Form ── -->
<form asp-area="Identity" asp-controller="Account" asp-action="ForgotPassword"
      method="post" id="forgotForm" novalidate>
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="auth-alert alert-error"></div>

    <div class="auth-field">
        <div class="input-wrap">
            <input type="email" id="ForgotEmail" name="Email"
                   class="auth-input" placeholder=" "
                   autocomplete="email" required>
            <label for="ForgotEmail" class="auth-label">Email Address</label>
        </div>
        <span class="field-error" id="err-forgot-email"></span>
    </div>

    <button type="submit" class="auth-submit-btn" id="forgotSubmitBtn">
        <span id="forgotLabel">Continue</span>
        <div class="btn-spinner" id="forgotSpinner"></div>
    </button>
</form>

<div class="auth-footer-note" style="margin-top:28px;">
    Remember your password?
    <a asp-area="Identity" asp-controller="Account" asp-action="Login">Sign in</a>
</div>

@section Scripts {
<script>
(function () {
    function showErr(id, msg) {
        const el = document.getElementById(id);
        if (!el) return;
        el.innerHTML = msg ? `<i class='bx bx-error-circle'></i>${msg}` : '';
    }

    document.getElementById('forgotForm')?.addEventListener('submit', function (e) {
        const em = document.getElementById('ForgotEmail');
        const emailRe = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
        if (!em?.value.trim() || !emailRe.test(em.value)) {
            e.preventDefault();
            showErr('err-forgot-email', 'Please enter a valid email address');
            em?.classList.add('input-error');
            return;
        }
        showErr('err-forgot-email', '');
        em?.classList.remove('input-error');
        em?.classList.add('input-valid');
        const btn = document.getElementById('forgotSubmitBtn');
        const lbl = document.getElementById('forgotLabel');
        const sp  = document.getElementById('forgotSpinner');
        if (btn) btn.disabled = true;
        if (lbl) lbl.textContent = 'Sending…';
        if (sp)  sp.style.display = 'block';
    });

    /* entrance animation */
    document.querySelectorAll('.auth-form-header, .auth-field, .auth-submit-btn, .auth-footer-note').forEach((el, i) => {
        el.style.opacity = '0';
        el.style.transform = 'translateY(14px)';
        setTimeout(() => {
            el.style.transition = 'opacity .38s ease, transform .38s ease';
            el.style.opacity = '1';
            el.style.transform = 'translateY(0)';
        }, 50 + i * 70);
    });
})();
</script>
}
