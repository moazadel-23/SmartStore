@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Reset Password";
}

<!-- Reset Password Navigation Header -->
<div class="auth-nav-header">
    <a asp-area="Identity" asp-controller="Account" asp-action="Login" class="back-btn-circle" title="Back to Sign In">
        <i class='bx bx-chevron-left'></i>
    </a>
</div>

<div class="auth-form-header">
    <h2>Reset Password</h2>
    <p>Create a new strong password for your account.</p>
</div>

<form asp-area="Identity" asp-controller="Account" asp-action="ResetPassword" method="post" id="resetForm" novalidate class="auth-form">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Token" value="@ViewData["Token"]">
    <input type="hidden" name="Email" value="@ViewData["Email"]">

    <div asp-validation-summary="ModelOnly" class="auth-alert alert-error"></div>

    <!-- New Password Field -->
    <div class="auth-field">
        <label for="NewPassword" class="field-label">New Password</label>
        <div class="input-wrap">
            <input type="password" id="NewPassword" name="NewPassword" class="auth-input pw-field" placeholder="••••••••" autocomplete="new-password" required>
            <button type="button" class="pw-toggle" id="toggleNewPw" aria-label="Toggle password visibility">
                <i class='bx bx-hide' id="newEyeIcon"></i>
            </button>
        </div>
        <span class="field-error" id="err-new-pw"></span>
    </div>

    <!-- Confirm New Password Field -->
    <div class="auth-field">
        <label for="ConfirmNewPassword" class="field-label">Confirm New Password</label>
        <div class="input-wrap">
            <input type="password" id="ConfirmNewPassword" name="ConfirmNewPassword" class="auth-input pw-field" placeholder="••••••••" autocomplete="new-password" required>
            <button type="button" class="pw-toggle" id="toggleConfirmNewPw" aria-label="Toggle password visibility">
                <i class='bx bx-hide' id="confirmNewEyeIcon"></i>
            </button>
        </div>
        <span class="field-error" id="err-confirm-new-pw"></span>
    </div>

    <!-- Submit Button -->
    <button type="submit" class="auth-submit-btn" id="resetSubmitBtn">
        <span id="resetLabel">Reset Password</span>
        <div class="btn-spinner" id="resetSpinner"></div>
    </button>
</form>

<div class="auth-footer-note" style="margin-top:24px;">
    <i class='bx bx-shield-quarter' style="font-size: 16px; vertical-align: middle;"></i> Passwords are stored securely
</div>

@section Scripts {
<script>
(function () {
    const $ = id => document.getElementById(id);

    // Password toggle visibility helpers
    function pwToggle(btnId, inputId, iconId) {
        $(btnId)?.addEventListener('click', () => {
            const inp = $(inputId), icon = $(iconId);
            if (!inp || !icon) return;
            const h = inp.type === 'password';
            inp.type = h ? 'text' : 'password';
            icon.className = h ? 'bx bx-show' : 'bx bx-hide';
        });
    }
    pwToggle('toggleNewPw',        'NewPassword',        'newEyeIcon');
    pwToggle('toggleConfirmNewPw', 'ConfirmNewPassword', 'confirmNewEyeIcon');

    // Validation
    function showErr(id, msg) {
        const el = $(id); if (!el) return;
        el.innerHTML = msg ? `<i class='bx bx-error-circle'></i> ${msg}` : '';
    }

    $('resetForm')?.addEventListener('submit', function (e) {
        let ok = true;
        const pw = $('NewPassword'), cp = $('ConfirmNewPassword');

        if (!pw?.value) {
            showErr('err-new-pw', 'New password is required');
            pw?.classList.add('input-error');
            ok = false;
        } else if (pw.value.length < 8) {
            showErr('err-new-pw', 'Password must be at least 8 characters');
            pw?.classList.add('input-error');
            ok = false;
        } else {
            showErr('err-new-pw', '');
            pw?.classList.remove('input-error');
        }

        if (!cp?.value) {
            showErr('err-confirm-new-pw', 'Please confirm your password');
            cp?.classList.add('input-error');
            ok = false;
        } else if (cp.value !== pw?.value) {
            showErr('err-confirm-new-pw', 'Passwords do not match');
            cp?.classList.add('input-error');
            ok = false;
        } else {
            showErr('err-confirm-new-pw', '');
            cp?.classList.remove('input-error');
        }

        if (!ok) {
            e.preventDefault();
            return;
        }
        
        const btn = $('resetSubmitBtn'), lbl = $('resetLabel'), sp = $('resetSpinner');
        if (btn) btn.disabled = true;
        if (lbl) lbl.style.display = 'none';
        if (sp)  sp.style.display = 'block';
    });
})();
</script>
}
