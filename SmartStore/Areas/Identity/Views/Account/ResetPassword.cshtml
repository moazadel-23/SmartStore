@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Reset Password";
}

<!-- ── Page Header ── -->
<div class="auth-form-header">
    <a asp-area="Identity" asp-controller="Account" asp-action="Login" class="auth-back-link">
        <i class='bx bx-arrow-back'></i> Back to Sign In
    </a>
    <h2>Reset Password</h2>
    <p>Create a new strong password for your account.</p>
</div>

<!-- ── Form ── -->
<form asp-area="Identity" asp-controller="Account" asp-action="ResetPassword"
      method="post" id="resetForm" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" name="Token" value="@ViewData["Token"]">
    <input type="hidden" name="Email" value="@ViewData["Email"]">

    <!-- New Password -->
    <div class="auth-field">
        <div class="input-wrap">
            <input type="password" id="NewPassword" name="NewPassword"
                   class="auth-input" placeholder=" "
                   autocomplete="new-password" required>
            <label for="NewPassword" class="auth-label">New Password</label>
            <button type="button" class="pw-toggle" id="toggleNewPw" aria-label="Toggle">
                <i class='bx bx-hide' id="newEyeIcon"></i>
            </button>
        </div>
        <span class="field-error" id="err-new-pw"></span>
    </div>

    <!-- Confirm New Password -->
    <div class="auth-field">
        <div class="input-wrap">
            <input type="password" id="ConfirmNewPassword" name="ConfirmNewPassword"
                   class="auth-input" placeholder=" "
                   autocomplete="new-password" required>
            <label for="ConfirmNewPassword" class="auth-label">Confirm New Password</label>
            <button type="button" class="pw-toggle" id="toggleConfirmNewPw" aria-label="Toggle">
                <i class='bx bx-hide' id="confirmNewEyeIcon"></i>
            </button>
        </div>
        <span class="field-error" id="err-confirm-new-pw"></span>
    </div>

    <button type="submit" class="auth-submit-btn" id="resetSubmitBtn">
        <i class='bx bx-shield-check'></i>
        <span id="resetLabel">Reset Password</span>
        <div class="btn-spinner" id="resetSpinner"></div>
    </button>
</form>

<div class="auth-footer-note" style="margin-top:24px;">
    <i class='bx bx-shield-quarter'></i>
    Passwords are encrypted and stored securely.
</div>

@section Scripts {
<script>
(function () {
    const $ = id => document.getElementById(id);

    /* ── Toggle helpers ── */
    function pwToggle(btnId, inputId, iconId) {
        $(btnId)?.addEventListener('click', () => {
            const inp = $(inputId), icon = $(iconId);
            if (!inp || !icon) return;
            const h = inp.type === 'password';
            inp.type = h ? 'text' : 'password';
            icon.className = h ? 'bx bx-show' : 'bx bx-hide';
        });
    }
    pwToggle('toggleNewPw',        'NewPassword',        'newEyeIcon');
    pwToggle('toggleConfirmNewPw', 'ConfirmNewPassword', 'confirmNewEyeIcon');

    /* ── Submit validation ── */
    function showErr(id, msg) {
        const el = $(id); if (!el) return;
        el.innerHTML = msg ? `<i class='bx bx-error-circle'></i>${msg}` : '';
    }

    $('resetForm')?.addEventListener('submit', function (e) {
        let ok = true;
        const pw = $('NewPassword'), cp = $('ConfirmNewPassword');

        if (!pw?.value) {
            showErr('err-new-pw', 'New password is required');
            pw?.classList.add('input-error');
            ok = false;
        } else if (pw.value.length < 8) {
            showErr('err-new-pw', 'Password must be at least 8 characters');
            pw?.classList.add('input-error');
            ok = false;
        } else {
            showErr('err-new-pw', '');
            pw?.classList.remove('input-error');
            pw?.classList.add('input-valid');
        }

        if (!cp?.value)              { showErr('err-confirm-new-pw', 'Please confirm your password'); cp?.classList.add('input-error'); ok = false; }
        else if (cp.value !== pw?.value) { showErr('err-confirm-new-pw', 'Passwords do not match'); cp?.classList.add('input-error'); ok = false; }
        else                         { showErr('err-confirm-new-pw', ''); cp?.classList.remove('input-error'); cp?.classList.add('input-valid'); }

        if (!ok) { e.preventDefault(); return; }
        const btn = $('resetSubmitBtn'), lbl = $('resetLabel'), sp = $('resetSpinner');
        if (btn) btn.disabled = true;
        if (lbl) lbl.textContent = 'Resetting…';
        if (sp)  sp.style.display = 'block';
    });

    /* ── Entrance ── */
    document.querySelectorAll('.auth-form-header, .auth-field, .auth-submit-btn, .auth-footer-note').forEach((el, i) => {
        el.style.opacity = '0'; el.style.transform = 'translateY(14px)';
        setTimeout(() => {
            el.style.transition = 'opacity .38s ease, transform .38s ease';
            el.style.opacity = '1'; el.style.transform = 'translateY(0)';
        }, 50 + i * 70);
    });
})();
</script>
}
