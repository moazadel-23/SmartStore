@model SmartStore.ViewModel.loginVM
@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = Localizer["SignIn"];
    var successType = Context.Request.Query["success"].ToString();
    var hasSuccess = !string.IsNullOrEmpty(successType);
}

@if (hasSuccess)
{
    <!-- Success Screen (Screen 4 in screenshot) -->
    <div class="success-screen">
        <div class="success-circle-icon">
            <i class='bx bx-check'></i>
        </div>
        <div class="auth-form-header">
            <h2>Success</h2>
            @if (successType == "register")
            {
                <p>Congratulations! Your account has been successfully created.</p>
            }
            else
            {
                <p>Congratulations! Your password has been successfully reset.</p>
            }
        </div>
        <a asp-area="Identity" asp-controller="Account" asp-action="Login" class="auth-submit-btn" style="text-decoration: none;">
            Sign In
        </a>
    </div>
}
else
{
    <!-- Sign In Navigation Header -->
    <div class="auth-nav-header">
        <a href="/" class="back-btn-circle" title="Back to Home">
            <i class='bx bx-chevron-left'></i>
        </a>
    </div>

    <div class="auth-form-header">
        <h2>@Localizer["SignIn"]</h2>
        <p>Hi Welcome back, you've been missed</p>
    </div>

    <form asp-area="Identity" asp-controller="Account" asp-action="Login" method="post" class="auth-form" id="loginForm">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="auth-alert alert-error validation-summary"></div>

        <!-- Email Field -->
        <div class="auth-field">
            <label asp-for="Email" class="field-label">@Localizer["EmailAddress"]</label>
            <div class="input-wrap">
                <input asp-for="Email" class="auth-input" type="email" placeholder="sarkarraj0766@gmail.com" autocomplete="email" required>
            </div>
            <span asp-validation-for="Email" class="field-error"></span>
        </div>

        <!-- Password Field -->
        <div class="auth-field">
            <label asp-for="Password" class="field-label">@Localizer["Password"]</label>
            <div class="input-wrap">
                <input asp-for="Password" class="auth-input pw-field" id="PasswordInput" type="password" placeholder="••••••••" autocomplete="current-password" required>
                <button type="button" class="pw-toggle" id="togglePasswordBtn" aria-label="Toggle password visibility">
                    <i class='bx bx-hide' id="eyeIcon"></i>
                </button>
            </div>
            <span asp-validation-for="Password" class="field-error"></span>
            
            <div class="forgot-link-container">
                <a asp-area="Identity" asp-controller="Account" asp-action="ForgotPassword" class="forgot-link">
                    @Localizer["ForgotPassword"]
                </a>
            </div>
        </div>

        <!-- Remember Me Checkbox -->
        <div class="auth-check-wrap">
            <input asp-for="RememberMe" type="checkbox">
            <label asp-for="RememberMe">@Localizer["KeepMeSignedIn"]</label>
        </div>

        <!-- Submit Button -->
        <button type="submit" class="auth-submit-btn" id="loginSubmitBtn">
            <span id="submitLabel">@Localizer["SignIn"]</span>
            <div class="btn-spinner" id="loginSpinner"></div>
        </button>

        <!-- Divider -->
        <div class="auth-divider">Or</div>

        <!-- Social Buttons -->
        <div class="social-login-row">
            <!-- Apple -->
            <button type="button" class="social-circle-btn" aria-label="Sign in with Apple">
                <svg viewBox="0 0 24 24" fill="#000000" xmlns="http://www.w3.org/2000/svg">
                    <path d="M18.71 19.5C17.88 20.74 17 21.95 15.66 21.97C14.32 22 13.89 21.18 12.37 21.18C10.84 21.18 10.37 21.95 9.1 22C7.79 22.05 6.8 20.68 5.96 19.47C4.25 17 2.94 12.45 4.7 9.39C5.57 7.87 7.13 6.91 8.82 6.88C10.1 6.86 11.32 7.75 12.11 7.75C12.89 7.75 14.37 6.68 15.92 6.84C16.57 6.87 18.39 7.1 19.56 8.82C19.47 8.88 17.39 10.1 17.41 12.63C17.44 15.65 20.06 16.66 20.1 16.67C20.08 16.74 19.67 18.11 18.71 19.5ZM15.97 4.17C16.63 3.37 17.07 2.28 16.95 1C16 1.04 14.9 1.6 14.24 2.38C13.68 3.04 13.19 4.14 13.34 5.39C14.39 5.47 15.4 4.88 15.97 4.17Z"/>
                </svg>
            </button>
            <!-- Google -->
            <button type="button" class="social-circle-btn" aria-label="Sign in with Google">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                    <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                    <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
                    <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                </svg>
            </button>
            <!-- Facebook -->
            <button type="button" class="social-circle-btn" aria-label="Sign in with Facebook">
                <svg viewBox="0 0 24 24" fill="#1877F2" xmlns="http://www.w3.org/2000/svg">
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
            </button>
        </div>

        <div class="auth-footer-note">
            Don't have an account? <a asp-area="Identity" asp-controller="Account" asp-action="Register">Sign UP</a>
        </div>
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            // Password toggle logic
            const pwInput = document.getElementById("PasswordInput");
            const toggleBtn = document.getElementById("togglePasswordBtn");
            const eyeIcon = document.getElementById("eyeIcon");

            if (toggleBtn && pwInput && eyeIcon) {
                toggleBtn.addEventListener("click", function () {
                    if (pwInput.type === "password") {
                        pwInput.type = "text";
                        eyeIcon.className = "bx bx-show";
                    } else {
                        pwInput.type = "password";
                        eyeIcon.className = "bx bx-hide";
                    }
                });
            }

            // Spinner on submit
            const form = document.getElementById("loginForm");
            if (form) {
                form.addEventListener("submit", function () {
                    if ($(form).valid()) {
                        const btn = document.getElementById("loginSubmitBtn");
                        const spinner = document.getElementById("loginSpinner");
                        const label = document.getElementById("submitLabel");
                        
                        if (btn) btn.disabled = true;
                        if (spinner) spinner.style.display = "inline-block";
                        if (label) label.style.display = "none";
                    }
                });
            }
        })();
    </script>
}
