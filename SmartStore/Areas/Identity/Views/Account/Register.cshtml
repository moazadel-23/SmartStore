@model SmartStore.ViewModel.RegisterVM
@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = Localizer["CreateAccount"];
}

<!-- Create Account Navigation Header -->
<div class="auth-nav-header">
    <a asp-area="Identity" asp-controller="Account" asp-action="Login" class="back-btn-circle" title="Back to Sign In">
        <i class='bx bx-chevron-left'></i>
    </a>
</div>

<div class="auth-form-header">
    <h2>Create Account</h2>
    <p>Fit your information below or register with your social account.</p>
</div>

<form asp-area="Identity" asp-controller="Account" asp-action="Register" method="post" class="auth-form" id="registerForm">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="auth-alert alert-error validation-summary"></div>

    <!-- Name Row (First & Last Name stacked for clean phone mockup height) -->
    <div class="form-row">
        <!-- First Name -->
        <div class="auth-field">
            <label asp-for="FirstName" class="field-label">@Localizer["FirstName"]</label>
            <div class="input-wrap">
                <input asp-for="FirstName" class="auth-input" type="text" placeholder="Koushik" autocomplete="given-name" required>
            </div>
            <span asp-validation-for="FirstName" class="field-error"></span>
        </div>

        <!-- Last Name -->
        <div class="auth-field">
            <label asp-for="LastName" class="field-label">@Localizer["LastName"]</label>
            <div class="input-wrap">
                <input asp-for="LastName" class="auth-input" type="text" placeholder="Sarkar" autocomplete="family-name" required>
            </div>
            <span asp-validation-for="LastName" class="field-error"></span>
        </div>
    </div>

    <!-- Email Field -->
    <div class="auth-field">
        <label asp-for="Email" class="field-label">@Localizer["EmailAddress"]</label>
        <div class="input-wrap">
            <input asp-for="Email" class="auth-input" type="email" placeholder="sarkarraj0766@gmail.com" autocomplete="email" required>
        </div>
        <span asp-validation-for="Email" class="field-error"></span>
    </div>

    <!-- Password Field -->
    <div class="auth-field">
        <label asp-for="Password" class="field-label">@Localizer["Password"]</label>
        <div class="input-wrap">
            <input asp-for="Password" class="auth-input pw-field" id="PasswordInput" type="password" placeholder="••••••••" autocomplete="new-password" required>
            <button type="button" class="pw-toggle" id="togglePasswordBtn" aria-label="Toggle password visibility">
                <i class='bx bx-hide' id="eyeIcon"></i>
            </button>
        </div>
        <span asp-validation-for="Password" class="field-error"></span>
    </div>

    <!-- Confirm Password Field -->
    <div class="auth-field">
        <label asp-for="ConfirmPassword" class="field-label">@Localizer["ConfirmPassword"]</label>
        <div class="input-wrap">
            <input asp-for="ConfirmPassword" class="auth-input pw-field" id="ConfirmPasswordInput" type="password" placeholder="••••••••" autocomplete="new-password" required>
            <button type="button" class="pw-toggle" id="toggleConfirmPasswordBtn" aria-label="Toggle password visibility">
                <i class='bx bx-hide' id="confirmEyeIcon"></i>
            </button>
        </div>
        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
    </div>

    <!-- Terms & Conditions Checkbox -->
    <div class="auth-check-wrap">
        <input class="form-check-input" type="checkbox" id="terms" required>
        <label for="terms">
            Agree with <a href="#">Terms & Condition</a>
        </label>
    </div>

    <!-- Submit Button -->
    <button type="submit" class="auth-submit-btn" id="registerSubmitBtn">
        <span id="submitLabel">Sign Up</span>
        <div class="btn-spinner" id="registerSpinner"></div>
    </button>

    <!-- Divider -->
    <div class="auth-divider">Or</div>

    <!-- Social Buttons -->
    <div class="social-login-row">
        <!-- Apple -->
        <button type="button" class="social-circle-btn" aria-label="Sign up with Apple">
            <svg viewBox="0 0 24 24" fill="#000000" xmlns="http://www.w3.org/2000/svg">
                <path d="M18.71 19.5C17.88 20.74 17 21.95 15.66 21.97C14.32 22 13.89 21.18 12.37 21.18C10.84 21.18 10.37 21.95 9.1 22C7.79 22.05 6.8 20.68 5.96 19.47C4.25 17 2.94 12.45 4.7 9.39C5.57 7.87 7.13 6.91 8.82 6.88C10.1 6.86 11.32 7.75 12.11 7.75C12.89 7.75 14.37 6.68 15.92 6.84C16.57 6.87 18.39 7.1 19.56 8.82C19.47 8.88 17.39 10.1 17.41 12.63C17.44 15.65 20.06 16.66 20.1 16.67C20.08 16.74 19.67 18.11 18.71 19.5ZM15.97 4.17C16.63 3.37 17.07 2.28 16.95 1C16 1.04 14.9 1.6 14.24 2.38C13.68 3.04 13.19 4.14 13.34 5.39C14.39 5.47 15.4 4.88 15.97 4.17Z"/>
            </svg>
        </button>
        <!-- Google -->
        <button type="button" class="social-circle-btn" aria-label="Sign up with Google">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
        </button>
        <!-- Facebook -->
        <button type="button" class="social-circle-btn" aria-label="Sign up with Facebook">
            <svg viewBox="0 0 24 24" fill="#1877F2" xmlns="http://www.w3.org/2000/svg">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
        </button>
    </div>

    <div class="auth-footer-note">
        Already have an account? <a asp-area="Identity" asp-controller="Account" asp-action="Login">Sign In</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            // Password toggle helper
            function setupToggle(inputId, toggleId, iconId) {
                const input = document.getElementById(inputId);
                const toggle = document.getElementById(toggleId);
                const icon = document.getElementById(iconId);

                if (toggle && input && icon) {
                    toggle.addEventListener("click", function () {
                        if (input.type === "password") {
                            input.type = "text";
                            icon.className = "bx bx-show";
                        } else {
                            input.type = "password";
                            icon.className = "bx bx-hide";
                        }
                    });
                }
            }

            setupToggle("PasswordInput", "togglePasswordBtn", "eyeIcon");
            setupToggle("ConfirmPasswordInput", "toggleConfirmPasswordBtn", "confirmEyeIcon");

            // Spinner on submit
            const form = document.getElementById("registerForm");
            if (form) {
                form.addEventListener("submit", function () {
                    if ($(form).valid()) {
                        const btn = document.getElementById("registerSubmitBtn");
                        const spinner = document.getElementById("registerSpinner");
                        const label = document.getElementById("submitLabel");
                        
                        if (btn) btn.disabled = true;
                        if (spinner) spinner.style.display = "inline-block";
                        if (label) label.style.display = "none";
                    }
                });
            }
        })();
    </script>
}
