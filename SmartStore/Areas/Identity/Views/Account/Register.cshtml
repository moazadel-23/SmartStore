@model SmartStore.ViewModel.RegisterVM
@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Create Account";
}

<div class="auth-form-header">
    <h2>Register</h2>
</div>

<form asp-area="Identity" asp-controller="Account" asp-action="Register" method="post" class="auth-form">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="auth-alert alert-error validation-summary"></div>

    <div class="form-row">
        <div class="auth-field">
            <div class="input-wrap">
                <input asp-for="FirstName" class="auth-input" type="text" placeholder=" " autocomplete="given-name">
                <label asp-for="FirstName" class="auth-label">First Name</label>
            </div>
            <span asp-validation-for="FirstName" class="field-error"></span>
        </div>

        <div class="auth-field">
            <div class="input-wrap">
                <input asp-for="LastName" class="auth-input" type="text" placeholder=" " autocomplete="family-name">
                <label asp-for="LastName" class="auth-label">Last Name</label>
            </div>
            <span asp-validation-for="LastName" class="field-error"></span>
        </div>
    </div>

    <div class="auth-field">
        <div class="input-wrap">
            <input asp-for="Email" class="auth-input" type="email" placeholder=" " autocomplete="email">
            <label asp-for="Email" class="auth-label">Email Address</label>
        </div>
        <span asp-validation-for="Email" class="field-error"></span>
    </div>

    <div class="auth-field">
        <div class="input-wrap">
            <input asp-for="Password" class="auth-input" type="password" placeholder=" " autocomplete="new-password">
            <label asp-for="Password" class="auth-label">Password</label>
        </div>
        <span asp-validation-for="Password" class="field-error"></span>
    </div>

    <div class="auth-field">
        <div class="input-wrap">
            <input asp-for="ConfirmPassword" class="auth-input" type="password" placeholder=" " autocomplete="new-password">
            <label asp-for="ConfirmPassword" class="auth-label">Confirm password</label>
        </div>
        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
    </div>

    <div class="auth-check-wrap">
        <input class="form-check-input" type="checkbox" id="terms" required>
        <label for="terms">
            I agree to the <a href="#">Terms</a> and <a href="#">Privacy Policy</a>.
        </label>
    </div>

    <button type="submit" class="auth-submit-btn">
        Create account
    </button>

    <div class="auth-divider">OR</div>

    <button type="button" class="auth-google-btn">
        <svg class="google-icon" viewBox="0 0 24 24" width="18" height="18" xmlns="http://www.w3.org/2000/svg">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
        </svg>
        Register with Google
    </button>
</form>

<div class="auth-footer-note">
    Already Registered? <a asp-area="Identity" asp-controller="Account" asp-action="Login">Log in</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
