@model IEnumerable<SmartStore.Models.Cart>
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["CartTitle"];
    bool isArabic = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar", StringComparison.OrdinalIgnoreCase);
}

<link rel="stylesheet" href="~/css/store.css" asp-append-version="true" />

@{
    ViewData["HideWishlist"] = false;
    ViewData["HideSubNav"] = true;
}
@await Html.PartialAsync("_BTechHeader")

<style>
    /* Styling elements for smooth interaction */
    .cart-item-row {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .cart-item-row.removing {
        opacity: 0;
        transform: translateY(20px);
    }
    .free-shipping-progress {
        transition: width 0.5s ease-in-out;
    }
    /* Hide input number arrows */
    input[type=number]::-webkit-inner-spin-button, 
    input[type=number]::-webkit-outer-spin-button { 
        -webkit-appearance: none; 
        margin: 0; 
    }
    input[type=number] {
        -moz-appearance: textfield;
    }
</style>

<div class="bg-gray-50/50 min-h-screen pb-16 font-cairo @(isArabic ? "text-right" : "text-left")" dir="@(isArabic ? "rtl" : "ltr")">
    
    <script>
        window.translations = {
            currency: '@Localizer["EGP"]',
            free: '@Localizer["Free"]',
            addProductsToStart: '@Localizer["AddProductsToStart"]',
            youGetFreeShipping: '@Localizer["YouGetFreeShipping"]',
            addMoreForFreeShippingPrefix: '@Localizer["AddMoreForFreeShippingPrefix"]',
            addMoreForFreeShippingSuffix: '@Localizer["AddMoreForFreeShippingSuffix"]',
            couponDiscount: '@Localizer["CouponDiscount"]',
            itemsCountLabel: '@Localizer["ItemsCountLabel"]',
            itemCountLabel: '@Localizer["ItemCountLabel"]',
            loadingCart: '@Localizer["LoadingCart"]',
            subtotal: '@Localizer["Subtotal"]',
            moveToWishlist: '@(isArabic ? "نقل للمفضلة" : "Move to Wishlist")',
            saveForLater: '@(isArabic ? "حفظ لوقت لاحق" : "Save for Later")',
            remove: '@(isArabic ? "إزالة" : "Remove")',
            sku: 'SKU',
            inStock: '@(isArabic ? "متوفر" : "In Stock")'
        };
    </script>

    <div class="max-w-[1250px] mx-auto px-4 pt-8">
        <!-- Header Section matching the mock image -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-8 pb-6 border-b border-gray-100">
            <div>
                <a href="/Customer/Home/Store" class="flex items-center gap-2 text-gray-500 hover:text-[#002d72] transition-colors decoration-none mb-2 text-xs font-bold">
                    <i class="fas @(isArabic ? "fa-arrow-right" : "fa-arrow-left")"></i>
                    <span>@(isArabic ? "العودة للمتجر" : "Back to Store")</span>
                </a>
                <h1 class="text-2xl sm:text-3xl font-black text-gray-900 m-0">@Localizer["CartTitle"]</h1>
                <!-- Breadcrumbs -->
                <div class="flex items-center gap-2 text-xs text-gray-400 mt-2">
                    <a href="/" class="hover:text-[#002d72] transition-colors decoration-none">@Localizer["Home"]</a>
                    <i class="fas @(isArabic ? "fa-chevron-left" : "fa-chevron-right") text-[8px] text-gray-300"></i>
                    <span class="font-semibold text-gray-500">@Localizer["CartTitle"]</span>
                </div>
            </div>
            <div class="mt-4 sm:mt-0">
                <span id="cart-badge-count" class="text-xs font-extrabold text-[#002d72] bg-[#002d72]/5 px-4 py-2.5 rounded-xl border border-blue-100/30">0 @Localizer["ItemsCountLabel"]</span>
            </div>
        </div>

        <!-- Main Grid Layout -->
        <div id="cart-main-layout" class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start hidden">
            
            <!-- Right Column: Cart Items -->
            <div class="lg:col-span-2 space-y-4">
                
                <!-- Free Shipping Progress -->
                <div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-100/80 flex flex-col gap-2">
                    <span id="shipping-progress-text" class="text-xs font-bold text-gray-600"></span>
                    <div class="w-full bg-gray-100 h-2 rounded-full overflow-hidden">
                        <div id="shipping-progress-bar" class="bg-[#002d72] h-full free-shipping-progress" style="width: 0%"></div>
                    </div>
                </div>

                <!-- Main Items Sheet (White Box with items separated by dividers) -->
                <div class="bg-white rounded-2xl border border-gray-100/80 shadow-sm p-6">
                    <!-- Select All row -->
                    <div class="flex items-center justify-between pb-4 border-b border-gray-100 mb-2">
                        <div class="flex items-center gap-3">
                            <input type="checkbox" id="select-all-cart" checked class="w-4 h-4 rounded text-[#002d72] focus:ring-[#002d72] border-gray-300 cursor-pointer">
                            <label for="select-all-cart" class="text-xs font-bold text-gray-500 select-none cursor-pointer">@(isArabic ? "تحديد الكل" : "Select all")</label>
                        </div>
                    </div>

                    <!-- Items List Container -->
                    <div id="cart-items-list" class="divide-y divide-gray-100">
                        @if (User.Identity!.IsAuthenticated && Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                var prod = item.Product!;
                                <div class="cart-item-row py-5 flex items-start gap-4" data-product-id="@item.ProductId">
                                    <!-- Checkbox on the left -->
                                    <div class="pt-2.5 flex-shrink-0">
                                        <input type="checkbox" checked class="item-checkbox w-4 h-4 rounded text-[#002d72] focus:ring-[#002d72] border-gray-300 cursor-pointer" data-product-id="@item.ProductId" onchange="onItemCheckboxChange()">
                                    </div>
                                    
                                    <!-- Image -->
                                    <div class="w-20 h-20 bg-white rounded-xl border border-gray-100 p-1 flex-shrink-0 flex items-center justify-center">
                                        <img src="~/img/@prod.MainImg" alt="@prod.Name" class="w-full h-full object-contain" asp-append-version="true" />
                                    </div>
                                    
                                    <!-- Middle content: Info & Actions -->
                                    <div class="flex-grow flex flex-col sm:flex-row sm:justify-between gap-4">
                                        <div class="space-y-1">
                                            <span class="text-[9px] text-gray-400 font-extrabold uppercase tracking-wider">@prod.Brand?.Name</span>
                                            <h3 class="text-sm font-bold text-gray-900 line-clamp-2 leading-snug">@prod.Name</h3>
                                            
                                            <!-- Specs/Details line -->
                                            <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-gray-400 font-medium pt-0.5">
                                                <span>@Localizer["SKU"]: @(prod.SKU ?? "N/A")</span>
                                                <span class="text-gray-200">•</span>
                                                <span class="text-green-600 font-semibold flex items-center gap-1"><i class="fas fa-check-circle text-[10px]"></i> @(isArabic ? "متوفر" : "In Stock")</span>
                                                <span class="text-gray-200">•</span>
                                                <span class="text-gray-500">@(isArabic ? "توصيل سريع" : "Fast Delivery")</span>
                                            </div>
                                            
                                            <!-- Actions row -->
                                            <div class="flex items-center gap-2 pt-3 flex-wrap">
                                                <button type="button" class="text-[11px] font-bold text-gray-500 hover:text-[#002d72] bg-gray-50 hover:bg-gray-100 border border-gray-200/60 px-2.5 py-1 rounded-lg transition-colors cursor-pointer flex items-center gap-1" onclick="moveToWishlist(@item.ProductId)">
                                                    <i class="far fa-heart"></i>
                                                    <span>@(isArabic ? "نقل للمفضلة" : "Move to Wishlist")</span>
                                                </button>
                                                <button type="button" class="text-[11px] font-bold text-gray-500 hover:text-gray-800 bg-gray-50 hover:bg-gray-100 border border-gray-200/60 px-2.5 py-1 rounded-lg transition-colors cursor-pointer flex items-center gap-1" onclick="saveForLater(@item.ProductId)">
                                                    <i class="far fa-bookmark"></i>
                                                    <span>@(isArabic ? "حفظ لوقت لاحق" : "Save for Later")</span>
                                                </button>
                                                <button type="button" class="text-[11px] font-bold text-red-500 hover:text-red-700 bg-red-50/50 hover:bg-red-50 border border-red-100/50 px-2.5 py-1 rounded-lg transition-colors cursor-pointer flex items-center gap-1" onclick="deleteItem(@item.ProductId)">
                                                    <i class="far fa-trash-alt"></i>
                                                    <span>@Localizer["Remove"]</span>
                                                </button>
                                            </div>
                                        </div>
                                        
                                        <!-- Right content: Price & Qty -->
                                        <div class="flex flex-row sm:flex-col items-center sm:items-end justify-between sm:justify-start gap-4 sm:min-w-[130px] pt-1">
                                            <!-- Price info -->
                                            <div class="text-right flex flex-col items-end">
                                                @{
                                                    decimal originalPrice = prod.Price;
                                                    if (ViewBag.OriginalProductPrices != null && ((Dictionary<int, decimal>)ViewBag.OriginalProductPrices).ContainsKey(prod.Id))
                                                    {
                                                        originalPrice = ((Dictionary<int, decimal>)ViewBag.OriginalProductPrices)[prod.Id];
                                                    }
                                                }
                                                @if (prod.Discount > 0 || originalPrice > prod.Price)
                                                {
                                                    <span class="text-xs text-gray-400 line-through">@((originalPrice + (prod.Discount > 0 ? prod.Discount : 0)).ToString("F2")) @Localizer["EGP"]</span>
                                                }
                                                <span class="text-base font-black text-gray-900 unit-price" data-original-price="@originalPrice">@prod.Price.ToString("F2") @Localizer["EGP"]</span>
                                                <span class="item-subtotal hidden" data-price="@prod.Price">@((prod.Price * item.Count).ToString("F2"))</span>
                                                <div class="coupon-badge text-[10px] text-green-600 font-bold mt-1 hidden"></div>
                                            </div>
                                            
                                            <!-- Quantity Control -->
                                            <div class="flex items-center border border-gray-200 rounded-lg overflow-hidden bg-gray-50 h-7.5">
                                                <button type="button" class="px-2 h-full hover:bg-gray-100 text-gray-500 font-bold border-0 bg-transparent transition-colors cursor-pointer" onclick="adjustQty(@item.ProductId, -1)">-</button>
                                                <input type="number" class="w-8 text-center font-bold text-xs bg-transparent border-0 focus:outline-none" value="@item.Count" min="1" max="99" onchange="onQtyInputChange(@item.ProductId, this)" />
                                                <button type="button" class="px-2 h-full hover:bg-gray-100 text-gray-500 font-bold border-0 bg-transparent transition-colors cursor-pointer" onclick="adjustQty(@item.ProductId, 1)">+</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>

                <!-- Clear Cart and Continue shopping buttons -->
                <div class="flex justify-between items-center bg-white p-4 rounded-2xl shadow-sm border border-gray-100/80">
                    <a href="/Customer/Home/Store" class="text-xs font-bold text-gray-600 hover:text-[#002d72] transition-colors flex items-center gap-1.5 border-0 bg-transparent decoration-none">
                        <i class="fas @(isArabic ? "fa-arrow-right" : "fa-arrow-left") text-[10px]"></i>
                        <span>@Localizer["ContinueShopping"]</span>
                    </a>
                    <button type="button" class="text-xs font-bold text-gray-400 hover:text-red-500 transition-colors border-0 bg-transparent cursor-pointer flex items-center gap-1.5" onclick="clearCart()">
                        <i class="fas fa-trash-alt text-[10px]"></i>
                        <span>@Localizer["ClearCart"]</span>
                    </button>
                </div>
            </div>

            <!-- Left Column: Order Summary (Sidebar) -->
            <div class="space-y-4 sticky top-24">
                <!-- Subtotal Box -->
                <div class="bg-white p-6 rounded-2xl border border-gray-100/80 shadow-sm">
                    <div class="text-xs font-bold text-gray-400 mb-1">@(isArabic ? "إجمالي السلة:" : "Subtotal:")</div>
                    <div class="text-3xl font-black text-gray-900 mb-5 flex flex-col gap-0.5">
                        <span id="summary-total">0.00 @Localizer["EGP"]</span>
                        <span id="summary-subtotal-crossed" class="text-xs text-gray-400 line-through font-medium hidden">0.00 @Localizer["EGP"]</span>
                    </div>
                    
                    <a href="/Checkout" class="w-full bg-[#002d72] hover:bg-[#001f4f] text-white py-3.5 rounded-xl font-bold text-sm flex items-center justify-center gap-2 transition-all hover:-translate-y-0.5 active:translate-y-0 shadow-md hover:shadow-lg border-0 decoration-none">
                        <span>@(isArabic ? "الشراء الآن" : "Checkout Now")</span>
                        <i class="fas @(isArabic ? "fa-chevron-left" : "fa-chevron-right") text-xs"></i>
                    </a>

                    <!-- Detail totals list (Compact) -->
                    <div class="mt-5 pt-4 border-t border-gray-50 space-y-2.5 text-xs">
                           <div class="flex justify-between text-gray-500">
                               <span>@Localizer["Subtotal"]</span>
                               <span id="summary-subtotal" class="font-bold text-gray-800">0.00 @Localizer["EGP"]</span>
                           </div>
                           <div class="flex justify-between text-gray-500">
                               <span>@Localizer["ShippingCost"]</span>
                               <span id="summary-shipping" class="font-bold text-gray-800">0.00 @Localizer["EGP"]</span>
                           </div>
                           <div class="flex justify-between text-green-600 font-bold">
                               <span>@Localizer["Discount"]</span>
                               <span id="summary-discount">0.00 - @Localizer["EGP"]</span>
                           </div>
                    </div>
                </div>

                <!-- Promotions Box -->
                <div class="bg-white p-5 rounded-2xl border border-gray-100/80 shadow-sm">
                    <h3 class="text-xs font-bold text-gray-900 mb-3">@(isArabic ? "العروض والخصومات" : "Promotions")</h3>
                    
                    <!-- Applied Coupon Alert -->
                    <div id="coupon-applied-alert" class="hidden mb-3 p-2.5 bg-green-50 border border-green-100 text-green-700 text-xs font-bold rounded-xl flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <i class="fas fa-check-circle"></i>
                            <span>@(isArabic ? "تم تطبيق الكوبون" : "Coupon code applied") '<span id="applied-code-text"></span>'</span>
                        </div>
                        <button type="button" class="text-green-700 hover:text-green-900 bg-transparent border-0 cursor-pointer text-xs" onclick="removeCoupon()">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                    
                    <!-- Input Box -->
                    <div class="relative flex items-center">
                        <input type="text" id="coupon-code" placeholder="@Localizer["PromoCodePlaceholder"]" class="w-full px-4 py-2.5 text-xs border border-gray-200 rounded-xl focus:border-[#002d72] focus:outline-none bg-white font-semibold" />
                        <button type="button" class="absolute end-1.5 top-1.5 bottom-1.5 bg-gray-900 hover:bg-gray-800 text-white px-4 rounded-lg text-xs font-bold transition-colors border-0 cursor-pointer flex items-center justify-center" onclick="applyCoupon()">@Localizer["Apply"]</button>
                    </div>
                    <div id="coupon-message" class="text-[11px] mt-1.5 text-red-500 hidden"></div>
                </div>

                <!-- Payment Installment info & Trust box -->
                <div class="bg-white p-4 rounded-2xl border border-gray-100 shadow-sm text-xs text-gray-500 space-y-3">
                    <div class="flex items-start gap-2.5">
                        <div class="w-6 h-6 rounded-md bg-blue-50 flex items-center justify-center text-[#002d72] flex-shrink-0">
                            <i class="fas fa-percent text-[10px]"></i>
                        </div>
                        <div>
                            <p class="font-bold text-gray-800 m-0">@(isArabic ? "قسط مشترياتك مع valU" : "Install with valU")</p>
                            <p class="text-[11px] text-gray-400 mt-0.5 m-0">@(isArabic ? "اشترِ الآن وادفع لاحقاً لطلبات 500 ج.م وأكثر." : "Buy now, pay later for orders of 500 EGP and over.")</p>
                        </div>
                    </div>
                    <div class="h-px bg-gray-50"></div>
                    <div class="flex items-center justify-between text-[11px] text-gray-400">
                        <div class="flex items-center gap-1.5">
                            <i class="fas fa-shield-alt text-[#002d72] text-[10px]"></i>
                            <span>@Localizer["SecureCheckoutInfo"]</span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <i class="fas fa-undo text-[#002d72] text-[10px]"></i>
                            <span>@Localizer["ReturnPolicyInfo"]</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- Loading View -->
        <div id="cart-loading-view" class="text-center py-20">
            <div class="inline-block animate-spin rounded-full h-12 w-12 border-4 border-[#002d72] border-t-transparent mb-4"></div>
            <p class="text-gray-500 font-bold">@Localizer["LoadingCart"]</p>
        </div>

        <!-- Empty Cart View -->
        <div id="cart-empty-view" class="text-center py-20 bg-white rounded-3xl border border-gray-100 shadow-sm max-w-2xl mx-auto px-6 hidden">
            <div class="w-24 h-24 bg-blue-50/50 text-[#002d72] rounded-full flex items-center justify-center mx-auto mb-6">
                <i class="fas fa-shopping-bag text-4xl"></i>
            </div>
            <h2 class="text-xl sm:text-2xl font-black text-gray-900 mb-2">@Localizer["EmptyCartTitle"]</h2>
            <p class="text-gray-500 text-sm max-w-sm mx-auto mb-8">@Localizer["EmptyCartSubtitle"]</p>
            <a href="/Customer/Home/Store" class="bg-[#002d72] hover:bg-[#001f4f] text-white px-8 py-3 rounded-xl font-bold text-sm transition-colors border-0 inline-flex items-center gap-2 decoration-none">
                <span>@Localizer["BrowseProductsNow"]</span>
                <i class="fas @(isArabic ? "fa-arrow-left" : "fa-arrow-right")"></i>
            </a>
        </div>

    </div>
</div>

<!-- Floating Toast Notification -->
<div id="cartToast" class="fixed bottom-5 @(isArabic ? "left-5" : "right-5") bg-gray-900 text-white px-5 py-3.5 rounded-2xl shadow-xl flex items-center gap-3 transform translate-y-10 opacity-0 pointer-events-none transition-all duration-300 z-50 text-xs font-bold border border-gray-800">
    <div class="w-5 h-5 rounded-full bg-[#002d72]/20 flex items-center justify-center text-blue-400">
        <i class="fas fa-info-circle text-[10px]"></i>
    </div>
    <span id="cartToastText"></span>
</div>

<footer class="store-footer">
    <div class="container">
        <div class="row">
            <div class="col-md-3 col-6">
                <h5>About Us</h5>
                <p style="font-size:13px;line-height:1.7;">Your destination for premium electronics at unbeatable prices. Fast shipping, easy returns.</p>
            </div>
            <div class="col-md-3 col-6">
                <h5>Categories</h5>
                <a href="#">Laptops</a>
                <a href="#">Smartphones</a>
                <a href="#">Cameras</a>
                <a href="#">Accessories</a>
            </div>
            <div class="col-md-3 col-6">
                <h5>Customer Service</h5>
                <a href="#">Contact Us</a>
                <a href="#">Shipping & Returns</a>
                <a href="#">FAQ</a>
                <a href="#">Warranty</a>
            </div>
            <div class="col-md-3 col-6">
                <h5>My Account</h5>
                <a href="#">My Orders</a>
                <a href="/Customer/Wishlist/Index">My Wishlist</a>
                <a href="/Cart">My Cart</a>
                <a href="#">Account Settings</a>
            </div>
        </div>
        <div class="footer-bottom">
            <span>&copy; @DateTime.Now.Year SmartStore. All rights reserved.</span>
            <span>
                <i class="fa fa-cc-visa" style="font-size:24px;margin-left:8px;"></i>
                <i class="fa fa-cc-mastercard" style="font-size:24px;margin-left:8px;"></i>
                <i class="fa fa-cc-paypal" style="font-size:24px;margin-left:8px;"></i>
            </span>
        </div>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script>
    window.isAuthenticated = @(User.Identity?.IsAuthenticated.ToString().ToLower() ?? "false");
</script>
<script src="~/js/store.js" asp-append-version="true"></script>

<script>
    // State management for Cart page
    const IsAuthenticated = @(User.Identity?.IsAuthenticated.ToString().ToLower() ?? "false");
    const allProducts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.AllProducts));
    let cartItemsList = []; // Used for guest storage details

    $(document).ready(function () {
        initializeCart();
    });

    async function initializeCart() {
        if (IsAuthenticated) {
            // For authenticated user, load items from server-side markup
            readServerItems();
            updateSummaryUI();
            toggleViews(false);
        } else {
            // For guest, fetch from sessionStorage
            const guestCart = JSON.parse(sessionStorage.getItem('store_cart') || '[]');
            if (guestCart.length === 0) {
                toggleViews(true);
            } else {
                // Map the guest cart items using the embedded allProducts list
                cartItemsList = [];
                guestCart.forEach(item => {
                    const prod = allProducts.find(p => p.Id === item.id);
                    if (prod) {
                        cartItemsList.push({
                            productId: prod.Id,
                            name: prod.Name,
                            price: prod.Price,
                            discount: prod.Discount,
                            mainImg: prod.MainImg,
                            count: item.qty,
                            description: prod.description
                        });
                    }
                });
                
                if (cartItemsList.length === 0) {
                    toggleViews(true);
                } else {
                    renderGuestItems();
                    updateSummaryUI();
                    toggleViews(false);
                }
            }
        }

        // Auto-apply coupon from URL parameter or sessionStorage
        const urlParams = new URLSearchParams(window.location.search);
        let couponToApply = urlParams.get('code') || sessionStorage.getItem('applied_coupon');
        if (couponToApply && cartItemsList.length > 0) {
            appliedCouponCode = couponToApply;
            await applyCoupon(true); // Apply silently
        }
    }

    function toggleViews(isEmpty) {
        $('#cart-loading-view').addClass('hidden');
        if (isEmpty) {
            $('#cart-main-layout').addClass('hidden');
            $('#cart-empty-view').removeClass('hidden');
        } else {
            $('#cart-empty-view').addClass('hidden');
            $('#cart-main-layout').removeClass('hidden');
        }
    }

    function readServerItems() {
        cartItemsList = [];
        $('#cart-items-list .cart-item-row').each(function () {
            const row = $(this);
            const productId = parseInt(row.data('product-id'));
            const price = parseFloat(row.find('.item-subtotal').data('price'));
            const count = parseInt(row.find('input[type=number]').val());
            cartItemsList.push({
                productId: productId,
                price: price,
                count: count
            });
        });
    }

    function renderGuestItems() {
        const listContainer = $('#cart-items-list');
        listContainer.empty();

        const currencyStr = (window.translations && window.translations.currency) || 'ج.م';

        cartItemsList.forEach(item => {
            const discountBadge = item.discount > 0 
                ? `<span class="text-xs text-gray-400 line-through">${(item.price + item.discount).toFixed(2)} ${currencyStr}</span>`
                : '';

            const itemHtml = `
                <div class="cart-item-row py-5 flex items-start gap-4" data-product-id="${item.productId}">
                    <!-- Checkbox on the left -->
                    <div class="pt-2.5 flex-shrink-0">
                        <input type="checkbox" checked class="item-checkbox w-4 h-4 rounded text-[#002d72] focus:ring-[#002d72] border-gray-300 cursor-pointer" data-product-id="${item.productId}" onchange="onItemCheckboxChange()">
                    </div>
                    
                    <!-- Image -->
                    <div class="w-20 h-20 bg-white rounded-xl border border-gray-100 p-1 flex-shrink-0 flex items-center justify-center">
                        <img src="/img/${item.mainImg}" alt="${item.name}" class="w-full h-full object-contain" />
                    </div>
                    
                    <!-- Middle content: Info & Actions -->
                    <div class="flex-grow flex flex-col sm:flex-row sm:justify-between gap-4">
                        <div class="space-y-1">
                            <h3 class="text-sm font-bold text-gray-900 line-clamp-2 leading-snug">${item.name}</h3>
                            
                            <!-- Specs/Details line -->
                            <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-gray-400 font-medium pt-0.5">
                                <span>${translations.sku || 'SKU'}: PR${item.productId}</span>
                                <span class="text-gray-200">•</span>
                                <span class="text-green-600 font-semibold flex items-center gap-1"><i class="fas fa-check-circle text-[10px]"></i> ${translations.inStock || 'In Stock'}</span>
                                <span class="text-gray-200">•</span>
                                <span class="text-gray-500">${translations.fastDelivery || 'Fast Delivery'}</span>
                            </div>
                            
                            <!-- Actions row -->
                            <div class="flex items-center gap-2 pt-3 flex-wrap">
                                <button type="button" class="text-[11px] font-bold text-gray-500 hover:text-[#002d72] bg-gray-50 hover:bg-gray-100 border border-gray-200/60 px-2.5 py-1 rounded-lg transition-colors cursor-pointer flex items-center gap-1" onclick="moveToWishlist(${item.productId})">
                                    <i class="far fa-heart"></i>
                                    <span>${translations.moveToWishlist || 'Move to Wishlist'}</span>
                                </button>
                                <button type="button" class="text-[11px] font-bold text-gray-500 hover:text-gray-800 bg-gray-50 hover:bg-gray-100 border border-gray-200/60 px-2.5 py-1 rounded-lg transition-colors cursor-pointer flex items-center gap-1" onclick="saveForLater(${item.productId})">
                                    <i class="far fa-bookmark"></i>
                                    <span>${translations.saveForLater || 'Save for Later'}</span>
                                </button>
                                <button type="button" class="text-[11px] font-bold text-red-500 hover:text-red-700 bg-red-50/50 hover:bg-red-50 border border-red-100/50 px-2.5 py-1 rounded-lg transition-colors cursor-pointer flex items-center gap-1" onclick="deleteItem(${item.productId})">
                                    <i class="far fa-trash-alt"></i>
                                    <span>${translations.remove || 'Remove'}</span>
                                </button>
                            </div>
                        </div>
                        
                        <!-- Right content: Price & Qty -->
                        <div class="flex flex-row sm:flex-col items-center sm:items-end justify-between sm:justify-start gap-4 sm:min-w-[130px] pt-1">
                            <!-- Price info -->
                            <div class="text-right flex flex-col items-end">
                                ${discountBadge}
                                <span class="text-base font-black text-gray-900 unit-price" data-original-price="${item.price}">${item.price.toFixed(2)} ${currencyStr}</span>
                                <span class="item-subtotal hidden" data-price="${item.price}">${(item.price * item.count).toFixed(2)}</span>
                                <div class="coupon-badge text-xs text-green-600 font-bold mt-1 hidden"></div>
                            </div>
                            
                            <!-- Quantity Control -->
                            <div class="flex items-center border border-gray-200 rounded-lg overflow-hidden bg-gray-50 h-7.5">
                                <button type="button" class="px-2 h-full hover:bg-gray-100 text-gray-500 font-bold border-0 bg-transparent transition-colors cursor-pointer" onclick="adjustQty(${item.productId}, -1)">-</button>
                                <input type="number" class="w-8 text-center font-bold text-xs bg-transparent border-0 focus:outline-none" value="${item.count}" min="1" max="99" onchange="onQtyInputChange(${item.productId}, this)" />
                                <button type="button" class="px-2 h-full hover:bg-gray-100 text-gray-500 font-bold border-0 bg-transparent transition-colors cursor-pointer" onclick="adjustQty(${item.productId}, 1)">+</button>
                            </div>
                        </div>
                    </div>
                </div>
            `;
            listContainer.append(itemHtml);
        });
    }

    // Select all checkbox handler
    $('#select-all-cart').on('change', function () {
        const isChecked = $(this).is(':checked');
        $('.item-checkbox').prop('checked', isChecked);
        updateSummaryUI();
        if (appliedCouponCode) {
            applyCoupon(true);
        }
    });

    window.onItemCheckboxChange = function() {
        const totalItemsCount = $('.item-checkbox').length;
        const checkedItemsCount = $('.item-checkbox:checked').length;
        $('#select-all-cart').prop('checked', totalItemsCount === checkedItemsCount);
        updateSummaryUI();
        if (appliedCouponCode) {
            applyCoupon(true);
        }
    };

    // Toast Notification Helper
    function showToast(message) {
        const toast = document.getElementById('cartToast');
        const text  = document.getElementById('cartToastText');
        if (!toast || !text) return;

        text.textContent = message;
        toast.classList.remove('translate-y-10', 'opacity-0', 'pointer-events-none');
        toast.classList.add('translate-y-0', 'opacity-100');

        setTimeout(() => {
            toast.classList.remove('translate-y-0', 'opacity-100');
            toast.classList.add('translate-y-10', 'opacity-0', 'pointer-events-none');
        }, 3000);
    }

    window.moveToWishlist = async function (productId) {
        if (!IsAuthenticated) {
            window.location.href = `/Identity/Account/Login?returnUrl=${encodeURIComponent(window.location.pathname + window.location.search)}`;
            return;
        }

        try {
            const response = await fetch(`/Customer/Wishlist/AddToFavorites?productId=${productId}`, { method: 'POST' });
            const result = await response.json();
            if (result.success) {
                // Remove from cart
                deleteItem(productId);
                showToast(translations.moveToWishlistSuccess || (IsArabic() ? 'تم نقل المنتج للمفضلة بنجاح' : 'Product moved to wishlist successfully'));
            } else {
                showToast(result.message || 'Error moving item to wishlist');
            }
        } catch (error) {
            console.error('Error moving to wishlist:', error);
            showToast('Error moving item to wishlist');
        }
    };

    window.saveForLater = function (productId) {
        showToast(IsArabic() ? 'تم حفظ المنتج لوقت لاحق' : 'Product saved for later');
    };

    function IsArabic() {
        return window.translations && window.translations.moveToWishlist.includes('نقل');
    }

    // Function to calculate and update totals
    let appliedCouponCode = "";
    let appliedDiscount = 0;
    let appliedDiscountItems = [];

    function updateSummaryUI() {
        let selectedSubtotal = 0;
        let selectedTotalQty = 0;
        let originalSubtotal = 0;

        cartItemsList.forEach(item => {
            const checkbox = $(`.item-checkbox[data-product-id=${item.productId}]`);
            if (checkbox.length === 0 || checkbox.is(':checked')) {
                selectedSubtotal += item.price * item.count;
                selectedTotalQty += item.count;
                
                // Get original price for this product
                const card = $(`.cart-item-row[data-product-id=${item.productId}]`);
                const unitPriceSpan = card.find('.unit-price');
                const origPrice = parseFloat(unitPriceSpan.data('original-price')) || item.price;
                originalSubtotal += origPrice * item.count;
            }
        });

        const currencyStr = (window.translations && window.translations.currency) || 'ج.م';

        // Free shipping progress calculation (Free if > 300 EGP)
        const freeShippingThreshold = 300;
        let shipping = 0;
        
        if (selectedSubtotal === 0) {
            shipping = 0;
            $('#shipping-progress-text').text((window.translations && window.translations.addProductsToStart) || 'أضف منتجات للبدء');
            $('#shipping-progress-bar').css('width', '0%');
        } else if (selectedSubtotal >= freeShippingThreshold) {
            shipping = 0;
            const msg = (window.translations && window.translations.youGetFreeShipping) || 'تهانينا! لقد حصلت على شحن مجاني';
            $('#shipping-progress-text').html(`<i class="fas fa-check text-green-500 ml-1"></i> ${msg}`);
            $('#shipping-progress-bar').css('width', '100%');
        } else {
            shipping = 50;
            const remaining = freeShippingThreshold - selectedSubtotal;
            const pct = (selectedSubtotal / freeShippingThreshold) * 100;
            const prefix = (window.translations && window.translations.addMoreForFreeShippingPrefix) || 'أضف';
            const suffix = (window.translations && window.translations.addMoreForFreeShippingSuffix) || 'إضافية للحصول على شحن مجاني!';
            $('#shipping-progress-text').html(`${prefix} <span class="text-btech-orange font-bold">${remaining.toFixed(2)} ${currencyStr}</span> ${suffix}`);
            $('#shipping-progress-bar').css('width', `${pct}%`);
        }

        let finalTotal = selectedSubtotal + shipping - appliedDiscount;
        if (finalTotal < 0) finalTotal = 0;

        // Update UI
        const itemLabel = selectedTotalQty === 1 
            ? ((window.translations && window.translations.itemCountLabel) || 'منتج') 
            : ((window.translations && window.translations.itemsCountLabel) || 'منتجات');
        $('#cart-badge-count').text(`${selectedTotalQty} ${itemLabel}`);
        $('#summary-subtotal').text(`${selectedSubtotal.toFixed(2)} ${currencyStr}`);
        $('#summary-shipping').text(shipping === 0 ? ((window.translations && window.translations.free) || 'مجاني') : `${shipping.toFixed(2)} ${currencyStr}`);
        $('#summary-discount').text(`${appliedDiscount.toFixed(2)} - ${currencyStr}`);
        $('#summary-total').text(`${finalTotal.toFixed(2)} ${currencyStr}`);

        // Show crossed out subtotal if coupon is applied or there is an original discount
        let displayOriginalSubtotal = originalSubtotal + shipping;
        if (displayOriginalSubtotal > finalTotal) {
            $('#summary-subtotal-crossed').text(`${displayOriginalSubtotal.toFixed(2)} ${currencyStr}`).removeClass('hidden');
        } else {
            $('#summary-subtotal-crossed').addClass('hidden');
        }
        
        // Update header cart count
        const headerBadge = document.getElementById('cartCount');
        if (headerBadge) headerBadge.textContent = selectedTotalQty;
    }

    // Handle AJAX updates for quantity
    async function adjustQty(productId, delta) {
        const item = cartItemsList.find(i => i.productId === productId);
        if (!item) return;

        const newCount = item.count + delta;
        if (newCount < 1) return;

        item.count = newCount;

        // Update UI immediately for responsiveness
        const currencyStr = (window.translations && window.translations.currency) || 'ج.م';
        const card = $(`.cart-item-row[data-product-id=${productId}]`);
        card.find('input[type=number]').val(newCount);
        card.find('.item-subtotal').text(`${(item.price * newCount).toFixed(2)} ${currencyStr}`);
        updateSummaryUI();
        if (appliedCouponCode) {
            applyCoupon(true);
        }

        if (IsAuthenticated) {
            // DB Sync
            try {
                const response = await fetch(`/Cart/UpdateQuantity?productId=${productId}&qty=${newCount}`, { method: 'POST' });
                const result = await response.json();
                if (!result.success) {
                    console.error('Failed to update DB quantity:', result.message);
                }
            } catch (error) {
                console.error('Error updating DB quantity:', error);
            }
        } else {
            // Session Sync
            syncGuestSessionStorage();
        }
    }

    function onQtyInputChange(productId, input) {
        let val = parseInt($(input).val());
        if (isNaN(val) || val < 1) {
            val = 1;
            $(input).val(1);
        }
        if (val > 99) {
            val = 99;
            $(input).val(99);
        }

        const item = cartItemsList.find(i => i.productId === productId);
        if (!item) return;

        item.count = val;

        const card = $(`.cart-item-row[data-product-id=${productId}]`);
        card.find('.item-subtotal').text(`${(item.price * val).toFixed(2)} ج.م`);
        updateSummaryUI();
        if (appliedCouponCode) {
            applyCoupon(true);
        }

        if (IsAuthenticated) {
            fetch(`/Cart/UpdateQuantity?productId=${productId}&qty=${val}`, { method: 'POST' })
                .then(r => r.json())
                .then(res => {
                    if (!res.success) console.error(res.message);
                });
        } else {
            syncGuestSessionStorage();
        }
    }

    // Handle AJAX Deletion
    async function deleteItem(productId) {
        const card = $(`.cart-item-row[data-product-id=${productId}]`);
        card.addClass('removing');

        // Wait for CSS animation
        setTimeout(async () => {
            cartItemsList = cartItemsList.filter(i => i.productId !== productId);
            card.remove();
            
            updateSummaryUI();
            if (appliedCouponCode) {
                applyCoupon(true);
            }

            if (cartItemsList.length === 0) {
                sessionStorage.removeItem('applied_coupon');
                appliedCouponCode = "";
                appliedDiscount = 0;
                appliedDiscountItems = [];
                toggleViews(true);
            }

            if (IsAuthenticated) {
                try {
                    await fetch(`/Cart/Remove?productId=${productId}`, { method: 'POST' });
                } catch (error) {
                    console.error('Error removing item from DB:', error);
                }
            } else {
                syncGuestSessionStorage();
            }
        }, 300);
    }

    // Clear cart completely
    async function clearCart() {
        if (!confirm(IsArabic() ? 'هل أنت متأكد من رغبتك في تفريغ سلة المشتريات بالكامل؟' : 'Are you sure you want to empty the shopping cart completely?')) return;

        if (IsAuthenticated) {
            // Remove all items in DB
            for (let item of cartItemsList) {
                await fetch(`/Cart/Remove?productId=${item.productId}`, { method: 'POST' });
            }
        }

        cartItemsList = [];
        $('#cart-items-list').empty();
        syncGuestSessionStorage();
        
        // Clear coupon
        sessionStorage.removeItem('applied_coupon');
        appliedCouponCode = "";
        appliedDiscount = 0;
        appliedDiscountItems = [];
        
        updateSummaryUI();
        updateItemsDiscountUI();
        toggleViews(true);
    }

    function syncGuestSessionStorage() {
        const formatData = cartItemsList.map(i => ({ id: i.productId, qty: i.count }));
        sessionStorage.setItem('store_cart', JSON.stringify(formatData));
    }

    async function applyCoupon(silent = false) {
        const code = silent ? appliedCouponCode : $('#coupon-code').val().trim();
        const msg = $('#coupon-message');
        if (!silent) msg.addClass('hidden');

        if (!code) {
            if (!silent) msg.text(IsArabic() ? 'يرجى إدخال كود كوبون صالح' : 'Please enter a valid coupon code').removeClass('hidden');
            return;
        }

        // Only send checked items for discount calculation
        const payload = {
            code: code,
            items: cartItemsList
                .filter(i => {
                    const cb = $(`.item-checkbox[data-product-id=${i.productId}]`);
                    return cb.length === 0 || cb.is(':checked');
                })
                .map(i => ({ productId: i.productId, count: i.count }))
        };

        try {
            const response = await fetch('/Cart/ApplyCoupon', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const result = await response.json();

            if (result.success) {
                appliedCouponCode = code;
                appliedDiscount = result.discount;
                appliedDiscountItems = result.items || [];
                sessionStorage.setItem('applied_coupon', code);

                // Show applied coupon alert
                $('#applied-code-text').text(code);
                $('#coupon-applied-alert').removeClass('hidden');
                if (!silent) {
                    $('#coupon-code').val(''); // clear input box
                }

                if (!silent) {
                    msg.text(result.message)
                       .removeClass('hidden')
                       .removeClass('text-red-500')
                       .addClass('text-green-600');
                }
                
                updateSummaryUI();
                updateItemsDiscountUI();
            } else {
                if (!silent) {
                    msg.text(result.message)
                       .removeClass('hidden')
                       .removeClass('text-green-600')
                       .addClass('text-red-500');
                }
                // Reset coupon values
                appliedCouponCode = "";
                appliedDiscount = 0;
                appliedDiscountItems = [];
                sessionStorage.removeItem('applied_coupon');
                $('#coupon-applied-alert').addClass('hidden');
                
                updateSummaryUI(); // Recalculate without discount
                updateItemsDiscountUI();
            }
        } catch (error) {
            console.error('Error applying coupon:', error);
            if (!silent) {
                msg.text(IsArabic() ? 'حدث خطأ أثناء تطبيق كوبون الخصم' : 'Error applying coupon code').removeClass('hidden').addClass('text-red-500');
            }
        }
    }

    window.removeCoupon = function() {
        $('#coupon-code').val('');
        appliedCouponCode = "";
        appliedDiscount = 0;
        appliedDiscountItems = [];
        sessionStorage.removeItem('applied_coupon');
        $('#coupon-applied-alert').addClass('hidden');
        $('#coupon-message').addClass('hidden').text('');
        updateSummaryUI();
        updateItemsDiscountUI();
    };

    function updateItemsDiscountUI() {
        // Reset all item displays first
        const currencyStr = (window.translations && window.translations.currency) || 'ج.م';

        $('#cart-items-list .cart-item-row').each(function () {
            const card = $(this);
            
            // Find unit price element
            const unitPriceSpan = card.find('.unit-price');
            const originalPrice = parseFloat(unitPriceSpan.data('original-price'));
            
            if (!isNaN(originalPrice)) {
                // Restore unit price text
                unitPriceSpan.text(`${originalPrice.toFixed(2)} ${currencyStr}`);
                
                // Restore subtotal text
                const count = parseInt(card.find('input[type=number]').val()) || 1;
                const subtotalSpan = card.find('.item-subtotal');
                subtotalSpan.text(`${(originalPrice * count).toFixed(2)} ${currencyStr}`);
            }
            
            // Hide coupon badge
            const badge = card.find('.coupon-badge');
            if (badge.length) {
                badge.addClass('hidden').text('');
            }
        });

        // Apply coupon discounts
        appliedDiscountItems.forEach(item => {
            const card = $(`.cart-item-row[data-product-id=${item.productId}]`);
            if (card.length) {
                const unitPriceSpan = card.find('.unit-price');
                const originalPrice = parseFloat(unitPriceSpan.data('original-price'));
                
                if (!isNaN(originalPrice)) {
                    const discountedUnitPrice = originalPrice - item.unitDiscount;
                    unitPriceSpan.text(`${discountedUnitPrice.toFixed(2)} ${currencyStr}`);
                    
                    const count = parseInt(card.find('input[type=number]').val()) || 1;
                    const subtotalSpan = card.find('.item-subtotal');
                    subtotalSpan.text(`${(discountedUnitPrice * count).toFixed(2)} ${currencyStr}`);
                    
                    // Show coupon badge
                    let badge = card.find('.coupon-badge');
                    if (badge.length) {
                        const couponText = (window.translations && window.translations.couponDiscount) || 'خصم الكوبون:';
                        badge.text(`${couponText} -${(item.unitDiscount * count).toFixed(2)} ${currencyStr}`).removeClass('hidden');
                    }
                }
            }
        });
    }
</script>
