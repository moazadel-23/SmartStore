    <script>
        window.isAuthenticated = @(User.Identity?.IsAuthenticated.ToString().ToLower() ?? "false");
        window.serverWishlist = @Html.Raw(Json.Serialize((((List<Product>)ViewBag.WishlistProducts) ?? new List<Product>()).Select(p => new { id = p.Id })));
    </script>
    <script src="~/js/store.js" asp-append-version="true"></script>
    <script>
        // Offers filtering logic
        function filterOffers(category, btnElement) {
            // Remove active style from all tabs
            document.querySelectorAll('.offers-tab').forEach(tab => {
                tab.classList.remove('active');
                tab.classList.add('text-gray-600');
            });
            // Add active style to selected tab
            btnElement.classList.add('active');
            btnElement.classList.remove('text-gray-600');

            // Toggle product visibility
            const products = document.querySelectorAll('.product-card-offer');
            products.forEach(p => {
                if (category === 'all' || p.dataset.categoryType === category) {
                    p.classList.remove('hidden');
                } else {
                    p.classList.add('hidden');
                }
            });
        }

        // Horizontal slider scroll logic
        function scrollSlider(sliderId, direction) {
            const slider = document.getElementById(sliderId);
            if (slider) {
                const scrollAmount = direction === 'left' ? -260 : 260;
                slider.scrollBy({ left: scrollAmount, behavior: 'smooth' });
            }
        }

        // Scroll-to-top button show/hide
        window.addEventListener('scroll', function () {
            var btn = document.getElementById('scrollTopBtn');
            if (btn) {
                if (window.scrollY > 300) {
                    btn.classList.add('show');
                } else {
                    btn.classList.remove('show');
                }
            }
        });

        // Sync mobile and desktop wishlist/cart badges dynamically
        function syncBadges() {
            const dtWishCount = document.getElementById('wishlistCount');
            const mbWishCount = document.getElementById('mobileWishlistCount');
            const dtCartCount = document.getElementById('cartCount');
            const mbCartCount = document.getElementById('mobileCartCount');

            // Monitor changes in badges using a quick interval since store.js does updates
            setInterval(() => {
                if (dtWishCount && mbWishCount) mbWishCount.textContent = dtWishCount.textContent;
                if (dtCartCount && mbCartCount) mbCartCount.textContent = dtCartCount.textContent;
            }, 300);
        }
        document.addEventListener('DOMContentLoaded', syncBadges);

        // Hero Banner Carousel Logic
        (function() {
            const slides = document.querySelectorAll('.carousel-slide');
            const indicators = document.querySelectorAll('.carousel-indicator');
            const prevBtn = document.getElementById('prevSlide');
            const nextBtn = document.getElementById('nextSlide');
            let currentSlide = 0;
            let slideInterval;

            function showSlide(index) {
                slides.forEach((slide, i) => {
                    if (i === index) {
                        slide.classList.remove('opacity-0', 'pointer-events-none');
                        slide.classList.add('opacity-100', 'z-10');
                    } else {
                        slide.classList.remove('opacity-100', 'z-10');
                        slide.classList.add('opacity-0', 'pointer-events-none');
                    }
                });

                indicators.forEach((indicator, i) => {
                    if (i === index) {
                        indicator.classList.remove('bg-white/40', 'w-4');
                        indicator.classList.add('bg-white', 'w-8');
                    } else {
                        indicator.classList.remove('bg-white', 'w-8');
                        indicator.classList.add('bg-white/40', 'w-4');
                    }
                });

                currentSlide = index;
            }

            function nextSlide() {
                let next = (currentSlide + 1) % slides.length;
                showSlide(next);
            }

            function prevSlide() {
                let prev = (currentSlide - 1 + slides.length) % slides.length;
                showSlide(prev);
            }

            function startAutoplay() {
                stopAutoplay();
                slideInterval = setInterval(nextSlide, 5000);
            }

            function stopAutoplay() {
                if (slideInterval) clearInterval(slideInterval);
            }

            if (nextBtn) {
                nextBtn.addEventListener('click', () => {
                    nextSlide();
                    startAutoplay();
                });
            }

            if (prevBtn) {
                prevBtn.addEventListener('click', () => {
                    prevSlide();
                    startAutoplay();
                });
            }

            indicators.forEach((indicator, i) => {
                indicator.addEventListener('click', () => {
                    showSlide(i);
                    startAutoplay();
                });
            });

            // Initialize
            if (slides.length > 0) {
                showSlide(0);
                startAutoplay();
            }
        })();

        // Category Slider Interactivity
        (() => {
            const slider = document.getElementById('categorySlider');
            const btnPrev = document.getElementById('catSliderPrev');
            const btnNext = document.getElementById('catSliderNext');
            const progress = document.getElementById('catProgress');
            if (!slider || !progress) return;

            const isRtl = document.documentElement.dir === 'rtl';

            function updateProgress() {
                const maxScroll = slider.scrollWidth - slider.clientWidth;
                if (maxScroll <= 0) {
                    progress.style.width = '100%';
                    if (isRtl) {
                        progress.style.right = '0%';
                        progress.style.left = 'auto';
                    } else {
                        progress.style.left = '0%';
                    }
                    return;
                }

                const pct = Math.min(Math.abs(slider.scrollLeft) / maxScroll, 1);
                const thumbWidth = 35; // 35% of the track width
                progress.style.width = `${thumbWidth}%`;

                const maxPos = 100 - thumbWidth;
                const position = maxPos * pct;

                if (isRtl) {
                    progress.style.right = `${position}%`;
                    progress.style.left = 'auto';
                } else {
                    progress.style.left = `${position}%`;
                }
            }

            if (btnNext) {
                btnNext.addEventListener('click', () => {
                    const itemWidth = slider.querySelector('.category-item-btech')?.clientWidth || 100;
                    const scrollAmount = (isRtl ? -3 : 3) * itemWidth;
                    slider.scrollBy({ left: scrollAmount, behavior: 'smooth' });
                });
            }

            if (btnPrev) {
                btnPrev.addEventListener('click', () => {
                    const itemWidth = slider.querySelector('.category-item-btech')?.clientWidth || 100;
                    const scrollAmount = (isRtl ? 3 : -3) * itemWidth;
                    slider.scrollBy({ left: scrollAmount, behavior: 'smooth' });
                });
            }

            slider.addEventListener('scroll', updateProgress);
            window.addEventListener('resize', updateProgress);
            
            // Mouse drag scrolling functionality
            let isDown = false;
            let startX;
            let scrollLeftVal;

            slider.addEventListener('mousedown', (e) => {
                isDown = true;
                slider.classList.add('active');
                startX = e.pageX - slider.offsetLeft;
                scrollLeftVal = slider.scrollLeft;
            });

            slider.addEventListener('mouseleave', () => {
                isDown = false;
                slider.classList.remove('active');
            });

            slider.addEventListener('mouseup', () => {
                isDown = false;
                slider.classList.remove('active');
            });

            slider.addEventListener('mousemove', (e) => {
                if (!isDown) return;
                e.preventDefault();
                const x = e.pageX - slider.offsetLeft;
                const walk = (x - startX) * 1.5; // scroll speed multiplier
                slider.scrollLeft = scrollLeftVal - walk;
            });

            // Run once to initialize
            setTimeout(updateProgress, 200);

            // Autoplay scrolling every 5 seconds in one direction
            let autoplayInterval = setInterval(() => {
                const maxScroll = slider.scrollWidth - slider.clientWidth;
                if (maxScroll <= 0) return;

                const itemWidth = slider.querySelector('.category-item-btech')?.clientWidth || 100;
                const currentScroll = Math.abs(slider.scrollLeft);

                if (currentScroll >= maxScroll - 10) {
                    // Loop back to the beginning smoothly
                    slider.scrollTo({ left: 0, behavior: 'smooth' });
                } else {
                    // Slide forward in RTL/LTR direction
                    slider.scrollBy({ left: isRtl ? -itemWidth : itemWidth, behavior: 'smooth' });
                }
            }, 5000);

            // Pause autoplay on hover
            slider.addEventListener('mouseenter', () => clearInterval(autoplayInterval));
            slider.addEventListener('mouseleave', () => {
                clearInterval(autoplayInterval);
                autoplayInterval = setInterval(() => {
                    const maxScroll = slider.scrollWidth - slider.clientWidth;
                    if (maxScroll <= 0) return;

                    const itemWidth = slider.querySelector('.category-item-btech')?.clientWidth || 100;
                    const currentScroll = Math.abs(slider.scrollLeft);

                    if (currentScroll >= maxScroll - 10) {
                        slider.scrollTo({ left: 0, behavior: 'smooth' });
                    } else {
                        slider.scrollBy({ left: isRtl ? -itemWidth : itemWidth, behavior: 'smooth' });
                    }
                }, 5000);
            });
        })();
    </script>

