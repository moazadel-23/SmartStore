@model StoreViewModel
@using System.IO
@using System.Text.Json
@using SmartStore.Models
@inject SmartStore.DataAccess.ApplicationDbContext _context
@{
    Layout = null;
    ViewData["Title"] = "بي تك | الأجهزة المنزلية والالكترونيات | بأسعار وعروض مميزة";
    var wishlistProducts = ViewBag.WishlistProducts as List<Product>;

    // Load Banners from Database
    var banners = _context.Banners.FirstOrDefault();

    if (banners == null)
    {
        banners = new BannerModel
        {
            Slide1ImageUrl = "https://images.unsplash.com/photo-1468495244123-6c6c332eeece?w=1600&fit=crop&q=80",
            Slide2ImageUrl = "https://images.unsplash.com/photo-1556911220-e15b29be8c8f?w=1600&fit=crop&q=80",
            Slide3ImageUrl = "https://images.unsplash.com/photo-1542751371-adc38448a05e?w=1600&fit=crop&q=80",
        };
    }

    // Fallback for Huawei and Anker Promo Banners
    if (string.IsNullOrEmpty(banners.HuaweiTitle)) banners.HuaweiTitle = "مهرجان هواوي HUAWEI";
    if (string.IsNullOrEmpty(banners.HuaweiSubtitle)) banners.HuaweiSubtitle = "احصل على كوبونات خصم فورية وهدايا مجانية عند شراء أي من أجهزة هواوي لابتوب أو ساعة ذكية.";
    if (string.IsNullOrEmpty(banners.HuaweiLinkUrl)) banners.HuaweiLinkUrl = "/Customer/Home/Store?SearchQuery=Huawei";
    if (string.IsNullOrEmpty(banners.HuaweiImageUrl)) banners.HuaweiImageUrl = "/Banners/6dd23630-6367-416d-9d5f-8e35a0ad917d.avif";

    if (string.IsNullOrEmpty(banners.AnkerTitle)) banners.AnkerTitle = "أنكر ANKER لشواحن الهواتف وملحقاتها";
    if (string.IsNullOrEmpty(banners.AnkerSubtitle)) banners.AnkerSubtitle = "أقوى حماية وأسرع شحن لهواتفك الذكية، عروض خصم تصل لـ 25% حصرياً.";
    if (string.IsNullOrEmpty(banners.AnkerLinkUrl)) banners.AnkerLinkUrl = "/Customer/Home/Store?SearchQuery=Anker";
    if (string.IsNullOrEmpty(banners.AnkerImageUrl)) banners.AnkerImageUrl = "/Banners/285ed515-8497-4161-9279-8372cb39b622.avif";

    // Fallback for Installment Banners
    if (string.IsNullOrEmpty(banners.Installment1Title)) banners.Installment1Title = "قسط على سعر الكاش";
    if (string.IsNullOrEmpty(banners.Installment1Subtitle)) banners.Installment1Subtitle = "0% فوائد | 0% مقدم | 0% مصاريف إدارية";
    if (string.IsNullOrEmpty(banners.Installment1Duration)) banners.Installment1Duration = "12 شهر";
    if (string.IsNullOrEmpty(banners.Installment1LinkUrl)) banners.Installment1LinkUrl = "/Customer/Home/Store";

    if (string.IsNullOrEmpty(banners.Installment2Title)) banners.Installment2Title = "قسط على سعر الكاش";
    if (string.IsNullOrEmpty(banners.Installment2Subtitle)) banners.Installment2Subtitle = "0% فوائد | 0% مقدم | 0% مصاريف إدارية";
    if (string.IsNullOrEmpty(banners.Installment2Duration)) banners.Installment2Duration = "3 شهور";
    if (string.IsNullOrEmpty(banners.Installment2LinkUrl)) banners.Installment2LinkUrl = "/Customer/Home/Store";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'btech-orange': '#ff6a00',
                        'btech-orange-dark': '#e05d00',
                        'btech-orange-light': '#fff0e6',
                        'btech-black': '#111111',
                        'btech-gray': '#f4f4f5',
                        'whatsapp': '#25D366',
                    },
                    fontFamily: {
                        sans: ['Cairo', 'Inter', 'Segoe UI', 'Roboto', 'sans-serif'],
                    },
                    maxWidth: {
                        '8xl': '1440px',
                    },
                },
            },
        };
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/store.css" asp-append-version="true" />
    <style>
        * { box-sizing: border-box; }
        body { font-family: 'Cairo', 'Inter', 'Segoe UI', 'Roboto', sans-serif; background: #ffffff; scroll-behavior: smooth; }
        .promo-card { transition: transform 0.3s ease, box-shadow 0.3s ease; }
        .promo-card:hover { transform: translateY(-4px); box-shadow: 0 12px 24px rgba(0,0,0,0.08); }
        .product-card { transition: transform 0.25s ease, box-shadow 0.25s ease; }
        .product-card:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(0,0,0,0.06); }
        .scroll-top { transition: opacity 0.3s ease, transform 0.3s ease; }
        .scroll-top.show { opacity: 1; pointer-events: auto; transform: translateY(0); }
        .scroll-top { opacity: 0; pointer-events: none; transform: translateY(20px); }
        .carousel-arrow { transition: opacity 0.2s ease, background 0.2s ease; }
        .carousel-arrow:hover { background: rgba(0,0,0,0.05); }
        .category-item { transition: transform 0.2s ease; cursor: pointer; }
        .category-item:hover { transform: translateY(-4px); }
        .hide-scrollbar::-webkit-scrollbar { display: none; }
        .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        
        /* Highlight active offers filter tab */
        .offers-tab.active {
            background-color: #ff6a00;
            color: #ffffff;
            border-color: #ff6a00;
        }
    </style>
    <!-- Boxicons -->
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    <!-- Chatbot CSS -->
    <link rel="stylesheet" href="~/css/chatbot.css" asp-append-version="true" />
</head>
<body class="bg-gray-50 pb-20 md:pb-0">

    <!-- ═══ MAIN HEADER & SEARCH ═══ -->
    @await Html.PartialAsync("_BTechHeader")


    <main class="max-w-8xl mx-auto px-4 py-4 space-y-8">
        
        <!-- ═══ HERO BANNER SLIDER ═══ -->
        <section class="relative rounded-2xl overflow-hidden shadow-sm min-h-[220px] sm:min-h-[360px] md:min-h-[440px] bg-gray-900 group">
            
            <!-- Carousel Container -->
            <div id="heroCarousel" class="relative w-full h-[220px] sm:h-[360px] md:h-[440px] overflow-hidden">
                
                <!-- Slide 1 -->
                <div class="carousel-slide absolute inset-0 opacity-100 transition-all duration-700 ease-in-out" data-index="0">
                    <img src="@banners.Slide1ImageUrl" class="w-full h-full object-cover" alt="العرض الأول" />
                    <div class="absolute bottom-6 right-6 sm:bottom-10 sm:right-10 md:bottom-12 md:right-12 z-10">
                        <a href="/Customer/Home/Store" class="inline-flex items-center gap-2 bg-[#ff6a00] hover:bg-[#e05d00] text-white font-black px-6 py-2.5 rounded-full shadow-lg transition-all transform hover:scale-105 text-sm border-0 no-underline">
                            <span>تسوق الآن</span>
                            <i class="fas fa-chevron-left text-[10px]"></i>
                        </a>
                    </div>
                </div>

                <!-- Slide 2 -->
                <div class="carousel-slide absolute inset-0 opacity-0 transition-all duration-700 ease-in-out" data-index="1">
                    <img src="@banners.Slide2ImageUrl" class="w-full h-full object-cover" alt="العرض الثاني" />
                    <div class="absolute bottom-6 right-6 sm:bottom-10 sm:right-10 md:bottom-12 md:right-12 z-10">
                        <a href="/Customer/Home/Store" class="inline-flex items-center gap-2 bg-[#ff6a00] hover:bg-[#e05d00] text-white font-black px-6 py-2.5 rounded-full shadow-lg transition-all transform hover:scale-105 text-sm border-0 no-underline">
                            <span>تسوق الآن</span>
                            <i class="fas fa-chevron-left text-[10px]"></i>
                        </a>
                    </div>
                </div>

                <!-- Slide 3 -->
                <div class="carousel-slide absolute inset-0 opacity-0 transition-all duration-700 ease-in-out" data-index="2">
                    <img src="@banners.Slide3ImageUrl" class="w-full h-full object-cover" alt="العرض الثالث" />
                    <div class="absolute bottom-6 right-6 sm:bottom-10 sm:right-10 md:bottom-12 md:right-12 z-10">
                        <a href="/Customer/Home/Store" class="inline-flex items-center gap-2 bg-[#ff6a00] hover:bg-[#e05d00] text-white font-black px-6 py-2.5 rounded-full shadow-lg transition-all transform hover:scale-105 text-sm border-0 no-underline">
                            <span>تسوق الآن</span>
                            <i class="fas fa-chevron-left text-[10px]"></i>
                        </a>
                    </div>
                </div>

            </div>

            <!-- Carousel Controls -->
            <button type="button" id="prevSlide" class="absolute right-4 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-black/30 hover:bg-black/60 text-white flex items-center justify-center transition-all opacity-0 group-hover:opacity-100 border-0 cursor-pointer z-20">
                <i class="fas fa-chevron-right"></i>
            </button>
            <button type="button" id="nextSlide" class="absolute left-4 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-black/30 hover:bg-black/60 text-white flex items-center justify-center transition-all opacity-0 group-hover:opacity-100 border-0 cursor-pointer z-20">
                <i class="fas fa-chevron-left"></i>
            </button>

            <!-- Slide Indicators -->
            <div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex items-center gap-2 z-20">
                <button type="button" class="carousel-indicator w-2 h-2 rounded-full bg-white transition-all cursor-pointer border-0" data-slide="0"></button>
                <button type="button" class="carousel-indicator w-2 h-2 rounded-full bg-white/50 transition-all cursor-pointer border-0" data-slide="1"></button>
                <button type="button" class="carousel-indicator w-2 h-2 rounded-full bg-white/50 transition-all cursor-pointer border-0" data-slide="2"></button>
            </div>

        </section>

        <!-- ═══ CIRCULAR CATEGORIES ROW ═══ -->
        <section class="bg-white py-6 px-4 rounded-2xl border border-gray-100 shadow-sm overflow-x-auto hide-scrollbar">
            <div class="flex items-center justify-between gap-4 md:justify-around min-w-[640px]">
                <a href="/Customer/Home/Store" class="category-item flex flex-col items-center gap-2 flex-shrink-0 text-center">
                    <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-orange-50 border border-orange-100 flex items-center justify-center p-3">
                        <i class="fas fa-th-large text-btech-orange text-xl sm:text-2xl"></i>
                    </div>
                    <span class="font-bold text-xs sm:text-sm text-gray-700">كل الأقسام</span>
                </a>
                
                <a href="/Customer/Home/Store?Filter.CategoryIds=1" class="category-item flex flex-col items-center gap-2 flex-shrink-0 text-center">
                    <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-white shadow-sm border border-gray-100 flex items-center justify-center p-2.5">
                        <img src="~/img/iphone15.png" alt="موبايل" class="w-full h-full object-contain" onerror="this.src='https://images.unsplash.com/photo-1511707171634-5f897ff02aa9?w=100&h=100&fit=crop&q=80'" />
                    </div>
                    <span class="font-bold text-xs sm:text-sm text-gray-700">موبايل</span>
                </a>

                <a href="/Customer/Home/Store?Filter.CategoryIds=2" class="category-item flex flex-col items-center gap-2 flex-shrink-0 text-center">
                    <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-white shadow-sm border border-gray-100 flex items-center justify-center p-2.5">
                        <img src="https://images.unsplash.com/photo-1496181133206-80ce9b88a853?w=100&h=100&fit=crop&q=80" alt="لابتوب" class="w-full h-full object-contain" />
                    </div>
                    <span class="font-bold text-xs sm:text-sm text-gray-700">لابتوب</span>
                </a>

                <a href="/Customer/Home/Store?Filter.CategoryIds=3" class="category-item flex flex-col items-center gap-2 flex-shrink-0 text-center">
                    <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-white shadow-sm border border-gray-100 flex items-center justify-center p-2.5">
                        <img src="~/img/dell_mon.png" alt="شاشات" class="w-full h-full object-contain" onerror="this.src='https://images.unsplash.com/photo-1527443224154-c4a3942d3acf?w=100&h=100&fit=crop&q=80'" />
                    </div>
                    <span class="font-bold text-xs sm:text-sm text-gray-700">شاشات</span>
                </a>

                <a href="/Customer/Home/Store?Filter.CategoryIds=4" class="category-item flex flex-col items-center gap-2 flex-shrink-0 text-center">
                    <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-white shadow-sm border border-gray-100 flex items-center justify-center p-2.5">
                        <img src="~/img/ipad.png" alt="تابلت" class="w-full h-full object-contain" onerror="this.src='https://images.unsplash.com/photo-1544244015-0df4b3ffc6b0?w=100&h=100&fit=crop&q=80'" />
                    </div>
                    <span class="font-bold text-xs sm:text-sm text-gray-700">تابلت</span>
                </a>

                <a href="/Customer/Home/Store?Filter.CategoryIds=5" class="category-item flex flex-col items-center gap-2 flex-shrink-0 text-center">
                    <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-white shadow-sm border border-gray-100 flex items-center justify-center p-2.5">
                        <img src="~/img/watch9.png" alt="ساعات ذكية" class="w-full h-full object-contain" onerror="this.src='https://images.unsplash.com/photo-1508685096489-7aacd43bd3b1?w=100&h=100&fit=crop&q=80'" />
                    </div>
                    <span class="font-bold text-xs sm:text-sm text-gray-700">ساعات ذكية</span>
                </a>

                <a href="/Customer/Home/Store?Filter.CategoryIds=6" class="category-item flex flex-col items-center gap-2 flex-shrink-0 text-center">
                    <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-white shadow-sm border border-gray-100 flex items-center justify-center p-2.5">
                        <img src="~/img/sony_audio.png" alt="صوتيات" class="w-full h-full object-contain" onerror="this.src='https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=100&h=100&fit=crop&q=80'" />
                    </div>
                    <span class="font-bold text-xs sm:text-sm text-gray-700">صوتيات</span>
                </a>
            </div>
        </section>

        <!-- ═══ PROMOTIONAL BANNERS ═══ -->
        <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Huawei Banner -->
            <div class="relative overflow-hidden rounded-2xl bg-gradient-to-r from-red-50 to-pink-50 border border-red-100 p-6 flex flex-col md:flex-row justify-between items-center gap-6 group hover:shadow-md transition-all duration-300">
                <div class="space-y-3 max-w-md text-right">
                    <span class="inline-block bg-red-100 text-red-600 text-xs font-black px-3 py-1 rounded-full">مهرجان هواوي</span>
                    <h3 class="text-xl font-black text-gray-900">مهرجان هواوي HUAWEI</h3>
                    <p class="text-gray-600 text-xs sm:text-sm font-medium leading-relaxed font-bold">احصل على كوبونات خصم فورية وهدايا مجانية عند شراء أي من أجهزة هواوي لابتوب أو ساعة ذكية.</p>
                    <a href="/Customer/Home/Store?SearchQuery=Huawei" class="inline-flex items-center gap-2 bg-red-600 hover:bg-red-700 text-white font-black px-5 py-2 rounded-full text-xs transition-transform transform hover:scale-105 border-0 no-underline">
                        <span>تسوق الآن</span>
                        <i class="fas fa-chevron-left text-[8px]"></i>
                    </a>
                </div>
                <div class="w-32 h-32 flex-shrink-0 flex items-center justify-center">
                    <img src="/Banners/6dd23630-6367-416d-9d5f-8e35a0ad917d.avif" alt="HUAWEI" class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-300" onerror="this.src='https://images.unsplash.com/photo-1544244015-0df4b3ffc6b0?w=200&h=200&fit=crop&q=80'" />
                </div>
            </div>

            <!-- Anker Banner -->
            <div class="relative overflow-hidden rounded-2xl bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-100 p-6 flex flex-col md:flex-row justify-between items-center gap-6 group hover:shadow-md transition-all duration-300">
                <div class="space-y-3 max-w-md text-right">
                    <span class="inline-block bg-blue-100 text-blue-600 text-xs font-black px-3 py-1 rounded-full">عروض أنكر</span>
                    <h3 class="text-xl font-black text-gray-900">أنكر ANKER لشواحن الهواتف وملحقاتها</h3>
                    <p class="text-gray-600 text-xs sm:text-sm font-medium leading-relaxed font-bold">أقوى حماية وأسرع شحن لهواتفك الذكية، عروض خصم تصل لـ 25% حصرياً.</p>
                    <a href="/Customer/Home/Store?SearchQuery=Anker" class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-black px-5 py-2 rounded-full text-xs transition-transform transform hover:scale-105 border-0 no-underline">
                        <span>تسوق الآن</span>
                        <i class="fas fa-chevron-left text-[8px]"></i>
                    </a>
                </div>
                <div class="w-32 h-32 flex-shrink-0 flex items-center justify-center">
                    <img src="/Banners/285ed515-8497-4161-9279-8372cb39b622.avif" alt="ANKER" class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-300" onerror="this.src='https://images.unsplash.com/photo-1583863788434-e58a36330cf0?w=200&h=200&fit=crop&q=80'" />
                </div>
            </div>
        </section>

        <!-- ═══ "أقوى العروض!" (STRONGEST OFFERS) FILTERED CAROUSEL ═══ -->
        <section class="space-y-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <h2 class="text-xl sm:text-2xl font-black text-gray-800">أقوى العروض!</h2>
                    <span class="w-2.5 h-2.5 rounded-full bg-btech-orange animate-ping"></span>
                </div>
                <a href="/Customer/Home/Store" class="text-btech-orange text-xs sm:text-sm font-black hover:underline">عرض الكل ←</a>
            </div>

            <!-- Categories Tabs -->
            <div class="flex items-center gap-2 overflow-x-auto hide-scrollbar pb-1 text-xs sm:text-sm whitespace-nowrap">
                <button onclick="filterOffers('all', this)" class="offers-tab active px-5 py-2 rounded-full border border-gray-200 font-bold transition-all">الكل</button>
                <button onclick="filterOffers('mobile', this)" class="offers-tab px-5 py-2 rounded-full border border-gray-200 font-bold text-gray-600 transition-all">موبايل</button>
                <button onclick="filterOffers('laptop', this)" class="offers-tab px-5 py-2 rounded-full border border-gray-200 font-bold text-gray-600 transition-all">لابتوب</button>
                <button onclick="filterOffers('tv', this)" class="offers-tab px-5 py-2 rounded-full border border-gray-200 font-bold text-gray-600 transition-all">تلفزيونات</button>
                <button onclick="filterOffers('watch', this)" class="offers-tab px-5 py-2 rounded-full border border-gray-200 font-bold text-gray-600 transition-all">ساعات</button>
            </div>

            <!-- Horizontal Product Slider -->
            <div class="relative">
                <button onclick="scrollSlider('offersContainer', 'left')" class="absolute -left-3 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-white shadow border border-gray-100 flex items-center justify-center text-gray-600 z-10 hover:bg-gray-50"><i class="fas fa-chevron-left"></i></button>
                <div id="offersContainer" class="flex gap-4 overflow-x-auto hide-scrollbar scroll-smooth py-2 px-1">
                    @foreach (var product in Model.Products.Take(12))
                    {
                        var catName = product.Category?.Name?.ToLower() ?? "";
                        string catType = "other";
                        if (catName.Contains("phone") || catName.Contains("mobile") || catName.Contains("smartphone")) {
                            catType = "mobile";
                        } else if (catName.Contains("laptop") || catName.Contains("computer") || catName.Contains("pc")) {
                            catType = "laptop";
                        } else if (catName.Contains("tv") || catName.Contains("television") || catName.Contains("screen") || catName.Contains("monitor")) {
                            catType = "tv";
                        } else if (catName.Contains("watch") || catName.Contains("wearable") || catName.Contains("clock")) {
                            catType = "watch";
                        }

                        <div class="product-card-offer flex-shrink-0 w-44 sm:w-52" data-category-type="@catType">
                            @await Html.PartialAsync("_ProductCard", product)
                        </div>
                    }
                </div>
                <button onclick="scrollSlider('offersContainer', 'right')" class="absolute -right-3 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-white shadow border border-gray-100 flex items-center justify-center text-gray-600 z-10 hover:bg-gray-50"><i class="fas fa-chevron-right"></i></button>
            </div>
        </section>

        <!-- ═══ 3-COLUMN UNIFIED SECTION (INSTALLMENTS, CATEGORIES & DEALS) ═══ -->
        <section class="grid grid-cols-1 lg:grid-cols-3 gap-6 bg-[#f4f4f4] p-6 rounded-3xl">

            <!-- 1. Right Column: Installment Banners (عروض التقسيط) -->
            <div class="space-y-4 flex flex-col justify-between h-full">
                <!-- Card 1 -->
                <a href="@banners.Installment1LinkUrl" class="group relative overflow-hidden rounded-2xl bg-gradient-to-br from-[#ff6a00]/95 to-[#ff8c00] text-white p-6 flex flex-col justify-between h-[210px] shadow-sm hover:shadow-md transition-all duration-300 border-0 no-underline">
                    <div class="absolute -right-10 -bottom-10 w-36 h-36 rounded-full bg-white/10 group-hover:scale-110 transition-transform duration-300"></div>
                    <div class="space-y-2">
                        <span class="inline-block bg-white/20 text-white text-[10px] font-black px-3 py-1 rounded-full">@banners.Installment1Duration</span>
                        <h3 class="text-lg font-black leading-tight text-white m-0">@banners.Installment1Title</h3>
                        <p class="text-white/95 text-xs font-bold leading-relaxed m-0">@banners.Installment1Subtitle</p>
                    </div>
                    <div class="flex items-center gap-1 text-xs font-black group-hover:underline text-white">
                        تسوق الآن <i class="fa-solid fa-chevron-left text-[8px]"></i>
                    </div>
                </a>

                <!-- Card 2 -->
                <a href="@banners.Installment2LinkUrl" class="group relative overflow-hidden rounded-2xl bg-gradient-to-br from-[#111111]/95 to-[#333333] text-white p-6 flex flex-col justify-between h-[210px] shadow-sm hover:shadow-md transition-all duration-300 border-0 no-underline">
