@model StoreViewModel
@using System.IO
@using System.Text.Json
@using SmartStore.Models
@inject SmartStore.DataAccess.ApplicationDbContext _context
@{
    Layout = null;
    ViewData["Title"] = Localizer["HomePageTitle"];
    var wishlistProducts = ViewBag.WishlistProducts as List<Product>;

    // Load Banners from Database
    var banners = _context.Banners.FirstOrDefault();

    if (banners == null)
    {
        banners = new BannerModel
        {
            Slide1ImageUrl = "/Banners/banner_slide1.png",
            Slide2ImageUrl = "/Banners/banner_slide2.png",
            Slide3ImageUrl = "/Banners/banner_slide3.png",
            Slide4ImageUrl = "/Banners/banner_slide4.png",
            Slide5ImageUrl = "/Banners/banner_slide5.png",
        };
    }

    // Fallback Slide Images if empty in DB
    if (string.IsNullOrEmpty(banners.Slide1ImageUrl)) banners.Slide1ImageUrl = "/Banners/banner_slide1.png";
    if (string.IsNullOrEmpty(banners.Slide2ImageUrl)) banners.Slide2ImageUrl = "/Banners/banner_slide2.png";
    if (string.IsNullOrEmpty(banners.Slide3ImageUrl)) banners.Slide3ImageUrl = "/Banners/banner_slide3.png";
    if (string.IsNullOrEmpty(banners.Slide4ImageUrl)) banners.Slide4ImageUrl = "/Banners/banner_slide4.png";
    if (string.IsNullOrEmpty(banners.Slide5ImageUrl)) banners.Slide5ImageUrl = "/Banners/banner_slide5.png";

    // Fallback for Huawei and Anker Promo Banners
    if (string.IsNullOrEmpty(banners.HuaweiTitle)) banners.HuaweiTitle = Localizer["HuaweiTitle"].Value;
    if (string.IsNullOrEmpty(banners.HuaweiSubtitle)) banners.HuaweiSubtitle = Localizer["HuaweiSubtitle"].Value;
    if (string.IsNullOrEmpty(banners.HuaweiLinkUrl)) banners.HuaweiLinkUrl = "/Customer/Home/Store?SearchQuery=Huawei";
    if (string.IsNullOrEmpty(banners.HuaweiImageUrl)) banners.HuaweiImageUrl = "/Banners/6dd23630-6367-416d-9d5f-8e35a0ad917d.avif";

    if (string.IsNullOrEmpty(banners.AnkerTitle)) banners.AnkerTitle = Localizer["AnkerTitle"].Value;
    if (string.IsNullOrEmpty(banners.AnkerSubtitle)) banners.AnkerSubtitle = Localizer["AnkerSubtitle"].Value;
    if (string.IsNullOrEmpty(banners.AnkerLinkUrl)) banners.AnkerLinkUrl = "/Customer/Home/Store?SearchQuery=Anker";
    if (string.IsNullOrEmpty(banners.AnkerImageUrl)) banners.AnkerImageUrl = "/Banners/285ed515-8497-4161-9279-8372cb39b622.avif";

    // Fallback for Installment Banners
    if (string.IsNullOrEmpty(banners.Installment1Title)) banners.Installment1Title = Localizer["InstallmentTitleDefault"].Value;
    if (string.IsNullOrEmpty(banners.Installment1Subtitle)) banners.Installment1Subtitle = Localizer["InstallmentSubtitleDefault1"].Value;
    if (string.IsNullOrEmpty(banners.Installment1Duration)) banners.Installment1Duration = Localizer["Installment12Months"].Value;
    if (string.IsNullOrEmpty(banners.Installment1LinkUrl)) banners.Installment1LinkUrl = "/Customer/Home/Store";

    if (string.IsNullOrEmpty(banners.Installment2Title)) banners.Installment2Title = Localizer["InstallmentTitleDefault"].Value;
    if (string.IsNullOrEmpty(banners.Installment2Subtitle)) banners.Installment2Subtitle = Localizer["InstallmentSubtitleDefault2"].Value;
    if (string.IsNullOrEmpty(banners.Installment2Duration)) banners.Installment2Duration = Localizer["Installment3Months"].Value;
    if (string.IsNullOrEmpty(banners.Installment2LinkUrl)) banners.Installment2LinkUrl = "/Customer/Home/Store";

    // Load categories for category link resolver
    var allCategories = _context.Categories.ToList();

    // Grid category links helper
    string GetGridLink(string? categoryName, string? fallbackLink)
    {
        if (!string.IsNullOrWhiteSpace(categoryName))
        {
            var matchedCat = allCategories.FirstOrDefault(c => c.Name.Trim().Equals(categoryName.Trim(), System.StringComparison.OrdinalIgnoreCase));
            if (matchedCat != null)
            {
                return $"/Customer/Home/Store?Filter.CategoryIds={matchedCat.Id}";
            }
        }
        return string.IsNullOrEmpty(fallbackLink) ? "/Customer/Home/Store" : fallbackLink;
    }

    // Resolved Category IDs from DB based on names
    var electronicsId = allCategories.FirstOrDefault(c => c.Name.Equals("Electronics", System.StringComparison.OrdinalIgnoreCase))?.Id;
    var homeAppliancesId = allCategories.FirstOrDefault(c => c.Name.Equals("Home Appliances", System.StringComparison.OrdinalIgnoreCase))?.Id;
    var gamingId = allCategories.FirstOrDefault(c => c.Name.Equals("Gaming", System.StringComparison.OrdinalIgnoreCase))?.Id;
    var personalCareId = allCategories.FirstOrDefault(c => c.Name.Equals("Personal Care", System.StringComparison.OrdinalIgnoreCase))?.Id;

    bool isRTL = System.Globalization.CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;

    // Seed B.TECH categories in the database if they are not already present
    if (allCategories.Count <= 5)
    {
        var seedCats = new List<Category>
        {
            new Category { Name = "Mobiles", Description = "Smartphones and mobile devices", ImageUrl = "/img/iphone15.png", Status = true },
            new Category { Name = "Laptops", Description = "Laptops and notebooks", ImageUrl = "https://images.unsplash.com/photo-1496181133206-80ce9b88a853?w=150&h=150&fit=crop&q=80", Status = true },
            new Category { Name = "PlayStation", Description = "Gaming consoles and accessories", ImageUrl = "https://images.unsplash.com/photo-1606813907291-d86efa9b94db?w=150&h=150&fit=crop&q=80", Status = true },
            new Category { Name = "TVs", Description = "Televisions and screens", ImageUrl = "https://images.unsplash.com/photo-1593305841991-05c297ba4575?w=150&h=150&fit=crop&q=80", Status = true },
            new Category { Name = "Air Conditioners", Description = "ACs and cooling systems", ImageUrl = "https://images.unsplash.com/photo-1585399000684-d2f72660f092?w=150&h=150&fit=crop&q=80", Status = true },
            new Category { Name = "Home Appliances", Description = "Refrigerators, microwaves, and home appliances", ImageUrl = "/img/micro.png", Status = true },
            new Category { Name = "Audio Devices", Description = "Speakers, headphones, and earbuds", ImageUrl = "/img/buds.png", Status = true },
            new Category { Name = "Smart Watches", Description = "Smartwatches and fitness bands", ImageUrl = "/img/watch9.png", Status = true },
            new Category { Name = "Printers", Description = "Printers and scanners", ImageUrl = "https://images.unsplash.com/photo-1612815154858-60aa4c59eaa6?w=150&h=150&fit=crop&q=80", Status = true },
            new Category { Name = "Monitors", Description = "Computer monitors", ImageUrl = "/img/dell_mon.png", Status = true },
            new Category { Name = "Computer Accessories", Description = "Keyboards, mice, and hubs", ImageUrl = "https://images.unsplash.com/photo-1587829741301-dc798b83add3?w=150&h=150&fit=crop&q=80", Status = true },
            new Category { Name = "Storage Units", Description = "Flash drives and portable SSDs", ImageUrl = "https://images.unsplash.com/photo-1618424181497-157f25b6ddd5?w=150&h=150&fit=crop&q=80", Status = true },
            new Category { Name = "Networks", Description = "Routers and networking devices", ImageUrl = "https://images.unsplash.com/photo-1544244015-0df4b3ffc6b0?w=150&h=150&fit=crop&q=80", Status = true }
        };

        foreach (var seed in seedCats)
        {
            if (!allCategories.Any(c => c.Name.Equals(seed.Name, StringComparison.OrdinalIgnoreCase)))
            {
                _context.Categories.Add(seed);
            }
        }
        _context.SaveChanges();
        allCategories = _context.Categories.ToList();
    }

    var dbCategories = allCategories.Where(c => c.Status).ToList();

    string GetCategoryDisplayName(Category cat)
    {
        var name = cat.Name;
        if (name.Equals("Mobiles", StringComparison.OrdinalIgnoreCase)) return isRTL ? "ظ…ظˆط¨ط§ظٹظ„ط§طھ" : "Mobiles";
        if (name.Equals("Laptops", StringComparison.OrdinalIgnoreCase)) return isRTL ? "ظ„ط§ط¨ طھظˆط¨" : "Laptops";
        if (name.Equals("PlayStation", StringComparison.OrdinalIgnoreCase)) return isRTL ? "ط¨ظ„ط§ظٹ ط³طھظٹط´ظ†" : "PlayStation";
        if (name.Equals("TVs", StringComparison.OrdinalIgnoreCase)) return isRTL ? "طھظ„ظپط²ظٹظˆظ†ط§طھ" : "TVs";
        if (name.Equals("Air Conditioners", StringComparison.OrdinalIgnoreCase)) return isRTL ? "طھظƒظٹظٹظپط§طھ" : "Air Conditioners";
        if (name.Equals("Home Appliances", StringComparison.OrdinalIgnoreCase)) return isRTL ? "ط£ط¬ظ‡ط²ط© ظ…ظ†ط²ظ„ظٹط©" : "Home Appliances";
        if (name.Equals("Audio Devices", StringComparison.OrdinalIgnoreCase)) return isRTL ? "ط£ط¬ظ‡ط²ط© طµظˆطھ" : "Audio Devices";
        if (name.Equals("Smart Watches", StringComparison.OrdinalIgnoreCase)) return isRTL ? "ط³ط§ط¹ط§طھ ط°ظƒظٹط©" : "Smart Watches";
        if (name.Equals("Printers", StringComparison.OrdinalIgnoreCase)) return isRTL ? "ط·ط§ط¨ط¹ط§طھ" : "Printers";
        if (name.Equals("Monitors", StringComparison.OrdinalIgnoreCase)) return isRTL ? "ط´ط§ط´ط§طھ" : "Monitors";
        if (name.Equals("Computer Accessories", StringComparison.OrdinalIgnoreCase)) return isRTL ? "ط¥ظƒط³ط³ظˆط§ط±ط§طھ ظƒظ…ط¨ظٹظˆطھط±" : "Computer Accessories";
        if (name.Equals("Storage Units", StringComparison.OrdinalIgnoreCase)) return isRTL ? "ظˆط­ط¯ط§طھ طھط®ط²ظٹظ†" : "Storage Units";
        if (name.Equals("Networks", StringComparison.OrdinalIgnoreCase)) return isRTL ? "ط´ط¨ظƒط§طھ" : "Networks";
        
        return Localizer[name].Value;
    }

    string GetCategoryLink(Category cat)
    {
        var name = cat.Name.ToLower();
        var catId = cat.Id;
        
        if (name.Contains("phone") || name.Contains("mobile"))
            return $"/Customer/Home/Store?Filter.CategoryIds={catId}&SearchQuery=phone";
        if (name.Contains("laptop") || name.Contains("notebook"))
            return $"/Customer/Home/Store?Filter.CategoryIds={catId}&SearchQuery=laptop";
        if (name.Contains("playstation") || name.Contains("gaming"))
            return $"/Customer/Home/Store?Filter.CategoryIds={catId}&SearchQuery=playstation";
        if (name.Contains("tv") || name.Contains("television"))
            return $"/Customer/Home/Store?Filter.CategoryIds={catId}&SearchQuery=tv";
        if (name.Contains("conditioner") || name.Contains("ac"))
            return $"/Customer/Home/Store?Filter.CategoryIds={catId}&SearchQuery=ac";
        if (name.Contains("audio") || name.Contains("sound") || name.Contains("speaker") || name.Contains("buds"))
            return $"/Customer/Home/Store?Filter.CategoryIds={catId}&SearchQuery=buds";
        if (name.Contains("watch") || name.Contains("wearable"))
            return $"/Customer/Home/Store?Filter.CategoryIds={catId}&SearchQuery=watch";
        if (name.Contains("printer"))
            return $"/Customer/Home/Store?Filter.CategoryIds={catId}&SearchQuery=printer";
        if (name.Contains("monitor") || name.Contains("screen"))
            return $"/Customer/Home/Store?Filter.CategoryIds={catId}&SearchQuery=monitor";
        if (name.Contains("accessory") || name.Contains("keyboard") || name.Contains("mouse"))
            return $"/Customer/Home/Store?Filter.CategoryIds={catId}&SearchQuery=hub";
        if (name.Contains("storage") || name.Contains("ssd") || name.Contains("flash"))
            return $"/Customer/Home/Store?Filter.CategoryIds={catId}&SearchQuery=storage";
        if (name.Contains("network") || name.Contains("router"))
            return $"/Customer/Home/Store?Filter.CategoryIds={catId}&SearchQuery=network";

        return $"/Customer/Home/Store?Filter.CategoryIds={catId}";
    }

    string GetCategoryImageUrl(Category cat)
    {
        if (!string.IsNullOrEmpty(cat.ImageUrl))
            return cat.ImageUrl;
            
        var name = cat.Name.ToLower();
        if (name.Contains("phone") || name.Contains("mobile"))
            return "/img/iphone15.png";
        if (name.Contains("laptop") || name.Contains("notebook"))
            return "https://images.unsplash.com/photo-1496181133206-80ce9b88a853?w=150&h=150&fit=crop&q=80";
        if (name.Contains("playstation") || name.Contains("gaming"))
            return "https://images.unsplash.com/photo-1606813907291-d86efa9b94db?w=150&h=150&fit=crop&q=80";
        if (name.Contains("tv") || name.Contains("television"))
            return "https://images.unsplash.com/photo-1593305841991-05c297ba4575?w=150&h=150&fit=crop&q=80";
        if (name.Contains("conditioner") || name.Contains("ac"))
            return "https://images.unsplash.com/photo-1585399000684-d2f72660f092?w=150&h=150&fit=crop&q=80";
        if (name.Contains("appliance"))
            return "/img/micro.png";
        if (name.Contains("audio") || name.Contains("sound") || name.Contains("speaker") || name.Contains("buds"))
            return "/img/buds.png";
        if (name.Contains("watch") || name.Contains("wearable"))
            return "/img/watch9.png";
        if (name.Contains("printer"))
            return "https://images.unsplash.com/photo-1612815154858-60aa4c59eaa6?w=150&h=150&fit=crop&q=80";
        if (name.Contains("monitor") || name.Contains("screen"))
            return "/img/dell_mon.png";
        if (name.Contains("accessory") || name.Contains("keyboard") || name.Contains("mouse"))
            return "https://images.unsplash.com/photo-1587829741301-dc798b83add3?w=150&h=150&fit=crop&q=80";
        if (name.Contains("storage") || name.Contains("ssd") || name.Contains("flash"))
            return "https://images.unsplash.com/photo-1618424181497-157f25b6ddd5?w=150&h=150&fit=crop&q=80";
        if (name.Contains("network") || name.Contains("router"))
            return "https://images.unsplash.com/photo-1544244015-0df4b3ffc6b0?w=150&h=150&fit=crop&q=80";

        return "https://images.unsplash.com/photo-1526738549149-8e07eca6c147?w=150&h=150&fit=crop&q=80";
    }
}


<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name" dir="@(System.Globalization.CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'btech-orange': '#2563eb',
                        'btech-orange-dark': '#1d4ed8',
                        'btech-orange-light': '#eff6ff',
                        'btech-black': '#111111',
                        'btech-gray': '#f4f4f5',
                        'whatsapp': '#25D366',
                    },
                    fontFamily: {
                        sans: ['Cairo', 'Inter', 'Segoe UI', 'Roboto', 'sans-serif'],
                    },
                    maxWidth: {
                        '8xl': '1440px',
                    },
                },
            },
        };
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/store.css" asp-append-version="true" />
    <style>
        * { box-sizing: border-box; }
        body { font-family: 'Cairo', 'Inter', 'Segoe UI', 'Roboto', sans-serif; background: #ffffff; scroll-behavior: smooth; }
        .promo-card { transition: transform 0.3s ease, box-shadow 0.3s ease; }
        .promo-card:hover { transform: translateY(-4px); box-shadow: 0 12px 24px rgba(0,0,0,0.08); }
        .product-card { transition: transform 0.25s ease, box-shadow 0.25s ease; }
        .product-card:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(0,0,0,0.06); }
        .scroll-top { transition: opacity 0.3s ease, transform 0.3s ease; }
        .scroll-top.show { opacity: 1; pointer-events: auto; transform: translateY(0); }
        .scroll-top { opacity: 0; pointer-events: none; transform: translateY(20px); }
        .carousel-arrow { transition: opacity 0.2s ease, background 0.2s ease; }
        .carousel-arrow:hover { background: rgba(0,0,0,0.05); }
        .category-item { transition: transform 0.2s ease; cursor: pointer; }
        .category-item:hover { transform: translateY(-4px); }
        .hide-scrollbar::-webkit-scrollbar { display: none; }
        .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        
        /* Highlight active offers filter tab */
        .offers-tab.active {
            background-color: #2563eb;
            color: #ffffff;
            border-color: #2563eb;
        }

        /* BTech Category Slider Styles */
        .category-item-circle {
            width: 68px;
            height: 46px;
            border-radius: 10px;
            background-color: #f4f5f7;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            box-shadow: 0 2px 6px rgba(0,0,0,0.01);
            border: 1px solid #e2e8f0;
            overflow: visible; /* Allows image to pop out of bounds */
            margin-top: 24px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        @@media (min-width: 640px) {
            .category-item-circle {
                width: 84px;
                height: 56px;
                border-radius: 12px;
                margin-top: 28px;
            }
        }
        @@media (min-width: 768px) {
            .category-item-circle {
                width: 94px;
                height: 64px;
                border-radius: 14px;
                margin-top: 32px;
            }
        }
        .category-item-btech {
            margin-top: 8px;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-decoration: none;
        }
        .category-item-btech img {
            width: 64px;
            height: 64px;
            object-fit: contain;
            position: absolute;
            top: -22px; /* Pops out of the card by half of its size */
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            filter: drop-shadow(0 6px 10px rgba(0,0,0,0.1)); /* Beautiful realistic shadow */
        }
        @@media (min-width: 640px) {
            .category-item-btech img {
                width: 80px;
                height: 80px;
                top: -28px;
            }
        }
        @@media (min-width: 768px) {
            .category-item-btech img {
                width: 90px;
                height: 90px;
                top: -30px;
            }
        }
        .category-item-btech:hover .category-item-circle {
            background-color: #ffffff;
            border-color: #2563eb;
            box-shadow: 0 12px 24px rgba(37, 99, 235, 0.15);
            transform: translateY(2px);
        }
        .category-item-btech:hover img {
            transform: translateY(-8px) scale(1.08); /* Lifts image up while card moves down on hover */
            filter: drop-shadow(0 16px 20px rgba(37, 99, 235, 0.25));
        }
        .cat-scroll-track {
            height: 3px;
            background-color: #e4e4e7;
            border-radius: 9999px;
            width: 80px;
            position: relative;
            overflow: hidden;
        }
        .cat-scroll-thumb {
            position: absolute;
            top: 0;
            bottom: 0;
            background-color: #111111;
            border-radius: 9999px;
            transition: left 0.1s ease, right 0.1s ease, width 0.1s ease;
        }
    </style>
    <!-- Boxicons -->
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    <!-- Chatbot CSS -->
    <link rel="stylesheet" href="~/css/chatbot.css" asp-append-version="true" />
</head>
<body class="bg-gray-50 pb-20 md:pb-0">

    <!-- â•گâ•گâ•گ MAIN HEADER & SEARCH â•گâ•گâ•گ -->
    @await Html.PartialAsync("_BTechHeader")

    <!-- â•گâ•گâ•گ HERO BANNER SLIDER (Full-Width - Outside main) â•گâ•گâ•گ -->
    <section class="relative overflow-hidden bg-gray-900 group" style="width:100%;">
        
        <!-- Carousel Container -->
        <div id="heroCarousel" class="relative w-full h-[220px] sm:h-[360px] md:h-[440px] overflow-hidden">
            
            <!-- Slide 1 -->
            <a href="@banners.Slide1LinkUrl" class="carousel-slide absolute inset-0 opacity-100 transition-all duration-700 ease-in-out block border-0 cursor-pointer" data-index="0">
                <img src="@banners.Slide1ImageUrl" class="w-full h-full object-cover object-center" alt="Slide 1" />
            </a>

            <!-- Slide 2 -->
            <a href="@banners.Slide2LinkUrl" class="carousel-slide absolute inset-0 opacity-0 transition-all duration-700 ease-in-out block border-0 cursor-pointer" data-index="1">
                <img src="@banners.Slide2ImageUrl" class="w-full h-full object-cover object-center" alt="Slide 2" />
            </a>

            <!-- Slide 3 -->
            <a href="@banners.Slide3LinkUrl" class="carousel-slide absolute inset-0 opacity-0 transition-all duration-700 ease-in-out block border-0 cursor-pointer" data-index="2">
                <img src="@banners.Slide3ImageUrl" class="w-full h-full object-cover object-center" alt="Slide 3" />
            </a>

            <!-- Slide 4 -->
            <a href="@banners.Slide4LinkUrl" class="carousel-slide absolute inset-0 opacity-0 transition-all duration-700 ease-in-out block border-0 cursor-pointer" data-index="3">
                <img src="@banners.Slide4ImageUrl" class="w-full h-full object-cover object-center" alt="Slide 4" />
            </a>

            <!-- Slide 5 -->
            <a href="@banners.Slide5LinkUrl" class="carousel-slide absolute inset-0 opacity-0 transition-all duration-700 ease-in-out block border-0 cursor-pointer" data-index="4">
                <img src="@banners.Slide5ImageUrl" class="w-full h-full object-cover object-center" alt="Slide 5" />
            </a>

        </div>

        <!-- Carousel Controls -->
        <button type="button" id="prevSlide" class="absolute right-4 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-black/30 hover:bg-black/60 text-white flex items-center justify-center transition-all opacity-0 group-hover:opacity-100 border-0 cursor-pointer z-20">
            <i class="fas fa-chevron-right"></i>
        </button>
        <button type="button" id="nextSlide" class="absolute left-4 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-black/30 hover:bg-black/60 text-white flex items-center justify-center transition-all opacity-0 group-hover:opacity-100 border-0 cursor-pointer z-20">
            <i class="fas fa-chevron-left"></i>
        </button>

        <!-- Slide Indicators (5 dots) -->
        <div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex items-center gap-2 z-20">
            <button type="button" class="carousel-indicator w-8 h-1.5 rounded-full bg-white transition-all duration-300 cursor-pointer border-0" data-slide="0"></button>
            <button type="button" class="carousel-indicator w-4 h-1.5 rounded-full bg-white/40 transition-all duration-300 cursor-pointer border-0" data-slide="1"></button>
            <button type="button" class="carousel-indicator w-4 h-1.5 rounded-full bg-white/40 transition-all duration-300 cursor-pointer border-0" data-slide="2"></button>
            <button type="button" class="carousel-indicator w-4 h-1.5 rounded-full bg-white/40 transition-all duration-300 cursor-pointer border-0" data-slide="3"></button>
            <button type="button" class="carousel-indicator w-4 h-1.5 rounded-full bg-white/40 transition-all duration-300 cursor-pointer border-0" data-slide="4"></button>
        </div>

    </section>

    <main class="max-w-8xl mx-auto px-4 py-4 space-y-8">
        
        <!-- â•گâ•گâ•گ B.TECH STYLE CATEGORIES SLIDER â•گâ•گâ•گ -->
        <section class="bg-white py-8 px-4 sm:px-6 rounded-2xl border border-gray-100 shadow-sm relative overflow-hidden select-none">
            <!-- Slider Track -->
