@model StoreViewModel
@{
    bool isArabic = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar", StringComparison.OrdinalIgnoreCase);
    var products = Model.Products;
    var pagination = Model.Pagination;
    var filter = Model.Filter;
    var categories = Model.Categories;
    var brands = Model.Brands;
}

<div id="productGrid" class="space-y-6">
    <!-- Sort Bar (styled in modern Tailwind card) -->
    <div class="flex items-center justify-between bg-white border border-gray-100 rounded-2xl px-4 py-3.5 shadow-sm mb-6 flex-wrap gap-4">
        <span class="text-xs text-gray-500 font-bold">
            @Localizer["Showing"] <strong class="text-gray-900 font-extrabold">@products.Count()</strong> @Localizer["Of"] <strong class="text-gray-900 font-extrabold">@pagination.TotalCount</strong> @Localizer["Results"]
        </span>
        <div class="flex items-center gap-2 @(isArabic ? "mr-auto" : "ml-auto")">
            <button class="lg:hidden bg-white hover:bg-gray-50 text-gray-700 font-bold text-xs px-3.5 py-2 rounded-xl border border-gray-200 transition-all cursor-pointer flex items-center gap-1.5 shadow-sm" id="filterToggleBtn">
                <i class="fas fa-filter text-[10px] text-[#002d72]"></i> 
                <span>@Localizer["Filters"]</span>
            </button>
            <select id="sortSelect" class="px-3.5 py-2 text-xs border border-gray-200 rounded-xl focus:border-[#002d72] focus:outline-none bg-white font-bold cursor-pointer text-gray-700 shadow-sm">
                <!option value="popular" @(filter.SortBy == "popular" ? "selected" : "")>@Localizer["MostPopular"]</!option>
                <!option value="price-low" @(filter.SortBy == "price-low" ? "selected" : "")>@Localizer["PriceLowHigh"]</!option>
                <!option value="price-high" @(filter.SortBy == "price-high" ? "selected" : "")>@Localizer["PriceHighLow"]</!option>
                <!option value="newest" @(filter.SortBy == "newest" ? "selected" : "")>@Localizer["Newest"]</!option>
                <!option value="rating" @(filter.SortBy == "rating" ? "selected" : "")>@Localizer["HighestRated"]</!option>
            </select>
        </div>
    </div>

    <!-- Active Filter Chips -->
    @if (filter.CategoryIds.Any() || filter.BrandIds.Any() || filter.MinPrice.HasValue || filter.MaxPrice.HasValue || filter.MinRating.HasValue || filter.InStockOnly == true || !string.IsNullOrWhiteSpace(Model.SearchQuery))
    {
        <div class="flex flex-wrap gap-2 mb-6">
            @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
            {
                <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-blue-50 text-[#002d72] hover:bg-red-50 hover:text-red-600 transition-colors rounded-full text-xs font-bold border border-blue-100/30 cursor-pointer" data-remove="search">
                    @Localizer["Search"]: "@Model.SearchQuery" 
                    <i class="fas fa-times text-[9px] opacity-75"></i>
                </span>
            }
            @foreach (var cid in filter.CategoryIds)
            {
                var cname = categories.FirstOrDefault(c => c.Id == cid)?.Name ?? $"Category {cid}";
                <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-blue-50 text-[#002d72] hover:bg-red-50 hover:text-red-600 transition-colors rounded-full text-xs font-bold border border-blue-100/30 cursor-pointer" data-remove="cat-@cid">
                    @cname 
                    <i class="fas fa-times text-[9px] opacity-75"></i>
                </span>
            }
            @foreach (var bid in filter.BrandIds)
            {
                var bname = brands.FirstOrDefault(b => b.Id == bid)?.Name ?? $"Brand {bid}";
                <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-blue-50 text-[#002d72] hover:bg-red-50 hover:text-red-600 transition-colors rounded-full text-xs font-bold border border-blue-100/30 cursor-pointer" data-remove="brand-@bid">
                    @bname 
                    <i class="fas fa-times text-[9px] opacity-75"></i>
                </span>
            }
            @if (filter.MinPrice.HasValue || filter.MaxPrice.HasValue)
            {
                <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-blue-50 text-[#002d72] hover:bg-red-50 hover:text-red-600 transition-colors rounded-full text-xs font-bold border border-blue-100/30 cursor-pointer" data-remove="price">
                    @(filter.MinPrice ?? 0)–@(filter.MaxPrice ?? 9999) 
                    <i class="fas fa-times text-[9px] opacity-75"></i>
                </span>
            }
            @if (filter.MinRating.HasValue)
            {
                <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-blue-50 text-[#002d72] hover:bg-red-50 hover:text-red-600 transition-colors rounded-full text-xs font-bold border border-blue-100/30 cursor-pointer" data-remove="rating">
                    @filter.MinRating★ @Localizer["AndUp"] 
                    <i class="fas fa-times text-[9px] opacity-75"></i>
                </span>
            }
            @if (filter.InStockOnly == true)
            {
                <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-blue-50 text-[#002d72] hover:bg-red-50 hover:text-red-600 transition-colors rounded-full text-xs font-bold border border-blue-100/30 cursor-pointer" data-remove="instock">
                    @Localizer["InStock"] 
                    <i class="fas fa-times text-[9px] opacity-75"></i>
                </span>
            }
        </div>
    }

    <!-- Products Grid (Modern Tailwind styling) -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
        @if (!products.Any())
        {
            <div class="col-span-full text-center py-20 bg-white rounded-3xl border border-gray-100 shadow-sm px-6">
                <div class="w-20 h-20 bg-gray-50 text-gray-400 rounded-full flex items-center justify-center mx-auto mb-4">
                    <i class="fas fa-search text-3xl"></i>
                </div>
                <h4 class="text-base font-extrabold text-gray-900 mb-1">@Localizer["NoProductsFound"]</h4>
                <p class="text-xs text-gray-500">@Localizer["TryAdjustingFilters"]</p>
            </div>
        }
        else
        {
            @foreach (var item in products)
            {
                <div class="bg-white rounded-2xl border border-gray-100/80 shadow-sm overflow-hidden hover:shadow-md transition-shadow duration-300">
                    @await Html.PartialAsync("_ProductCard", item)
                </div>
            }
        }
    </div>

    <!-- Pagination -->
    @if (pagination.TotalPages > 1)
    {
        <div class="flex items-center justify-center gap-2 mt-8 pt-4">
            @if (pagination.HasPrevious)
            {
                <a href="#" data-page="@(pagination.Page - 1)" class="w-8 h-8 rounded-lg bg-white border border-gray-200 hover:border-[#002d72] text-gray-600 hover:text-[#002d72] transition-colors flex items-center justify-center decoration-none"><i class="fas fa-chevron-left text-xs"></i></a>
            }
            else
            {
                <span class="w-8 h-8 rounded-lg bg-gray-50 border border-gray-100 text-gray-300 flex items-center justify-center cursor-not-allowed"><i class="fas fa-chevron-left text-xs"></i></span>
            }

            @for (int p = 1; p <= pagination.TotalPages; p++)
            {
                if (p == pagination.Page)
                {
                    <span class="w-8 h-8 rounded-lg bg-[#002d72] text-white flex items-center justify-center text-xs font-bold shadow-sm">@p</span>
                }
                else
                {
                    <a href="#" data-page="@p" class="w-8 h-8 rounded-lg bg-white border border-gray-200 hover:border-[#002d72] text-gray-600 hover:text-[#002d72] transition-colors flex items-center justify-center text-xs font-bold decoration-none">@p</a>
                }
            }

            @if (pagination.HasNext)
            {
                <a href="#" data-page="@(pagination.Page + 1)" class="w-8 h-8 rounded-lg bg-white border border-gray-200 hover:border-[#002d72] text-gray-600 hover:text-[#002d72] transition-colors flex items-center justify-center decoration-none"><i class="fas fa-chevron-right text-xs"></i></a>
            }
            else
            {
                <span class="w-8 h-8 rounded-lg bg-gray-50 border border-gray-100 text-gray-300 flex items-center justify-center cursor-not-allowed"><i class="fas fa-chevron-right text-xs"></i></span>
            }
        </div>
    }
</div>
