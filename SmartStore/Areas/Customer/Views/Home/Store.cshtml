@model SmartStore.ViewModel.Store.StoreViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Store";
}

<link rel="stylesheet" href="~/css/store.css" asp-append-version="true" />

@{
    ViewData["HideSubNav"] = true;
}
@await Html.PartialAsync("_BTechHeader")

<div class="container">
   

    <!-- ─── Main Catalog ─── -->
    <div style="margin-top:40px;">
        <div class="section-header">
            <h2>All Products</h2>
        </div>

        <div class="row">
            <!-- Filter Sidebar -->
            <div class="col-md-3">
                <div class="filter-overlay" id="filterOverlay"></div>
                <div class="filter-sidebar" id="filterSidebar">
                    <div class="mobile-filter-close" style="display:none;">
                        <strong>Filters</strong>
                        <button type="button" style="border:none;background:none;font-size:20px;" id="filterCloseBtn"><i class="fa fa-times"></i></button>
                    </div>

                    <form id="filterForm" method="get" action="/Customer/Home/Store">
                        <input type="hidden" name="Pagination.Page" id="pageInput" value="@Model.Pagination.Page" />
                        <input type="hidden" name="SortBy" id="sortInput" value="@Model.Filter.SortBy" />

                        <!-- Category -->
                        <div class="filter-group">
                            <div class="filter-group-title">Category <i class="fa fa-chevron-down"></i></div>
                            <div class="filter-options">
                                @foreach (var cat in Model.Categories)
                                {
                                    var checkedAttr = Model.Filter.CategoryIds.Contains(cat.Id) ? "checked" : "";
                                    <label class="filter-checkbox">
                                        <input type="checkbox" name="Filter.CategoryIds" value="@cat.Id" @checkedAttr>
                                        @cat.Name
                                        <span class="count">(@Model.BestSellers.Count(p => p.CategoryId == cat.Id))</span>
                                    </label>
                                }
                            </div>
                        </div>

                        <!-- Brand -->
                        <div class="filter-group">
                            <div class="filter-group-title">Brand <i class="fa fa-chevron-down"></i></div>
                            <div class="filter-options">
                                @foreach (var brand in Model.Brands)
                                {
                                    var checkedAttr = Model.Filter.BrandIds.Contains(brand.Id) ? "checked" : "";
                                    <label class="filter-checkbox">
                                        <input type="checkbox" name="Filter.BrandIds" value="@brand.Id" @checkedAttr>
                                        @brand.Name
                                    </label>
                                }
                            </div>
                        </div>

                        <!-- Price -->
                        <div class="filter-group">
                            <div class="filter-group-title">Price Range <i class="fa fa-chevron-down"></i></div>
                            <div class="filter-options">
                                <div class="price-range-inputs">
                                    <input type="number" name="Filter.MinPrice" placeholder="Min" value="@Model.Filter.MinPrice" min="0">
                                    <span>—</span>
                                    <input type="number" name="Filter.MaxPrice" placeholder="Max" value="@Model.Filter.MaxPrice" min="0">
                                </div>
                            </div>
                        </div>

                        <!-- Rating -->
                        <div class="filter-group">
                            <div class="filter-group-title">Rating <i class="fa fa-chevron-down"></i></div>
                            <div class="filter-options">
                                @for (int r = 4; r >= 1; r--)
                                {
                                    var checkedAttr = Model.Filter.MinRating == r ? "checked" : "";
                                    <label class="rating-filter">
                                        <input type="radio" name="Filter.MinRating" value="@r" @checkedAttr style="display:none;">
                                        <span class="stars">
                                            @for (int s = 0; s < 5; s++)
                                            {
                                                if (s < r)
                                                {
                                                    <text>★</text>
                                                }
                                                else
                                                {
                                                    <span class="empty">★</span>
                                                }
                                            }
                                        </span>
                                        &amp; up
                                    </label>
                                }
                            </div>
                        </div>

                        <!-- In Stock -->
                        <div class="filter-group">
                            <label class="filter-checkbox">
                                <input type="checkbox" name="Filter.InStockOnly" value="true" @(Model.Filter.InStockOnly == true ? "checked" : "")>
                                In Stock Only
                            </label>
                        </div>

                        <div class="filter-actions">
                            <button type="submit" class="btn-apply">Apply</button>
                            <button type="button" class="btn-reset" id="resetFilters">Reset</button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Product Grid -->
            @await Html.PartialAsync("_ProductGrid", Model)
        </div>
    </div>
</div>

<!-- ─── Footer ─── -->
<footer class="store-footer">
    <div class="container">
        <div class="row">
            <div class="col-md-3 col-6">
                <h5>About Us</h5>
                <p style="font-size:13px;line-height:1.7;">Your destination for premium electronics at unbeatable prices. Fast shipping, easy returns.</p>
            </div>
            <div class="col-md-3 col-6">
                <h5>Categories</h5>
                <a href="#">Laptops</a>
                <a href="#">Smartphones</a>
                <a href="#">Cameras</a>
                <a href="#">Accessories</a>
            </div>
            <div class="col-md-3 col-6">
                <h5>Customer Service</h5>
                <a href="#">Contact Us</a>
                <a href="#">Shipping & Returns</a>
                <a href="#">FAQ</a>
                <a href="#">Warranty</a>
            </div>
            <div class="col-md-3 col-6">
                <h5>My Account</h5>
                <a href="#">My Orders</a>
                <a href="/Customer/Wishlist/Index">My Wishlist</a>
                <a href="#">My Cart</a>
                <a href="#">Account Settings</a>
            </div>
        </div>
        <div class="footer-bottom">
            <span>&copy; @DateTime.Now.Year SmartStore. All rights reserved.</span>
            <span>
                <i class="fa fa-cc-visa" style="font-size:24px;margin-left:8px;"></i>
                <i class="fa fa-cc-mastercard" style="font-size:24px;margin-left:8px;"></i>
                <i class="fa fa-cc-paypal" style="font-size:24px;margin-left:8px;"></i>
            </span>
        </div>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script>
    window.isAuthenticated = @(User.Identity?.IsAuthenticated.ToString().ToLower() ?? "false");
</script>
<script src="~/js/store.js" asp-append-version="true"></script>
