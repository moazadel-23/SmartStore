@model SmartStore.Models.Category
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = Localizer["UpdateCategory"];
    ViewData["PageTitle"] = Localizer["CategoryManagement"];
}

<link rel="stylesheet" href="~/css/category-admin.css">

<div class="home-content">

    <!-- ── Breadcrumb ─────────────────────────── -->
    <div class="breadcrumb-bar">
        <span class="bc-home"><i class='bx bxs-home-alt-2'></i> @Localizer["Home"]</span>
        <i class='bx bx-chevron-right bc-sep'></i>
        <a asp-action="Index" class="bc-link">@Localizer["Categories"]</a>
        <i class='bx bx-chevron-right bc-sep'></i>
        <span class="bc-current">@Localizer["UpdateCategory"]</span>
        <span class="bc-date">
            <i class='bx bx-calendar'></i>
            @DateTime.Now.ToString("dddd, MMMM dd yyyy")
        </span>
    </div>

    <!-- ── Page Title Row ─────────────────────── -->
    <div class="create-page-header">
        <div class="create-page-title">
            <div class="create-icon-wrap">
                <i class='bx bx-edit-alt'></i>
            </div>
            <div>
                <h2>@Localizer["UpdateCategory"]</h2>
                <p>@Localizer["UpdateCategory"]</p>
            </div>
        </div>
    </div>

    <!-- ── Form ───────────────────────────────── -->
    <form asp-action="Update" asp-controller="Category" asp-area="Admin"
          method="post" id="createCategoryForm" enctype="multipart/form-data" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ImageUrl" />

        <div class="create-layout">

            <!-- LEFT: Main Details ────────────── -->
            <div class="create-main">

                <!-- Category Details Card -->
                <div class="create-card">
                    <div class="create-card-header">
                        <i class='bx bx-info-circle'></i>
                        <span>@Localizer["CategoryDetails"]</span>
                    </div>
                    <div class="create-card-body">

                        <!-- Name -->
                        <div class="form-field" id="field-name">
                            <label asp-for="Name" class="field-label">
                                @Localizer["CategoryName"]
                                <span class="field-required">*</span>
                            </label>
                            <div class="field-input-wrap">
                                <i class='bx bx-purchase-tag field-icon'></i>
                                <input asp-for="Name"
                                       class="field-input"
                                       placeholder="e.g. Smartphones, Laptops…"
                                       autocomplete="off"
                                       id="nameInput">
                            </div>
                            <span asp-validation-for="Name" class="field-error"></span>
                            <div class="field-hint">@Localizer["UseClearConciseName"]</div>
                        </div>

                        <!-- Description -->
                        <div class="form-field" id="field-desc">
                            <label asp-for="Description" class="field-label">
                                @Localizer["Description"]
                                <span class="field-optional">@Localizer["Optional"]</span>
                            </label>
                            <div class="field-textarea-wrap">
                                <textarea asp-for="Description"
                                          class="field-textarea"
                                          placeholder="@Localizer["DescribeProductsBelong"]"
                                          rows="5"
                                          id="descInput"></textarea>
                            </div>
                            <div class="field-footer">
                                <span asp-validation-for="Description" class="field-error"></span>
                                <span class="char-count"><span id="charCount">0</span> / 500</span>
                            </div>
                        </div>

                        <!-- Image Upload -->
                        <div class="form-field" id="field-image">
                            <label class="field-label">
                                @Localizer["CategoryImage"]
                                <span class="field-optional">@Localizer["Optional"]</span>
                            </label>
                            <div class="field-input-wrap">
                                <i class='bx bx-image field-icon'></i>
                                <input type="file" name="ImageFile" id="imageInput" class="field-input" accept="image/*" style="padding-top: 10px;">
                            </div>
                            <div class="field-hint">@Localizer["UploadNewImageToReplaceCategorySlider"]</div>
                        </div>

                    </div>
                </div>

                <!-- Preview Card -->
                <div class="create-card preview-card">
                    <div class="create-card-header">
                        <i class='bx bx-show-alt'></i>
                        <span>@Localizer["LivePreview"]</span>
                    </div>
                    <div class="create-card-body">
                        <div class="preview-row">
                            <div class="preview-avatar" id="previewAvatar">
                                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                {
                                    <img src="@Model.ImageUrl" style="width: 100%; height: 100%; object-fit: contain; border-radius: 50%;" id="existingPreviewImg" />
                                }
                                else
                                {
                                    <text>?</text>
                                }
                            </div>
                            <div class="preview-meta">
                                <div class="preview-name" id="previewName">@Localizer["CategoryName"]</div>
                                <div class="preview-desc" id="previewDesc">@Localizer["Description"]…</div>
                            </div>
                            <span class="preview-badge" id="previewBadge">
                                <i class='bx bxs-circle'></i> @Localizer["Active"]
                            </span>
                        </div>
                    </div>
                </div>

            </div>

            <!-- RIGHT: Publish Panel ──────────── -->
            <div class="create-sidebar">

                <!-- Publish Card -->
                <div class="create-card">
                    <div class="create-card-header">
                        <i class='bx bx-send'></i>
                        <span>@Localizer["SaveChange"]</span>
                    </div>
                    <div class="create-card-body">

                        <!-- Status Toggle -->
                        <div class="form-field">
                            <label class="field-label">@Localizer["Status"]</label>
                            <div class="status-toggle-group" id="statusToggle">
                                <label class="status-option status-active-opt selected" id="statusActiveLabel">
                                    <input type="radio" asp-for="Status" value="true"
                                           name="Status" id="statusActive" checked>
                                    <i class='bx bx-check-circle'></i>
                                    <div>
                                        <span class="st-title">@Localizer["Active"]</span>
                                        <span class="st-desc">@Localizer["VisibleToCustomers"]</span>
                                    </div>
                                </label>
                                <label class="status-option status-inactive-opt" id="statusInactiveLabel">
                                    <input type="radio" asp-for="Status" value="false"
                                           name="Status" id="statusInactive">
                                    <i class='bx bx-x-circle'></i>
                                    <div>
                                        <span class="st-title">@Localizer["Inactive"]</span>
                                        <span class="st-desc">@Localizer["HiddenFromStore"]</span>
                                    </div>
                                </label>
                            </div>
                        </div>

                        <div class="publish-divider"></div>

                        <!-- Info Row -->
                        <div class="publish-info">
                            <div class="pub-info-row">
                                <i class='bx bx-user'></i>
                                <span>@Localizer["CreatedBy"] <strong>Admin</strong></span>
                            </div>
                            <div class="pub-info-row">
                                <i class='bx bx-calendar'></i>
                                <span>@DateTime.Now.ToString("MMM dd, yyyy")</span>
                            </div>
                        </div>

                        <div class="publish-divider"></div>

                        <!-- Actions -->
                        <div class="publish-actions">
                                <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="pub-cancel-btn">
                                    <i class='bx bx-x'></i> @Localizer["Cancel"]
                                </a>
                            <button type="submit" class="pub-submit-btn" id="submitBtn">
                                <i class='bx bx-check'></i>
                                <span>@Localizer["SaveChange"]</span>
                                <div class="btn-loader" id="btnLoader"></div>
                            </button>
                        </div>

                    </div>
                </div>

                <!-- Tips Card -->
                <div class="create-card tips-card">
                    <div class="create-card-header">
                        <i class='bx bx-bulb'></i>
                        <span>@Localizer["Tips"]</span>
                    </div>
                    <div class="create-card-body">
                        <ul class="tips-list">
                            <li><i class='bx bx-check'></i> @Localizer["EnsureChangesAccurateTip"]</li>
                            <li><i class='bx bx-check'></i> @Localizer["ModifyingCategoryAffectsTip"]</li>
                            <li><i class='bx bx-check'></i> @Localizer["StatusChangesApplyTip"]</li>
                        </ul>
                    </div>
                </div>

            </div>
        </div>
    </form>
</div>

@section Scripts {
<script>
(function () {
    /* ── Live Preview ──────────────────────────── */
    const nameInput   = document.getElementById('nameInput');
    const descInput   = document.getElementById('descInput');
    const imageInput  = document.getElementById('imageInput');
    const previewName = document.getElementById('previewName');
    const previewDesc = document.getElementById('previewDesc');
    const previewAv   = document.getElementById('previewAvatar');
    const charCount   = document.getElementById('charCount');

    const avatarColors = ['#4F46E5','#10B981','#F59E0B','#EF4444','#8B5CF6','#06B6D4','#EC4899'];

    function updatePreview() {
        const name = nameInput?.value.trim() || '';
        const desc = descInput?.value.trim() || '';

        if (previewName) previewName.textContent = name || '@Localizer["CategoryName"]';
        if (previewDesc) previewDesc.textContent = desc || '@Localizer["Description"]…';

        const file = imageInput?.files?.[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                if (previewAv) {
                    previewAv.innerHTML = `<img src="${e.target.result}" style="width: 100%; height: 100%; object-fit: contain; border-radius: 50%;" />`;
                    previewAv.style.background = 'none';
                }
            }
            reader.readAsDataURL(file);
        } else {
            const existingImg = document.getElementById('existingPreviewImg');
            if (existingImg) {
                // If there's an existing image preview, keep it.
            } else if (previewAv && name) {
                const initial = name.charAt(0).toUpperCase();
                const color   = avatarColors[name.charCodeAt(0) % avatarColors.length];
                previewAv.textContent = initial;
                previewAv.style.background = color + '22';
                previewAv.style.color      = color;
            } else if (previewAv) {
                previewAv.textContent = '?';
                previewAv.style.background = '';
                previewAv.style.color = '';
            }
        }
    }

    nameInput?.addEventListener('input', updatePreview);
    imageInput?.addEventListener('change', () => {
        // Remove existing preview image element if a new file is chosen
        const existingImg = document.getElementById('existingPreviewImg');
        if (existingImg) existingImg.remove();
        updatePreview();
    });
    descInput?.addEventListener('input', function () {
        if (charCount) charCount.textContent = this.value.length;
        updatePreview();
    });

    // Run preview once on load for existing data
    if (nameInput || descInput) {
        if (charCount && descInput) {
            charCount.textContent = descInput.value.length;
        }
        updatePreview();
    }

    /* ── Status Toggle ─────────────────────────── */
    const previewBadge      = document.getElementById('previewBadge');
    const statusActive      = document.getElementById('statusActive');
    const statusInactive    = document.getElementById('statusInactive');
    const statusActiveLabel = document.getElementById('statusActiveLabel');
    const statusInactLabel  = document.getElementById('statusInactiveLabel');

    function syncStatus() {
        const isActive = statusActive?.checked;
        statusActiveLabel?.classList.toggle('selected', !!isActive);
        statusInactLabel?.classList.toggle('selected', !isActive);
        if (previewBadge) {
            previewBadge.className = 'preview-badge ' + (isActive ? 'badge-active' : 'badge-inactive');
            previewBadge.innerHTML = `<i class='bx bxs-circle'></i> ${isActive ? '@Localizer["Active"]' : '@Localizer["Inactive"]'}`;
        }
    }
    statusActive?.addEventListener('change', syncStatus);
    statusInactive?.addEventListener('change', syncStatus);

    // Initial sync for status
    syncStatus();

    /* ── Form Submission Feedback ──────────────── */
    const form      = document.getElementById('createCategoryForm');
    const submitBtn = document.getElementById('submitBtn');
    const btnLoader = document.getElementById('btnLoader');

    form?.addEventListener('submit', function () {
        if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.querySelector('span').textContent = '@Localizer["SaveChange"]…';
            if (btnLoader) btnLoader.style.display = 'block';
        }
    });

    /* ── Input focus styling ───────────────────── */
    document.querySelectorAll('.field-input, .field-textarea').forEach(el => {
        el.addEventListener('focus', () => el.closest('.form-field')?.classList.add('focused'));
        el.addEventListener('blur',  () => el.closest('.form-field')?.classList.remove('focused'));
    });

    /* ── Entrance animation ────────────────────── */
    document.querySelectorAll('.create-card').forEach((card, i) => {
        card.style.opacity   = '0';
        card.style.transform = 'translateY(16px)';
        setTimeout(() => {
            card.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
            card.style.opacity    = '1';
            card.style.transform  = 'translateY(0)';
        }, 80 + i * 80);
    });
})();
</script>
}
