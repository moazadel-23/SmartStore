@model IEnumerable<SmartStore.Models.Promotion>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = Localizer["Promotions"];
    ViewData["PageTitle"] = Localizer["PromotionManagement"];

    var totalPromotions    = Model?.Count() ?? 0;
    var activePromotions   = Model?.Count(c => c.IsValid && c.ValidTo > DateTime.Now) ?? 0;
    var inactivePromotions = totalPromotions - activePromotions;
}

<link rel="stylesheet" href="~/css/category-admin.css">

<div class="home-content">

    <!-- ── Breadcrumb ─────────────────────────── -->
    <div class="breadcrumb-bar">
        <span class="bc-home"><i class='bx bxs-home-alt-2'></i> @Localizer["Home"]</span>
        <i class='bx bx-chevron-right bc-sep'></i>
        <span class="bc-current">@Localizer["Promotions"]</span>
        <span class="bc-date"><i class='bx bx-calendar'></i> @DateTime.Now.ToString("dddd, MMMM dd yyyy")</span>
    </div>

    <!-- ── KPI Strip ──────────────────────────── -->
    <div class="cat-kpi-strip">
        <div class="cat-kpi-item">
            <div class="cat-kpi-icon ck-blue"><i class='bx bxs-offer'></i></div>
            <div>
                <div class="cat-kpi-val">@totalPromotions</div>
                <div class="cat-kpi-label">@Localizer["TotalPromotions"]</div>
            </div>
        </div>
        <div class="cat-kpi-divider"></div>
        <div class="cat-kpi-item">
            <div class="cat-kpi-icon ck-green"><i class='bx bx-check-circle'></i></div>
            <div>
                <div class="cat-kpi-val">@activePromotions</div>
                <div class="cat-kpi-label">@Localizer["Active"]</div>
            </div>
        </div>
        <div class="cat-kpi-divider"></div>
        <div class="cat-kpi-item">
            <div class="cat-kpi-icon ck-red"><i class='bx bx-x-circle'></i></div>
            <div>
                <div class="cat-kpi-val">@inactivePromotions</div>
                <div class="cat-kpi-label">@Localizer["ExpiredOrInactive"]</div>
            </div>
        </div>
        <div class="cat-kpi-divider"></div>
        <div class="cat-kpi-item">
            <div class="cat-kpi-icon ck-purple"><i class='bx bx-trending-up'></i></div>
            <div>
                <div class="cat-kpi-val">@(totalPromotions > 0 ? Math.Round((double)activePromotions / totalPromotions * 100, 0) : 0)%</div>
                <div class="cat-kpi-label">@Localizer["ActiveRate"]</div>
            </div>
        </div>
    </div>

    <!-- ── Table Card ─────────────────────────── -->
    <div class="cat-card">

        <!-- Card Header -->
        <div class="cat-card-header">
            <div class="cat-card-title">
                <i class='bx bx-list-ul'></i>
                <div>
                    <h3>@Localizer["AllPromotions"]</h3>
                    <p>@Localizer["ManagePromotions"]</p>
                </div>
            </div>
            <div class="cat-card-actions">
                <!-- Search -->
                <div class="cat-search-wrap">
                    <i class='bx bx-search'></i>
                    <input type="text" id="promoSearch" placeholder="@Localizer["SearchByCodeOrProduct"]">
                    <span class="cat-search-clear" id="clearSearch" title="@Localizer["Cancel"]"><i class='bx bx-x'></i></span>
                </div>
                <!-- Filter -->
                <div class="cat-filter-wrap">
                    <select id="statusFilter" class="cat-filter-select">
                        <option value="all">@Localizer["AllStatus"]</option>
                        <option value="active">@Localizer["ActiveOnly"]</option>
                        <option value="inactive">@Localizer["ExpiredOrInactiveOnly"]</option>
                    </select>
                    <i class='bx bx-chevron-down cat-filter-arrow'></i>
                </div>
                <!-- Add Button -->
                <a asp-area="Admin" asp-controller="Promotion" asp-action="Create" class="cat-add-btn" id="addPromoBtn">
                    <i class='bx bx-plus'></i>
                    <span>@Localizer["AddPromotion"]</span>
                </a>
            </div>
        </div>

        <!-- Table / Empty State -->
        @if (Model != null && Model.Any())
        {
            <!-- Result Counter -->
            <div class="cat-result-bar">
                <span id="resultCount">@Html.Raw(string.Format(Localizer["ShowingNPromotions"].Value, totalPromotions))</span>
            </div>

            <div class="cat-table-wrap">
                <table class="cat-table" id="promoTable">
                    <thead>
                        <tr>
                            <th class="th-check">
                                <input type="checkbox" id="selectAll" class="cat-checkbox">
                            </th>
                            <th class="sortable" data-col="1">
                                @Localizer["Code"] <i class='bx bx-sort'></i>
                            </th>
                            <th>@Localizer["TargetScope"]</th>
                            <th class="sortable" data-col="3">
                                @Localizer["Discount"] <i class='bx bx-sort'></i>
                            </th>
                            <th class="sortable" data-col="4">
                                @Localizer["Expiration"] <i class='bx bx-sort'></i>
                            </th>
                            <th class="sortable" data-col="5">
                                @Localizer["Status"] <i class='bx bx-sort'></i>
                            </th>
                            <th class="th-id sortable" data-col="0">
                                @Localizer["ID"] <i class='bx bx-sort'></i>
                            </th>
                            <th class="th-actions">@Localizer["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody id="promoTableBody">
                        @{
                            var colors = new[] { "#4F46E5","#10B981","#F59E0B","#EF4444","#8B5CF6","#06B6D4","#EC4899","#14B8A6" };
                            int idx = 0;
                        }
                        @foreach (var promotion in Model)
                        {
                            var color = colors[idx % colors.Length];
                            var initial = string.IsNullOrEmpty(promotion.Code) ? "?" : promotion.Code.Substring(0, 1).ToUpper();
                            idx++;
                            bool isPromoActive = promotion.IsValid && promotion.ValidTo > DateTime.Now;
                            <tr data-status="@(isPromoActive ? "active" : "inactive")" class="cat-row">
                                <td class="td-check">
                                    <input type="checkbox" class="cat-checkbox row-check">
                                </td>
                                <td>
                                    <div class="cat-name-cell">
                                        <div class="cat-avatar" style="background: @(color)20; color: @color;">
                                            @initial
                                        </div>
                                        <div class="cat-meta">
                                            <span class="cat-name" style="font-family: monospace; font-size: 1.1rem; letter-spacing: 0.5px;">@promotion.Code</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="cat-desc">
                                        @if (promotion.ProductId != null)
                                        {
                                            <span style="font-weight:600;"><i class='bx bx-shopping-bag'></i> @Localizer["Product"]:</span> @(promotion.Product?.Name ?? $"ID: {promotion.ProductId}")
                                        }
                                        else if (promotion.CategoryId != null)
                                        {
                                            <span style="font-weight:600;"><i class='bx bx-category'></i> @Localizer["Category"]:</span> @(promotion.Category?.Name ?? $"ID: {promotion.CategoryId}")
                                        }
                                        else if (promotion.BrandId != null)
                                        {
                                            <span style="font-weight:600;"><i class='bx bx-purchase-tag'></i> @Localizer["Brand"]:</span> @(promotion.Brand?.Name ?? $"ID: {promotion.BrandId}")
                                        }
                                        else
                                        {
                                            <span style="font-weight:600; color:var(--text-muted);"><i class='bx bx-globe'></i> @Localizer["GeneralAll"]</span>
                                        }
                                    </span>
                                </td>
                                <td>
                                    <span class="cat-badge" style="background: var(--blue-color-light, #eff6ff); color: var(--blue-color, #2563eb); font-weight: 600;">
                                        @promotion.Discount.ToString("G29")% @Localizer["Off"]
                                    </span>
                                </td>
                                <td>
                                    <span class="cat-desc" style="font-size: 0.85rem;">
                                        @promotion.ValidTo.ToString("yyyy-MM-dd HH:mm")
                                    </span>
                                </td>
                                <td>
                                    @if (isPromoActive)
                                    {
                                        <span class="cat-badge badge-active">
                                            <i class='bx bxs-circle'></i> @Localizer["Active"]
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="cat-badge badge-inactive">
                                            <i class='bx bxs-circle'></i> @Localizer["ExpiredOrInactive"]
                                        </span>
                                    }
                                </td>
                                <td>
                                    <span class="cat-id">#@promotion.Id</span>
                                </td>
                                <td>
                                    <div class="cat-action-group">
                                        <a asp-area="Admin" asp-controller="Promotion" asp-action="Update" asp-route-id="@promotion.Id"
                                           class="cat-btn cat-btn-edit" title="@Localizer["Edit"]">
                                            <i class='bx bx-edit-alt'></i>
                                        </a>
                                        <button type="button"
                                                class="cat-btn cat-btn-delete"
                                                title="@Localizer["Delete"]"
                                                data-id="@promotion.Id"
                                                data-name="@promotion.Code"
                                                onclick="openDeleteModal(this)">
                                            <i class='bx bx-trash'></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination placeholder -->
            <div class="cat-footer">
                <span class="cat-footer-info" id="footerSelected">0 @Localizer["Selected"]</span>
                <div class="cat-pagination">
                    <button class="pg-btn" disabled><i class='bx bx-chevron-left'></i></button>
                    <button class="pg-btn pg-active">1</button>
                    <button class="pg-btn" disabled><i class='bx bx-chevron-right'></i></button>
                </div>
            </div>
        }
        else
        {
            <div class="cat-empty">
                <div class="cat-empty-icon">
                    <i class='bx bxs-offer'></i>
                </div>
                <h3>@Localizer["NoPromotionsYet"]</h3>
                <p>@Localizer["GetStartedPromotion"]</p>
                <a asp-action="Create" class="cat-add-btn">
                    <i class='bx bx-plus'></i> @Localizer["CreateFirstPromotion"]
                </a>
            </div>
        }
    </div>
</div>

<!-- ── Delete Confirmation Modal ─────────────── -->
<div class="cat-modal-overlay" id="deleteModal">
    <div class="cat-modal">
        <div class="cat-modal-icon">
            <i class='bx bx-trash'></i>
        </div>
        <h3 class="cat-modal-title">@Localizer["DeletePromotionQuestion"]</h3>
        <p class="cat-modal-desc">
            @Localizer["AboutToDeletePromotion"] <strong id="deletePromoName">this promotion</strong>.
            @Localizer["ActionCannotBeUndone"]
        </p>
        <div class="cat-modal-actions">
            <button class="cat-modal-cancel" onclick="closeDeleteModal()">@Localizer["Cancel"]</button>
            <form id="deleteForm" method="post" asp-area="Admin" asp-controller="Promotion" asp-action="Delete">
                 <input type="hidden" name="id" id="deletePromoId" value="" />
                 <button type="submit" class="cat-modal-confirm" style="border:none; cursor:pointer; font-family: inherit; font-size: 1rem;">
                     <i class='bx bx-trash'></i> @Localizer["Delete"]
                 </button>
            </form>
        </div>
    </div>
</div>

<!-- ── Toast ──────────────────────────────────── -->
<div class="cat-toast" id="catToast"></div>

@section Scripts {
<script>
/* ── Delete Modal ──────────────────────────── */
function openDeleteModal(btn) {
    const id   = btn.dataset.id;
    const name = btn.dataset.name;
    document.getElementById('deletePromoName').textContent = name;
    document.getElementById('deletePromoId').value = id;
    document.getElementById('deleteModal').classList.add('show');
}
function closeDeleteModal() {
    document.getElementById('deleteModal').classList.remove('show');
}
document.getElementById('deleteModal')?.addEventListener('click', function(e) {
    if (e.target === this) closeDeleteModal();
});

/* ── Search + Filter ───────────────────────── */
const searchInput  = document.getElementById('promoSearch');
const clearBtn     = document.getElementById('clearSearch');
const statusFilter = document.getElementById('statusFilter');
const tableBody    = document.getElementById('promoTableBody');
const resultCount  = document.getElementById('resultCount');

function filterTable() {
    const term   = searchInput ? searchInput.value.toLowerCase() : '';
    const status = statusFilter ? statusFilter.value : 'all';
    let visible  = 0;

    tableBody?.querySelectorAll('tr.cat-row').forEach(row => {
        const name     = row.cells[1]?.textContent.toLowerCase() || '';
        const prod     = row.cells[2]?.textContent.toLowerCase() || '';
        const rowStat  = row.dataset.status || '';
        const matchSearch = name.includes(term) || prod.includes(term);
        const matchStatus = status === 'all' || rowStat === status;

        if (matchSearch && matchStatus) {
            row.style.display = '';
            visible++;
        } else {
            row.style.display = 'none';
        }
    });

    if (resultCount) {
        resultCount.innerHTML = '@Localizer["ShowingNPromotions"]'.replace('{0}', visible);
    }
}

searchInput?.addEventListener('input', () => {
    clearBtn.style.opacity = searchInput.value ? '1' : '0';
    filterTable();
});
clearBtn?.addEventListener('click', () => {
    searchInput.value = '';
    clearBtn.style.opacity = '0';
    filterTable();
    searchInput.focus();
});
statusFilter?.addEventListener('change', filterTable);

/* ── Select All ────────────────────────────── */
const selectAll   = document.getElementById('selectAll');
const footerSel   = document.getElementById('footerSelected');
function updateSelectedCount() {
    const count = tableBody?.querySelectorAll('.row-check:checked').length || 0;
    if (footerSel) footerSel.textContent = count + " " + '@Localizer["Selected"]';
}
selectAll?.addEventListener('change', function() {
    tableBody?.querySelectorAll('.row-check').forEach(cb => cb.checked = this.checked);
    updateSelectedCount();
});
tableBody?.addEventListener('change', e => {
    if (e.target.classList.contains('row-check')) updateSelectedCount();
});

/* ── Sortable columns ──────────────────────── */
document.querySelectorAll('th.sortable').forEach(th => {
    th.addEventListener('click', function() {
        const col = parseInt(this.dataset.col);
        const rows = Array.from(tableBody?.querySelectorAll('tr.cat-row') || []);
        const asc  = this.dataset.asc !== 'true';
        this.dataset.asc = asc;

        // Reset other headers
        document.querySelectorAll('th.sortable').forEach(h => {
            h.querySelector('i')?.classList.remove('bx-sort-up','bx-sort-down');
            h.querySelector('i')?.classList.add('bx-sort');
        });
        const icon = this.querySelector('i');
        if (icon) {
            icon.classList.remove('bx-sort');
            icon.classList.add(asc ? 'bx-sort-up' : 'bx-sort-down');
        }

        rows.sort((a, b) => {
            const at = a.cells[col]?.textContent.trim().replace('#','').replace('% Off','') || '';
            const bt = b.cells[col]?.textContent.trim().replace('#','').replace('% Off','') || '';
            const an = parseFloat(at); const bn = parseFloat(bt);
            if (!isNaN(an) && !isNaN(bn)) return asc ? an - bn : bn - an;
            return asc ? at.localeCompare(bt) : bt.localeCompare(at);
        });
        rows.forEach(r => tableBody.appendChild(r));
    });
});

/* ── Row entrance animation ────────────────── */
document.querySelectorAll('.cat-row').forEach((row, i) => {
    row.style.opacity = '0';
    row.style.transform = 'translateY(10px)';
    setTimeout(() => {
        row.style.transition = 'opacity 0.35s ease, transform 0.35s ease';
        row.style.opacity    = '1';
        row.style.transform  = 'translateY(0)';
    }, 60 + i * 45);
});

/* ── Toast Notification ────────────────────── */
function showToast(message, duration = 3000) {
    const toast = document.getElementById('catToast');
    if (!toast) return;
    toast.textContent = message;
    toast.classList.add('show');
    setTimeout(() => toast.classList.remove('show'), duration);
}

@if (TempData["SuccessMessage"] != null)
{
    <text>
    showToast("@Html.Raw(TempData["SuccessMessage"])");
    </text>
}
</script>
}
