@model SmartStore.Models.Order
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = Localizer["OrderDetails"];
    ViewData["PageTitle"] = Localizer["Order"].Value + " #" + Model.Id;
    bool isArabic = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar", StringComparison.OrdinalIgnoreCase);
}

<link rel="stylesheet" href="~/css/order-admin.css">

<div class="home-content">
    <div class="breadcrumb-bar">
        <span class="bc-home"><i class='bx bxs-home-alt-2'></i> @Localizer["Home"]</span>
        <i class='bx bx-chevron-right bc-sep'></i>
        <a href="@Url.Action("Index", "Order")" style="text-decoration:none; color:var(--text-muted)">@Localizer["Orders"]</a>
        <i class='bx bx-chevron-right bc-sep'></i>
        <span class="bc-current">@Localizer["Details"] #@Model.Id</span>
    </div>

    <div class="ord-details">
        <!-- Main details (Customer & Order Items) -->
        <div class="ord-info-block">
            <h4 class="ord-info-header">@Localizer["OrderItems"]</h4>
            @if(Model.OrderItems != null && Model.OrderItems.Any())
            {
                <table class="ord-items-table">
                    <thead>
                        <tr>
                            <th>@Localizer["ProductID"]</th>
                            <th>@Localizer["UnitPrice"]</th>
                            <th>@Localizer["Quantity"]</th>
                            <th>@Localizer["Total"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var item in Model.OrderItems)
                        {
                            <tr>
                                <td>#@item.ProductId</td>
                                <td>@(isArabic ? "" : "$")@item.UnitPrice.ToString("0.00")@(isArabic ? " " + Localizer["EGP"] : "")</td>
                                <td>@item.Quantity</td>
                                <td>@(isArabic ? "" : "$")@((item.UnitPrice * item.Quantity).ToString("0.00"))@(isArabic ? " " + Localizer["EGP"] : "")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p style="color:var(--text-muted); font-size:14px; margin-top:10px;">@Localizer["NoItemsInOrder"]</p>
            }

            <div style="margin-top:20px; text-align:right;">
                <strong style="font-size:18px; color:var(--text-dark)">@Localizer["GrandTotal"]: @(isArabic ? "" : "$")@Model.TotalAmount.ToString("0.00")@(isArabic ? " " + Localizer["EGP"] : "")</strong>
            </div>

            <h4 class="ord-info-header" style="margin-top:24px;">@Localizer["UpdateStatus"]</h4>
            <div class="ord-status-update">
                <form method="post" asp-area="Admin" asp-controller="Order" asp-action="UpdateStatus" style="display:flex; gap:12px;">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <select name="orderStatus" asp-for="OrderStatus" asp-items="Html.GetEnumSelectList<SmartStore.Models.OrderStatus>()" style="padding: 8px 12px; border: 1px solid var(--border-color); border-radius: 8px; font-family: 'Inter', sans-serif; background: var(--bg-color); color: var(--text-dark);">
                    </select>
                    <button type="submit">@Localizer["UpdateStatus"]</button>
                </form>
            </div>
        </div>

        <!-- Sidebar Details -->
        <div class="ord-info-block" style="border-left: 1px solid var(--border-color); padding-left: 24px;">
            <h4 class="ord-info-header">@Localizer["OrderInfo"]</h4>
            <div class="ord-info-row">
                <strong>@Localizer["Status"]:</strong>
                <span class="ord-badge badge-@(Model.OrderStatus.ToString().ToLower())">@Localizer[Model.OrderStatus.ToString()]</span>
            </div>
            <div class="ord-info-row">
                <strong>@Localizer["OrderDate"]:</strong> @Model.OrderDate.ToString("MMM dd, yyyy HH:mm")
            </div>
            <div class="ord-info-row">
                <strong>@Localizer["Payment"]:</strong> @Localizer["CreditCard"]
            </div>

            <h4 class="ord-info-header" style="margin-top:24px;">@Localizer["CustomerInfo"]</h4>
            <div class="ord-info-row">
                <strong>@Localizer["Name"]:</strong> @Model.CustomerName
            </div>
            <div class="ord-info-row">
                <strong>@Localizer["Email"]:</strong> @Model.CustomerEmail
            </div>
            <div class="ord-info-row">
                <strong>@Localizer["Phone"]:</strong> @Model.CustomerPhone
            </div>
            <div class="ord-info-row">
                <strong>@Localizer["Address"]:</strong> @Model.ShippingAddress
            </div>
        </div>
    </div>
</div>
