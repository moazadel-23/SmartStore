            <!-- Quick Stats Mini -->
            <div class="mini-stats">
                <div class="mini-stat">
                    <span class="ms-label">Today's Sales</span>
                    <span class="ms-value">$4,230</span>
                </div>
                <div class="mini-stat">
                    <span class="ms-label">New Customers</span>
                    <span class="ms-value">+18</span>
                </div>
                <div class="mini-stat">
