@model SmartStore.ViewModel.DashboardViewModel
@inject Microsoft.AspNetCore.Identity.UserManager<ApplicationUser> UserManager
@{
    Layout = "_AdminLayout";
    
    string userDisplayName = "Moa";
    if (User.Identity?.IsAuthenticated == true) {
        var currentUser = await UserManager.GetUserAsync(User);
        if (currentUser != null) {
            userDisplayName = currentUser.FirstName;
            if (string.IsNullOrEmpty(userDisplayName)) {
                userDisplayName = currentUser.UserName ?? "Moa";
            }
        }
    }
    bool isArabic = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar", StringComparison.OrdinalIgnoreCase);
}

<div class="home-content">

    <!-- ── Gradient Hero & Ideas Row ────────────────────────── -->
    <div class="dashboard-hero-row">
        <!-- Welcome Hero Card -->
        <div class="hero-gradient-card">
            <h1>@Localizer["WelcomeDashboardPrefix"] @(userDisplayName),</h1>
            <p>@Localizer["WelcomeDashboardSubtitle"]</p>
        </div>

        <!-- Ideas for You Card -->
        <div class="ideas-card">
            <div class="ideas-header">
                <h3>@Localizer["IdeasForYou"]</h3>
                <div class="ideas-nav-btns">
                    <button class="ideas-nav-btn"><i class='bx bx-chevron-left'></i></button>
                    <button class="ideas-nav-btn"><i class='bx bx-chevron-right'></i></button>
                </div>
            </div>
            <div class="ideas-content">
                <h4>@Localizer["CreateBlogPost"]</h4>
                <p>@Localizer["CreateBlogPostSubtitle"]</p>
                <button class="read-btn">@Localizer["ReadNow"]</button>
            </div>
        </div>
    </div>

    <!-- ── KPI Cards ──────────────────────────── -->
    <div class="kpis-grid">
        <!-- Total Products -->
        <div class="kpi-card-new" id="kpi-products">
            <div class="kpi-header">
                <div class="kpi-icon-container products">
                    <i class='bx bx-box'></i>
                </div>
                <span class="kpi-title">@Localizer["TotalProducts"]</span>
            </div>
            <div class="kpi-body">
                <span class="kpi-value" style="margin-left: 15px;">@(Model?.TotalProduct ?? 0)</span>
                <span class="kpi-trend up">
                    <i class='bx bx-trending-up'></i>
                    <span>4.12%</span>
                </span>
            </div>
        </div>
        <!-- Orders -->
        <div class="kpi-card-new" id="kpi-orders">
            <div class="kpi-header">
                <div class="kpi-icon-container orders">
                    <i class='bx bx-shopping-bag'></i>
                </div>
                <span class="kpi-title">@Localizer["Orders"]</span>
            </div>
            <div class="kpi-body">
                <span class="kpi-value">@(Model?.TotalOrdersCount.ToString("N0") ?? "0")</span>
                <span class="kpi-trend up">
                    <i class='bx bx-trending-up'></i>
                    <span>2.29%</span>
                </span>
            </div>
        </div>

        <!-- Revenue -->
        <div class="kpi-card-new" id="kpi-revenue">
            <div class="kpi-header">
                <div class="kpi-icon-container revenue">
                    <i class='bx bx-dollar-circle'></i>
                </div>
                <span class="kpi-title">@Localizer["Revenue"]</span>
            </div>
            <div class="kpi-body">
                <span class="kpi-value">@(isArabic ? "" : "$")@(Model?.TotalRevenue.ToString("N0") ?? "0")@(isArabic ? " " + Localizer["EGP"] : "")</span>
                <span class="kpi-trend up">
                    <i class='bx bx-trending-up'></i>
                    <span>2.19%</span>
                </span>
            </div>
        </div>

        <!-- Total Users -->
        <div class="kpi-card-new" id="kpi-users">
            <div class="kpi-header">
                <div class="kpi-icon-container conversion">
                    <i class='bx bx-group'></i>
                </div>
                <span class="kpi-title">@Localizer["TotalUsers"]</span>
            </div>
            <div class="kpi-body">
                <span class="kpi-value" style="margin-left: 15px;">@(Model?.TotalUsersCount ?? 0)</span>
                <span class="kpi-trend down">
                    <i class='bx bx-trending-down'></i>
                    <span>1.2%</span>
                </span>
            </div>
        </div>

       
    </div>

    <!-- ── Charts Grid ─────────────────────────── -->
    <div class="charts-row">
        <!-- Revenue Line Chart -->
        <div class="chart-box">
            <div class="box-header" style="margin-bottom: 0;">
                <h3>@Localizer["Revenue"]</h3>
                <i class='bx bx-dots-horizontal-rounded' style="color: var(--text-muted); cursor: pointer;"></i>
            </div>
            <div class="chart-summary-header">
                <div class="summary-item-col active" id="showIncomeBtn">
                    <span class="summary-item-label">
                        <span class="legend-dot" style="background: #10b981;"></span>
                        @Localizer["TotalIncome"]
                    </span>
                    <span class="summary-item-value">@(isArabic ? "" : "$")@(Model?.TotalRevenue.ToString("N0") ?? "0")@(isArabic ? " " + Localizer["EGP"] : "")</span>
                </div>
                <div class="summary-item-col" id="showExpensesBtn">
                    <span class="summary-item-label">
                        <span class="legend-dot" style="background: #f59e0b;"></span>
                        @Localizer["TotalExpenses"]
                    </span>
                    <span class="summary-item-value">@(isArabic ? "" : "$")198,214@(isArabic ? " " + Localizer["EGP"] : "")</span>
                </div>
            </div>
            <div class="chart-container">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>

        <!-- Product Sales Donut Chart -->
        <div class="chart-box">
            <div class="box-header">
                <h3>@Localizer["ProductSales"]</h3>
                <i class='bx bx-dots-horizontal-rounded' style="color: var(--text-muted); cursor: pointer;"></i>
            </div>
            <div class="donut-wrap" style="height: 180px;">
                <canvas id="productSalesChart"></canvas>
            </div>
            <div style="margin-top: 20px; display: flex; flex-direction: column;">
                <div class="legend-item-new">
                    <div class="legend-left-side">
                        <span class="legend-dot" style="background: #10b981;"></span>
                        <span>@Localizer["Mobiles"]</span>
                    </div>
                    <div class="legend-value-row">
                        <span>@(isArabic ? "" : "$")22,120@(isArabic ? " " + Localizer["EGP"] : "")</span>
                        <span class="legend-percent">38.1%</span>
                    </div>
                </div>
                <div class="legend-item-new">
                    <div class="legend-left-side">
                        <span class="legend-dot" style="background: #f59e0b;"></span>
                        <span>@Localizer["Laptops"]</span>
                    </div>
                    <div class="legend-value-row">
                        <span>@(isArabic ? "" : "$")4,510@(isArabic ? " " + Localizer["EGP"] : "")</span>
                        <span class="legend-percent">28.6%</span>
                    </div>
                </div>
                <div class="legend-item-new">
                    <div class="legend-left-side">
                        <span class="legend-dot" style="background: #3b82f6;"></span>
                        <span>@Localizer["Speakers"]</span>
                    </div>
                    <div class="legend-value-row">
                        <span>@(isArabic ? "" : "$")800@(isArabic ? " " + Localizer["EGP"] : "")</span>
                        <span class="legend-percent">23.8%</span>
                    </div>
                </div>
                <div class="legend-item-new">
                    <div class="legend-left-side">
                        <span class="legend-dot" style="background: #ef4444;"></span>
                        <span>@Localizer["ScreensTVs"]</span>
                    </div>
                    <div class="legend-value-row">
                        <span>@(isArabic ? "" : "$")420@(isArabic ? " " + Localizer["EGP"] : "")</span>
                        <span class="legend-percent">9.5%</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Bottom Row ─────────────────────────── -->
    <div class="bottom-row">

        <!-- Recent Orders Table -->
        <div class="chart-box recent-orders-box">
            <div class="box-header">
                <h3>@Localizer["RecentOrders"]</h3>
                <a href="#" class="view-all">@Localizer["ShowAll"] <i class='bx bx-arrow-back bx-rotate-180'></i></a>
            </div>
            <div class="sales-details">
                <table>
                    <thead>
                        <tr>
                            <th>@Localizer["OrderID"]</th>
                            <th>@Localizer["Customer"]</th>
                            <th>@Localizer["Date"]</th>
                            <th>@Localizer["Amount"]</th>
                            <th>@Localizer["Status"]</th>
                            <th>@Localizer["Action"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.RecentOrders != null && Model.RecentOrders.Any())
                        {
                            foreach (var order in Model.RecentOrders)
                            {
                                <tr>
                                    <td><span class="order-id">#@order.Id</span></td>
                                    <td>
                                        <div class="customer-info">
                                            <div class="cust-avatar" style="width:32px; height:32px; border-radius:50%; background-color:#10b981; color:#fff; display:flex; align-items:center; justify-content:center; font-weight:bold; font-size:12px;">
                                                @(string.IsNullOrEmpty(order.CustomerName) ? "?" : order.CustomerName.Substring(0,1).ToUpper())
                                            </div>
                                            <div style="margin-left: 10px;">
                                                <div class="cust-name">@order.CustomerName</div>
                                                <div class="cust-email">@order.CustomerEmail</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="order-date">@order.OrderDate.ToString("MMM dd, yyyy")</td>
                                    <td class="order-amount">@(isArabic ? "" : "$")@order.TotalAmount.ToString("N2")@(isArabic ? " " + Localizer["EGP"] : "")</td>
                                    <td>
                                        @{
                                            var badgeClass = order.OrderStatus switch {
                                                SmartStore.Models.OrderStatus.Delivered => "delivered",
                                                SmartStore.Models.OrderStatus.Pending => "pending",
                                                SmartStore.Models.OrderStatus.Returned => "returned",
                                                SmartStore.Models.OrderStatus.Cancelled => "returned",
                                                _ => "pending"
                                            };
                                        }
                                        <span class="status @badgeClass">@order.OrderStatus.ToString()</span>
                                    </td>
                                    <td>
                                        <div class="action-btns">
                                            <a href="@Url.Action("Details", "Order", new { area = "Admin", id = order.Id })" class="act-btn view-btn" title="View"><i class='bx bx-show'></i></a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        } else {
                            <tr><td colspan="6" style="text-align:center; padding: 20px;">@Localizer["NoRecentOrders"]</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Activity Feed -->
        <div class="chart-box activity-box">
            <div class="box-header">
                <h3>@Localizer["RecentActivity"]</h3>
                <i class='bx bx-refresh act-refresh' title="Refresh" style="cursor:pointer;"></i>
            </div>

            <div class="activity-feed">
                <div class="activity-item">
                    <div class="activity-icon ai-blue"><i class='bx bx-cart-add'></i></div>
                    <div class="activity-body">
                        <p class="act-title">New Order <strong>#ORD-106</strong></p>
                        <p class="act-desc">Alice placed a new order for Mac Laptop Pro.</p>
                        <span class="act-time"><i class='bx bx-time-five'></i> 2 mins ago</span>
                    </div>
                </div>
                <div class="activity-item">
                    <div class="activity-icon ai-green"><i class='bx bx-package'></i></div>
                    <div class="activity-body">
                        <p class="act-title">Product Restocked</p>
                        <p class="act-desc">50 units added to Sony WH-1000XM5 Headphones.</p>
                        <span class="act-time"><i class='bx bx-time-five'></i> 1 hour ago</span>
                    </div>
                </div>
                <div class="activity-item">
                    <div class="activity-icon ai-yellow"><i class='bx bx-user-check'></i></div>
                    <div class="activity-body">
                        <p class="act-title">New User Verified</p>
                        <p class="act-desc">Customer account <strong>'JaneS'</strong> was approved.</p>
                        <span class="act-time"><i class='bx bx-time-five'></i> 3 hours ago</span>
                    </div>
                </div>
                <div class="activity-item">
                    <div class="activity-icon ai-red"><i class='bx bx-credit-card'></i></div>
                    <div class="activity-body">
                        <p class="act-title">Payment Failed</p>
                        <p class="act-desc">Transaction <strong>#TR9485</strong> was declined by the bank.</p>
                        <span class="act-time"><i class='bx bx-time-five'></i> 5 hours ago</span>
                    </div>
                </div>
            </div>

            <!-- Quick Stats Mini -->
            <div class="mini-stats">
                <div class="mini-stat">
                    <span class="ms-label">@Localizer["TodaySales"]</span>
                    <span class="ms-value">@(isArabic ? "" : "$")4,230@(isArabic ? " " + Localizer["EGP"] : "")</span>
                </div>
                <div class="mini-stat">
                    <span class="ms-label">@Localizer["NewCustomers"]</span>
                    <span class="ms-value">+18</span>
                </div>
                <div class="mini-stat">
                    <span class="ms-label">@Localizer["PendingOrders"]</span>
                    <span class="ms-value warned">12</span>
                </div>
            </div>
        </div>

    </div>

</div>

@section Scripts {
<script>
(function () {
    // ── Revenue Chart ──────────────────────────────────────
    const ctx1 = document.getElementById('revenueChart').getContext('2d');
    
    // Gradients
    const gradIncome = ctx1.createLinearGradient(0, 0, 0, 300);
    gradIncome.addColorStop(0, 'rgba(16, 185, 129, 0.24)');
    gradIncome.addColorStop(1, 'rgba(16, 185, 129, 0.0)');

    const gradExpenses = ctx1.createLinearGradient(0, 0, 0, 300);
    gradExpenses.addColorStop(0, 'rgba(245, 158, 11, 0.24)');
    gradExpenses.addColorStop(1, 'rgba(245, 158, 11, 0.0)');

    const incomeData = {
        labels: ['@Html.Raw(new DateTime(2026, 1, 1).ToString("MMM"))', '@Html.Raw(new DateTime(2026, 2, 1).ToString("MMM"))', '@Html.Raw(new DateTime(2026, 3, 1).ToString("MMM"))', '@Html.Raw(new DateTime(2026, 4, 1).ToString("MMM"))', '@Html.Raw(new DateTime(2026, 5, 1).ToString("MMM"))', '@Html.Raw(new DateTime(2026, 6, 1).ToString("MMM"))', '@Html.Raw(new DateTime(2026, 7, 1).ToString("MMM"))'],
        data:   [30000, 40000, 28000, 51000, 42000, 105000, 97000],
        borderColor: '#10b981',
        backgroundColor: gradIncome,
        pointBorderColor: '#10b981',
        minY: 20000,
        maxY: 110000,
        stepY: 10000
    };

    const expensesData = {
        labels: ['@Html.Raw(new DateTime(2026, 1, 1).ToString("MMM"))', '@Html.Raw(new DateTime(2026, 2, 1).ToString("MMM"))', '@Html.Raw(new DateTime(2026, 3, 1).ToString("MMM"))', '@Html.Raw(new DateTime(2026, 4, 1).ToString("MMM"))', '@Html.Raw(new DateTime(2026, 5, 1).ToString("MMM"))', '@Html.Raw(new DateTime(2026, 6, 1).ToString("MMM"))', '@Html.Raw(new DateTime(2026, 7, 1).ToString("MMM"))'],
        data:   [11000, 32000, 45000, 32000, 34000, 52000, 41000],
        borderColor: '#f59e0b',
        backgroundColor: gradExpenses,
        pointBorderColor: '#f59e0b',
        minY: 10000,
        maxY: 55000,
        stepY: 5000
    };

    const revenueChart = new Chart(ctx1, {
        type: 'line',
        data: {
            labels: incomeData.labels,
            datasets: [{
                label: 'Revenue ($)',
                data: incomeData.data,
                backgroundColor: incomeData.backgroundColor,
                borderColor: incomeData.borderColor,
                borderWidth: 3,
                pointBackgroundColor: '#ffffff',
                pointBorderColor: incomeData.pointBorderColor,
                pointBorderWidth: 2.5,
                pointRadius: 5,
                pointHoverRadius: 8,
                fill: true,
                tension: 0.4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: {
                    backgroundColor: '#111c2e',
                    titleColor: '#f9fafb',
                    bodyColor: '#d1d5db',
                    borderColor: '#1e293b',
                    borderWidth: 1,
                    padding: 12,
                    displayColors: false,
                    callbacks: {
                        label: ctx => {
                            const isAr = @(isArabic ? "true" : "false");
                            return isAr ? ctx.parsed.y.toLocaleString() + ' @Html.Raw(Localizer["EGP"])' : '$' + ctx.parsed.y.toLocaleString();
                        }
                    }
                }
            },
            scales: {
                y: {
                    min: incomeData.minY,
                    max: incomeData.maxY,
                    grid: { color: '#1e293b', borderDash: [5,5], drawBorder: false },
                    ticks: { color: '#94a3b8', stepSize: incomeData.stepY, callback: v => (v/1000) + 'k' }
                },
                x: {
                    grid: { display: false, drawBorder: false },
                    ticks: { color: '#94a3b8' }
                }
            },
            interaction: { intersect: false, mode: 'index' }
        }
    });

    // ── Swapping Logic ────────────────────────────────────
    const showIncomeBtn = document.getElementById("showIncomeBtn");
    const showExpensesBtn = document.getElementById("showExpensesBtn");

    if (showIncomeBtn && showExpensesBtn) {
        showIncomeBtn.addEventListener("click", () => {
            showIncomeBtn.classList.add("active");
            showExpensesBtn.classList.remove("active");

            // Update Dataset
            revenueChart.data.datasets[0].data = incomeData.data;
            revenueChart.data.datasets[0].borderColor = incomeData.borderColor;
            revenueChart.data.datasets[0].backgroundColor = incomeData.backgroundColor;
            revenueChart.data.datasets[0].pointBorderColor = incomeData.pointBorderColor;

            // Update Scales
            revenueChart.options.scales.y.min = incomeData.minY;
            revenueChart.options.scales.y.max = incomeData.maxY;
            revenueChart.options.scales.y.ticks.stepSize = incomeData.stepY;

            revenueChart.update();
        });

        showExpensesBtn.addEventListener("click", () => {
            showExpensesBtn.classList.add("active");
            showIncomeBtn.classList.remove("active");

            // Update Dataset
            revenueChart.data.datasets[0].data = expensesData.data;
            revenueChart.data.datasets[0].borderColor = expensesData.borderColor;
            revenueChart.data.datasets[0].backgroundColor = expensesData.backgroundColor;
            revenueChart.data.datasets[0].pointBorderColor = expensesData.pointBorderColor;

            // Update Scales
            revenueChart.options.scales.y.min = expensesData.minY;
            revenueChart.options.scales.y.max = expensesData.maxY;
            revenueChart.options.scales.y.ticks.stepSize = expensesData.stepY;

            revenueChart.update();
        });
    }

    // ── Product Sales Donut Chart ────────────────────────────────
    const ctx2 = document.getElementById('productSalesChart').getContext('2d');
    new Chart(ctx2, {
        type: 'doughnut',
        data: {
            labels: ['@Html.Raw(Localizer["Mobiles"])', '@Html.Raw(Localizer["Laptops"])', '@Html.Raw(Localizer["Speakers"])', '@Html.Raw(Localizer["ScreensTVs"])'],
            datasets: [{
                data: [38.1, 28.6, 23.8, 9.5],
                backgroundColor: ['#10b981', '#f59e0b', '#3b82f6', '#ef4444'],
                borderWidth: 3,
                borderColor: '#111c2e',
                hoverOffset: 6
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '72%',
            plugins: {
                legend: { display: false },
                tooltip: {
                    backgroundColor: '#111c2e',
                    titleColor: '#f9fafb',
                    bodyColor: '#d1d5db',
                    borderColor: '#1e293b',
                    borderWidth: 1,
                    padding: 10,
                    callbacks: { label: ctx => ' ' + ctx.label + ': ' + ctx.parsed + '%' }
                }
            }
        }
    });

    // ── KPI card counter animation ─────────────────────────
    function animateCount(el, target, prefix, suffix, isFloat = false) {
        if (!el) return;
        let start = 0;
        const duration = 1000;
        const step = target / (duration / 16);
        const timer = setInterval(() => {
            start = Math.min(start + step, target);
            if (isFloat) {
                el.textContent = prefix + start.toFixed(1) + suffix;
            } else {
                el.textContent = prefix + Math.round(start).toLocaleString() + suffix;
            }
            if (start >= target) clearInterval(timer);
        }, 16);
    }

    // run on load
    animateCount(document.querySelector('#kpi-revenue .kpi-value'),  @Html.Raw(Model?.TotalRevenue ?? 0), '@Html.Raw(isArabic ? "" : "$")', '@Html.Raw(isArabic ? " " + Localizer["EGP"] : "")');
    animateCount(document.querySelector('#kpi-orders .kpi-value'),   @(Model?.TotalOrdersCount ?? 0),  '',  '');
    animateCount(document.querySelector('#kpi-users .kpi-value'),    @(Model?.TotalUsersCount ?? 0),  '',  '');
    animateCount(document.querySelector('#kpi-products .kpi-value'), @(Model?.TotalProduct ?? 0),  '',  '');
})();
</script>
}
