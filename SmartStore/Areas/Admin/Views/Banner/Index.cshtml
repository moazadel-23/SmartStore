@section Scripts {
    <script>
        function setupPreview(fileInpId, imgId) {
            const fileInp = document.getElementById(fileInpId);
            const prevImg = document.getElementById(imgId);
            fileInp?.addEventListener('change', function() {
                const file = this.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        prevImg.src = e.target.result;
                    };
                    reader.readAsDataURL(file);
                }
            });
        }

        setupPreview('slide1FileInp', 'prevSlide1Img');
        setupPreview('slide2FileInp', 'prevSlide2Img');
        setupPreview('slide3FileInp', 'prevSlide3Img');
        setupPreview('huaweiFileInp', 'prevHuaweiImg');
        setupPreview('ankerFileInp', 'prevAnkerImg');

        function switchTab(tabId, btn) {
            // Hide all tab contents
            document.querySelectorAll('.tab-content').forEach(content => {
                content.classList.remove('active');
            });
            // Remove active class from all tab buttons
            document.querySelectorAll('.tab-btn').forEach(button => {
                button.classList.remove('active');
            });
            // Show clicked tab content
            document.getElementById(tabId).classList.add('active');
            // Add active class to clicked tab button
            btn.classList.add('active');
        }
    </script>
}
