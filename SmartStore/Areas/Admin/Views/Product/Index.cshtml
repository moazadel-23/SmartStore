@model IEnumerable<SmartStore.Models.Product>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Products";
    ViewData["PageTitle"] = "Product Management";

    var totalProducts    = Model?.Count() ?? 0;
    var activeProducts   = Model?.Count(p => p.Status) ?? 0;
    var inactiveProducts = totalProducts - activeProducts;
}

<link rel="stylesheet" href="~/css/category-admin.css">

<style>
    /* Add any small specific adjustments for product images */
    .prod-img-wrap {
        width: 40px;
        height: 40px;
        border-radius: 8px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f3f4f6;
    }
    .prod-img-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
</style>

<div class="home-content">

    <!-- ── Breadcrumb ─────────────────────────── -->
    <div class="breadcrumb-bar">
        <span class="bc-home"><i class='bx bxs-home-alt-2'></i> Home</span>
        <i class='bx bx-chevron-right bc-sep'></i>
        <span class="bc-current">Products</span>
        <span class="bc-date"><i class='bx bx-calendar'></i> @DateTime.Now.ToString("dddd, MMMM dd yyyy")</span>
    </div>

    <!-- ── KPI Strip ──────────────────────────── -->
    <div class="cat-kpi-strip">
        <div class="cat-kpi-item">
            <div class="cat-kpi-icon ck-blue"><i class='bx bx-box'></i></div>
            <div>
                <div class="cat-kpi-val">@totalProducts</div>
                <div class="cat-kpi-label">Total Products</div>
            </div>
        </div>
        <div class="cat-kpi-divider"></div>
        <div class="cat-kpi-item">
            <div class="cat-kpi-icon ck-green"><i class='bx bx-check-circle'></i></div>
            <div>
                <div class="cat-kpi-val">@activeProducts</div>
                <div class="cat-kpi-label">Active</div>
            </div>
        </div>
        <div class="cat-kpi-divider"></div>
        <div class="cat-kpi-item">
            <div class="cat-kpi-icon ck-red"><i class='bx bx-x-circle'></i></div>
            <div>
                <div class="cat-kpi-val">@inactiveProducts</div>
                <div class="cat-kpi-label">Inactive</div>
            </div>
        </div>
        <div class="cat-kpi-divider"></div>
        <div class="cat-kpi-item">
            <div class="cat-kpi-icon ck-purple"><i class='bx bx-trending-up'></i></div>
            <div>
                <div class="cat-kpi-val">@(totalProducts > 0 ? Math.Round((double)activeProducts / totalProducts * 100, 0) : 0)%</div>
                <div class="cat-kpi-label">Active Rate</div>
            </div>
        </div>
    </div>

    <!-- ── Table Card ─────────────────────────── -->
    <div class="cat-card">

        <!-- Card Header -->
        <div class="cat-card-header">
            <div class="cat-card-title">
                <i class='bx bx-list-ul'></i>
                <div>
                    <h3>All Products</h3>
                    <p>Manage and organise your store products</p>
                </div>
            </div>
            <div class="cat-card-actions">
                <!-- Search -->
                <div class="cat-search-wrap">
                    <i class='bx bx-search'></i>
                    <input type="text" id="productSearch" placeholder="Search products…">
                    <span class="cat-search-clear" id="clearSearch" title="Clear"><i class='bx bx-x'></i></span>
                </div>
                <!-- Filter -->
                <div class="cat-filter-wrap">
                    <select id="statusFilter" class="cat-filter-select">
                        <option value="all">All Status</option>
                        <option value="active">Active Only</option>
                        <option value="inactive">Inactive Only</option>
                    </select>
                    <i class='bx bx-chevron-down cat-filter-arrow'></i>
                </div>
                <!-- Add Button -->
                <a asp-area="Admin" asp-controller="Product" asp-action="Create" class="cat-add-btn" id="addProductBtn">
                    <i class='bx bx-plus'></i>
                    <span>Add Product</span>
                </a>
            </div>
        </div>

        <!-- Table / Empty State -->
        @if (Model != null && Model.Any())
        {
            <!-- Result Counter -->
            <div class="cat-result-bar">
                <span id="resultCount">Showing <strong>@totalProducts</strong> products</span>
            </div>

            <div class="cat-table-wrap">
                <table class="cat-table" id="productTable">
                    <thead>
                        <tr>
                            <th class="th-check">
                                <input type="checkbox" id="selectAll" class="cat-checkbox">
                            </th>
                            <th class="sortable" data-col="1">
                                Product <i class='bx bx-sort'></i>
                            </th>
                            <th>Category & Brand</th>
                            <th class="sortable" data-col="3">
                                Price <i class='bx bx-sort'></i>
                            </th>
                            <th class="sortable" data-col="4">
                                Qty <i class='bx bx-sort'></i>
                            </th>
                            <th class="sortable" data-col="5">
                                Status <i class='bx bx-sort'></i>
                            </th>
                            <th class="th-actions">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="productTableBody">
                        @{
                            var colors = new[] { "#4F46E5","#10B981","#F59E0B","#EF4444","#8B5CF6","#06B6D4","#EC4899","#14B8A6" };
                            int idx = 0;
                        }
                        @foreach (var product in Model)
                        {
                            var color = colors[idx % colors.Length];
                            var initial = string.IsNullOrEmpty(product.Name) ? "?" : product.Name.Substring(0, 1).ToUpper();
                            idx++;
                            <tr data-status="@(product.Status ? "active" : "inactive")" class="cat-row">
                                <td class="td-check">
                                    <input type="checkbox" class="cat-checkbox row-check">
                                </td>
                                <td>
                                    <div class="cat-name-cell">
                                        @if (!string.IsNullOrEmpty(product.MainImg))
                                        {
                                            <div class="prod-img-wrap">
                                                <img src="~/ProductImg/@product.MainImg" alt="@product.Name" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" style="display:block;">
                                                <div class="cat-avatar" style="background: @(color)20; color: @color; display:none;">
                                                    @initial
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="cat-avatar" style="background: @(color)20; color: @color;">
                                                @initial
                                            </div>
                                        }
                                        <div class="cat-meta">
                                            <span class="cat-name">@product.Name</span>
                                            <small style="color: #6b7280; font-size: 0.8rem;">#@product.Id</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div style="display: flex; flex-direction: column;">
                                        <strong style="color: #374151; font-size: 0.875rem;">@(product.Category?.Name ?? "—")</strong>
                                        <span style="color: #6b7280; font-size: 0.75rem;">@(product.Brand?.Name ?? "—")</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="cat-desc">$@product.Price.ToString("0.00")</span>
                                </td>
                                <td>
                                    <span class="cat-desc">@product.Quantity</span>
                                </td>
                                <td>
                                    @if (product.Status)
                                    {
                                        <span class="cat-badge badge-active">
                                            <i class='bx bxs-circle'></i> Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="cat-badge badge-inactive">
                                            <i class='bx bxs-circle'></i> Inactive
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="cat-action-group">
                                        <a asp-area="Admin" asp-controller="Product" asp-action="Update" asp-route-id="@product.Id"
                                           class="cat-btn cat-btn-edit" title="Edit product">
                                            <i class='bx bx-edit-alt'></i>
                                        </a>
                                        <button type="button"
                                                class="cat-btn cat-btn-delete"
                                                title="Delete product"
                                                data-id="@product.Id"
                                                data-name="@product.Name"
                                                onclick="openDeleteModal(this)">
                                            <i class='bx bx-trash'></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination placeholder -->
            <div class="cat-footer">
                <span class="cat-footer-info" id="footerSelected">0 items selected</span>
                <div class="cat-pagination">
                    <button class="pg-btn" disabled><i class='bx bx-chevron-left'></i></button>
                    <button class="pg-btn pg-active">1</button>
                    <button class="pg-btn" disabled><i class='bx bx-chevron-right'></i></button>
                </div>
            </div>
        }
        else
        {
            <div class="cat-empty">
                <div class="cat-empty-icon">
                    <i class='bx bx-box'></i>
                </div>
                <h3>No Products Yet</h3>
                <p>Get started by adding your first product to the store.</p>
                <a asp-action="Create" class="cat-add-btn">
                    <i class='bx bx-plus'></i> Create First Product
                </a>
            </div>
        }
    </div>
</div>

<!-- ── Delete Confirmation Modal ─────────────── -->
<div class="cat-modal-overlay" id="deleteModal">
    <div class="cat-modal">
        <div class="cat-modal-icon">
            <i class='bx bx-trash'></i>
        </div>
        <h3 class="cat-modal-title">Delete Product?</h3>
        <p class="cat-modal-desc">
            You are about to delete <strong id="deleteProductName">this product</strong>.
            This action cannot be undone.
        </p>
        <div class="cat-modal-actions">
            <button class="cat-modal-cancel" onclick="closeDeleteModal()">Cancel</button>
            <form id="deleteForm" method="post" asp-area="Admin" asp-controller="Product" asp-action="Delete">
                 <input type="hidden" name="id" id="deleteProductId" value="" />
                 <button type="submit" class="cat-modal-confirm" style="border:none; cursor:pointer; font-family: inherit; font-size: 1rem;">
                     <i class='bx bx-trash'></i> Delete
                 </button>
            </form>
        </div>
    </div>
</div>

<!-- ── Toast ──────────────────────────────────── -->
<div class="cat-toast" id="catToast"></div>

@section Scripts {
<script>
/* ── Delete Modal ──────────────────────────── */
function openDeleteModal(btn) {
    const id   = btn.dataset.id;
    const name = btn.dataset.name;
    document.getElementById('deleteProductName').textContent = name;
    document.getElementById('deleteProductId').value = id;
    document.getElementById('deleteModal').classList.add('show');
}
function closeDeleteModal() {
    document.getElementById('deleteModal').classList.remove('show');
}
document.getElementById('deleteModal')?.addEventListener('click', function(e) {
    if (e.target === this) closeDeleteModal();
});

/* ── Search + Filter ───────────────────────── */
const searchInput  = document.getElementById('productSearch');
const clearBtn     = document.getElementById('clearSearch');
const statusFilter = document.getElementById('statusFilter');
const tableBody    = document.getElementById('productTableBody');
const resultCount  = document.getElementById('resultCount');

function filterTable() {
    const term   = searchInput ? searchInput.value.toLowerCase() : '';
    const status = statusFilter ? statusFilter.value : 'all';
    let visible  = 0;

    tableBody?.querySelectorAll('tr.cat-row').forEach(row => {
        const name     = row.cells[1]?.textContent.toLowerCase() || '';
        const catBrand = row.cells[2]?.textContent.toLowerCase() || '';
        const rowStat  = row.dataset.status || '';
        const matchSearch = name.includes(term) || catBrand.includes(term);
        const matchStatus = status === 'all' || rowStat === status;

        if (matchSearch && matchStatus) {
            row.style.display = '';
            visible++;
        } else {
            row.style.display = 'none';
        }
    });

    if (resultCount) {
        resultCount.innerHTML = `Showing <strong>${visible}</strong> products`;
    }
}

searchInput?.addEventListener('input', () => {
    clearBtn.style.opacity = searchInput.value ? '1' : '0';
    filterTable();
});
clearBtn?.addEventListener('click', () => {
    searchInput.value = '';
    clearBtn.style.opacity = '0';
    filterTable();
    searchInput.focus();
});
statusFilter?.addEventListener('change', filterTable);

/* ── Select All ────────────────────────────── */
const selectAll   = document.getElementById('selectAll');
const footerSel   = document.getElementById('footerSelected');
function updateSelectedCount() {
    const count = tableBody?.querySelectorAll('.row-check:checked').length || 0;
    if (footerSel) footerSel.textContent = `${count} item${count !== 1 ? 's' : ''} selected`;
}
selectAll?.addEventListener('change', function() {
    tableBody?.querySelectorAll('.row-check').forEach(cb => cb.checked = this.checked);
    updateSelectedCount();
});
tableBody?.addEventListener('change', e => {
    if (e.target.classList.contains('row-check')) updateSelectedCount();
});

/* ── Sortable columns ──────────────────────── */
document.querySelectorAll('th.sortable').forEach(th => {
    th.addEventListener('click', function() {
        const col = parseInt(this.dataset.col);
        const rows = Array.from(tableBody?.querySelectorAll('tr.cat-row') || []);
        const asc  = this.dataset.asc !== 'true';
        this.dataset.asc = asc;

        // Reset other headers
        document.querySelectorAll('th.sortable').forEach(h => {
            h.querySelector('i')?.classList.remove('bx-sort-up','bx-sort-down');
            h.querySelector('i')?.classList.add('bx-sort');
        });
        const icon = this.querySelector('i');
        if (icon) {
            icon.classList.remove('bx-sort');
            icon.classList.add(asc ? 'bx-sort-up' : 'bx-sort-down');
        }

        rows.sort((a, b) => {
            let at = a.cells[col]?.textContent.trim().replace('$', '') || '';
            let bt = b.cells[col]?.textContent.trim().replace('$', '') || '';
            const an = parseFloat(at); const bn = parseFloat(bt);
            if (!isNaN(an) && !isNaN(bn)) return asc ? an - bn : bn - an;
            return asc ? at.localeCompare(bt) : bt.localeCompare(at);
        });
        rows.forEach(r => tableBody.appendChild(r));
    });
});

/* ── Row entrance animation ────────────────── */
document.querySelectorAll('.cat-row').forEach((row, i) => {
    row.style.opacity = '0';
    row.style.transform = 'translateY(10px)';
    setTimeout(() => {
        row.style.transition = 'opacity 0.35s ease, transform 0.35s ease';
        row.style.opacity    = '1';
        row.style.transform  = 'translateY(0)';
    }, 60 + i * 45);
});
</script>
}
