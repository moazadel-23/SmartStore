@model SmartStore.Models.Product
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = Localizer["CreateProduct"];
    ViewData["PageTitle"] = Localizer["ProductManagement"];
    var categories = ViewBag.category as IEnumerable<SmartStore.Models.Category>;
    var brands = ViewBag.brand as IEnumerable<SmartStore.Models.Brand>;
}

<link rel="stylesheet" href="~/css/category-admin.css">
<style>
    /* Additional layout helpers for Product */
    .grid-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }
    
    .file-input-wrapper {
        padding: 12px;
        border: 1px dashed var(--border-color);
        border-radius: 8px;
        background: var(--bg-color);
        transition: all 0.3s ease;
    }
    .file-input-wrapper:hover {
        border-color: var(--primary-color);
        background: rgba(var(--primary-rgb), 0.02);
    }
    .file-input-wrapper input[type="file"] {
        width: 100%;
        color: transparent;
        font-family: inherit;
        font-size: 0.9rem;
    }
    .file-input-wrapper input[type="file"]::file-selector-button {
        background: var(--primary-color);
        color: white;
        border: none;
        padding: 6px 12px;
        border-radius: 6px;
        margin-right: 12px;
        cursor: pointer;
        font-family: inherit;
        transition: opacity 0.3s ease;
    }
    .file-input-wrapper input[type="file"]::file-selector-button:hover {
        opacity: 0.9;
    }
    
    @@media (max-width: 768px) {
        .grid-2 { grid-template-columns: 1fr; }
    }
</style>

<div class="home-content">
    <!-- Breadcrumb -->
    <div class="breadcrumb-bar">
        <span class="bc-home"><i class='bx bxs-home-alt-2'></i> @Localizer["Home"]</span>
        <i class='bx bx-chevron-right bc-sep'></i>
        <a asp-action="Index" class="bc-link">@Localizer["Products"]</a>
        <i class='bx bx-chevron-right bc-sep'></i>
        <span class="bc-current">@Localizer["NewProduct"]</span>
        <span class="bc-date">
            <i class='bx bx-calendar'></i>
            @DateTime.Now.ToString("dddd, MMMM dd yyyy")
        </span>
    </div>

    <!-- Page Title Row -->
    <div class="create-page-header">
        <div class="create-page-title">
            <div class="create-icon-wrap" style="background: rgba(16, 185, 129, 0.1); color: #10B981;">
                <i class='bx bx-box'></i>
            </div>
            <div>
                <h2>@Localizer["CreateNewProduct"]</h2>
                <p>@Localizer["FillDetailsToAddNewProduct"]</p>
            </div>
        </div>
    </div>

    <!-- Form -->
    <form asp-action="Create" asp-controller="Product" asp-area="Admin"
          method="post" id="createProductForm" enctype="multipart/form-data" novalidate>
        @Html.AntiForgeryToken()

        <div class="create-layout">

            <!-- LEFT: Main Details -->
            <div class="create-main">

                <!-- Basic Info Card -->
                <div class="create-card">
                    <div class="create-card-header">
                        <i class='bx bx-info-circle'></i>
                        <span>@Localizer["BasicInformation"]</span>
                    </div>
                    <div class="create-card-body">

                        <!-- Name -->
                        <div class="form-field" id="field-name">
                            <label asp-for="Name" class="field-label">
                                @Localizer["ProductName"] <span class="field-required">*</span>
                            </label>
                            <div class="field-input-wrap">
                                <i class='bx bx-box field-icon'></i>
                                <input asp-for="Name" class="field-input" placeholder="e.g. Samsung Galaxy S23" autocomplete="off" id="nameInput">
                            </div>
                            <span asp-validation-for="Name" class="field-error"></span>
                        </div>

                        <!-- Description -->
                        <div class="form-field" id="field-desc">
                            <label asp-for="description" class="field-label">
                                @Localizer["Description"]
                            </label>
                            <div class="field-textarea-wrap">
                                <textarea asp-for="description" class="field-textarea" placeholder="@Localizer["DetailedProductDescription"]..." rows="5" id="descInput"></textarea>
                            </div>
                            <span asp-validation-for="description" class="field-error"></span>
                        </div>

                    </div>
                </div>

                <!-- Pricing & Inventory Card -->
                <div class="create-card">
                    <div class="create-card-header">
                        <i class='bx bx-dollar-circle'></i>
                        <span>@Localizer["PricingInventory"]</span>
                    </div>
                    <div class="create-card-body">
                        <div class="grid-2">
                            <!-- Price -->
                            <div class="form-field">
                                <label asp-for="Price" class="field-label">@Localizer["Price"] <span class="field-required">*</span></label>
                                <div class="field-input-wrap">
                                    <i class='bx bx-dollar field-icon'></i>
                                    <input asp-for="Price" type="number" step="0.01" class="field-input" placeholder="0.00">
                                </div>
                                <span asp-validation-for="Price" class="field-error"></span>
                            </div>

                            <!-- Quantity -->
                            <div class="form-field">
                                <label asp-for="Quantity" class="field-label">@Localizer["Quantity"] <span class="field-required">*</span></label>
                                <div class="field-input-wrap">
                                    <i class='bx bx-layer field-icon'></i>
                                    <input asp-for="Quantity" type="number" step="1" class="field-input" placeholder="0">
                                </div>
                                <span asp-validation-for="Quantity" class="field-error"></span>
                            </div>

                            <!-- Discount -->
                            <div class="form-field">
                                <label asp-for="Discount" class="field-label">@Localizer["Discount"] (%)</label>
                                <div class="field-input-wrap">
                                    <i class='bx bxs-discount field-icon'></i>
                                    <input asp-for="Discount" type="number" step="0.01" class="field-input" placeholder="0%">
                                </div>
                                <span asp-validation-for="Discount" class="field-error"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Extended Details Card -->
                <div class="create-card">
                    <div class="create-card-header">
                        <i class='bx bx-detail'></i>
                        <span>@(System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar") ? "تفاصيل المنتج الإضافية" : "Additional Product Details")</span>
                    </div>
                    <div class="create-card-body">
                        <div class="grid-2">
                            <!-- SKU -->
                            <div class="form-field">
                                <label asp-for="SKU" class="field-label">@(System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar") ? "رمز المنتج / SKU" : "Product SKU")</label>
                                <div class="field-input-wrap">
                                    <i class='bx bx-barcode field-icon'></i>
                                    <input asp-for="SKU" class="field-input" placeholder="e.g. PR973">
                                </div>
                                <span asp-validation-for="SKU" class="field-error"></span>
                            </div>

                            <!-- Warranty -->
                            <div class="form-field">
                                <label asp-for="Warranty" class="field-label">@(System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar") ? "الضمان" : "Warranty")</label>
                                <div class="field-input-wrap">
                                    <i class='bx bx-shield-quarter field-icon'></i>
                                    <input asp-for="Warranty" class="field-input" placeholder="e.g. 1 Year / ضمان سنة">
                                </div>
                                <span asp-validation-for="Warranty" class="field-error"></span>
                            </div>
                        </div>

                        <div class="grid-2">
                            <!-- Delivery Time Cairo & Giza -->
                            <div class="form-field">
                                <label asp-for="DeliveryTimeCairoGiza" class="field-label">@(System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar") ? "التوصيل للقاهرة والجيزة" : "Delivery (Cairo & Giza)")</label>
                                <div class="field-input-wrap">
                                    <i class='bx bx-time field-icon'></i>
                                    <input asp-for="DeliveryTimeCairoGiza" class="field-input" placeholder="e.g. 1-7 أيام عمل">
                                </div>
                                <span asp-validation-for="DeliveryTimeCairoGiza" class="field-error"></span>
                            </div>

                            <!-- Delivery Time Outside -->
                            <div class="form-field">
                                <label asp-for="DeliveryTimeOutside" class="field-label">@(System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar") ? "التوصيل خارج القاهرة والجيزة" : "Delivery (Outside)")</label>
                                <div class="field-input-wrap">
                                    <i class='bx bx-truck field-icon'></i>
                                    <input asp-for="DeliveryTimeOutside" class="field-input" placeholder="e.g. 2-14 أيام عمل">
                                </div>
                                <span asp-validation-for="DeliveryTimeOutside" class="field-error"></span>
                            </div>
                        </div>

                        <div class="grid-2">
                            <!-- Return Policy -->
                            <div class="form-field">
                                <label asp-for="ReturnPolicy" class="field-label">@(System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar") ? "سياسة الاسترجاع" : "Return Policy")</label>
                                <div class="field-input-wrap">
                                    <i class='bx bx-refresh field-icon'></i>
                                    <input asp-for="ReturnPolicy" class="field-input" placeholder="e.g. إرجاع مجاني خلال 14 يوم">
                                </div>
                                <span asp-validation-for="ReturnPolicy" class="field-error"></span>
                            </div>

                            <!-- Package Contents -->
                            <div class="form-field">
                                <label asp-for="PackageContents" class="field-label">@(System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar") ? "محتويات العبوة" : "Package Contents")</label>
                                <div class="field-input-wrap">
                                    <i class='bx bx-package field-icon'></i>
                                    <input asp-for="PackageContents" class="field-input" placeholder="e.g. الطابعة، كابل الطاقة، زجاجات الحبر">
                                </div>
                                <span asp-validation-for="PackageContents" class="field-error"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Product Overview Card -->
                <div class="create-card">
                    <div class="create-card-header">
                        <i class='bx bx-file-find'></i>
                        <span>@(System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar") ? "نظرة عامة على المنتج" : "Product Overview Section")</span>
                    </div>
                    <div class="create-card-body">
                        <!-- Overview Title -->
                        <div class="form-field">
                            <label asp-for="OverviewTitle" class="field-label">@(System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar") ? "العنوان الرئيسي للنظرة العامة" : "Overview Section Title")</label>
                            <div class="field-input-wrap">
                                <i class='bx bx-text field-icon'></i>
                                <input asp-for="OverviewTitle" class="field-input" placeholder="e.g. قيمة عالية من خلال الخزان الذكي">
                            </div>
                            <span asp-validation-for="OverviewTitle" class="field-error"></span>
                        </div>

                        <!-- Overview Description -->
                        <div class="form-field">
                            <label asp-for="OverviewDescription" class="field-label">@(System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar") ? "وصف النظرة العامة" : "Overview Section Description")</label>
                            <div class="field-textarea-wrap">
                                <textarea asp-for="OverviewDescription" class="field-textarea" placeholder="Detailed overview section text..." rows="4"></textarea>
                            </div>
                            <span asp-validation-for="OverviewDescription" class="field-error"></span>
                        </div>

                        <!-- Overview Image Upload -->
                        <div class="form-field">
                            <label class="field-label">@(System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar") ? "صورة النظرة العامة" : "Overview Section Image")</label>
                            <div class="file-input-wrapper">
                                <input type="file" name="OverviewImgFile" accept="image/*">
                            </div>
                            <div class="field-hint">@(System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar") ? "صورة جانبية تظهر بجوار النص" : "Side image displayed next to description")</div>
                        </div>
                    </div>
                </div>

                <!-- Product Specifications Card -->
                <div class="create-card">
                    <div class="create-card-header" style="justify-content: space-between; display: flex; align-items: center; width: 100%;">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <i class='bx bx-list-check'></i>
                            <span>@(System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar") ? "المواصفات الفنية والمميزات" : "Specifications & Key Features")</span>
                        </div>
                        <button type="button" class="btn btn-sm btn-primary" onclick="addSpecRow()" style="background: var(--primary-color); color: #fff; border: none; padding: 4px 10px; border-radius: 4px; cursor: pointer; display: flex; align-items: center; gap: 4px; font-size: 0.8rem;">
                            <i class='bx bx-plus'></i> @(System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar") ? "إضافة مواصفة" : "Add Spec")
                        </button>
                    </div>
                    <div class="create-card-body">
                        <table class="cat-table" style="width:100%; border-collapse: collapse;" id="specsTable">
                            <thead>
                                <tr style="border-bottom: 2px solid var(--border-color); text-align: left;">
                                    <th style="padding: 8px;">@(System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar") ? "المواصفة (المفتاح)" : "Specification (Key)")</th>
                                    <th style="padding: 8px;">@(System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar") ? "القيمة" : "Value")</th>
                                    <th style="padding: 8px; text-align: center;">@(System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar") ? "تمييز مميز؟" : "Highlight?")</th>
                                    <th style="padding: 8px; text-align: center; width: 50px;"></th>
                                </tr>
                            </thead>
                            <tbody id="specsTableBody">
                            </tbody>
                        </table>
                        <div id="noSpecsHint" style="padding: 12px; text-align: center; color: #6b7280; font-size: 0.85rem;">
                            @(System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar") ? "لا توجد مواصفات مضافة حالياً. اضغط على زر إضافة مواصفة للبدء." : "No specifications added yet. Click Add Spec to start.")
                        </div>
                    </div>
                </div>

                <!-- Media Card -->
                <div class="create-card">
                    <div class="create-card-header">
                        <i class='bx bx-image-add'></i>
                        <span>@Localizer["ProductMedia"]</span>
                    </div>
                    <div class="create-card-body">
                        <div class="grid-2">
                            <!-- Main Image -->
                          
                             <div class="form-field">
     <label class="field-label">@Localizer["MainImage"] <span class="field-required">*</span></label>
     <div class="file-input-wrapper">
         <input type="file" name="Img" id="mainImgInput" accept="image/*" required>
     </div>
     <div class="field-hint">@Localizer["PrimaryImageShown"]</div>
     <div id="mainImgPreviewContainer" style="display: none; margin-top: 10px;">
         <img id="mainImgPreview" src="~/img/" alt="Main Image Preview" style="max-width: 100%; height: 120px; border-radius: 8px; border: 1px solid var(--border-color); object-fit: cover;" />
     </div>
 </div>
                            <!-- Sub Images -->
                            <div class="form-field">
                                <label class="field-label">@Localizer["GalleryImages"]</label>
                                <div class="file-input-wrapper">
                                    <input type="file" name="SubImgFiles" id="subImgsInput" accept="image/*" multiple>
                                </div>
                                <div class="field-hint">@Localizer["SelectMultipleImages"]</div>
                                <div id="subImgsPreviewContainer" style="display: flex; gap: 8px; flex-wrap: wrap; margin-top: 10px;">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- RIGHT: Sidebar Panels -->
            <div class="create-sidebar">

                <!-- Organization Card -->
                <div class="create-card">
                    <div class="create-card-header">
                        <i class='bx bx-sitemap'></i>
                        <span>@Localizer["Organization"]</span>
                    </div>
                    <div class="create-card-body">

                        <!-- Category -->
                        <div class="form-field">
                            <label class="field-label">@Localizer["Category"] <span class="field-required">*</span></label>
                            <div class="field-input-wrap" style="padding-left: 0;">
                                <select name="CategoryId" class="field-input" style="padding-left: 14px;" required>
                                    <option value="" disabled selected>@Localizer["SelectCategory"]</option>
                                    @if(categories != null)
                                    {
                                        foreach(var cat in categories)
                                        {
                                            <option value="@cat.Id">@cat.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- Brand -->
                        <div class="form-field">
                            <label class="field-label">@Localizer["Brand"] <span class="field-required">*</span></label>
                            <div class="field-input-wrap" style="padding-left: 0;">
                                <select name="BrandId" class="field-input" style="padding-left: 14px;" required>
                                    <option value="" disabled selected>@Localizer["SelectBrand"]</option>
                                    @if(brands != null)
                                    {
                                        foreach(var brand in brands)
                                        {
                                            <option value="@brand.Id">@brand.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Publish Card -->
                <div class="create-card">
                    <div class="create-card-header">
                        <i class='bx bx-send'></i>
                        <span>@Localizer["Publish"]</span>
                    </div>
                    <div class="create-card-body">

                        <!-- Status Toggle -->
                        <div class="form-field">
                            <label class="field-label">@Localizer["Status"]</label>
                            <div class="status-toggle-group" id="statusToggle">
                                <label class="status-option status-active-opt selected" id="statusActiveLabel">
                                    <input type="radio" asp-for="Status" value="true" name="Status" id="statusActive" checked>
                                    <i class='bx bx-check-circle'></i>
                                    <div>
                                        <span class="st-title">@Localizer["Active"]</span>
                                        <span class="st-desc">@Localizer["VisibleToCustomers"]</span>
                                    </div>
                                </label>
                                <label class="status-option status-inactive-opt" id="statusInactiveLabel">
                                    <input type="radio" asp-for="Status" value="false" name="Status" id="statusInactive">
                                    <i class='bx bx-x-circle'></i>
                                    <div>
                                        <span class="st-title">@Localizer["Inactive"]</span>
                                        <span class="st-desc">@Localizer["HiddenFromStore"]</span>
                                    </div>
                                </label>
                            </div>
                        </div>

                        <div class="publish-divider"></div>

                        <!-- Actions -->
                        <div class="publish-actions">
                            <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="pub-cancel-btn">
                                <i class='bx bx-x'></i> @Localizer["Cancel"]
                            </a>
                            <button type="submit" class="pub-submit-btn" id="submitBtn">
                                <i class='bx bx-check'></i>
                                <span>@Localizer["Create"]</span>
                                <div class="btn-loader" id="btnLoader"></div>
                            </button>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </form>
</div>

@section Scripts {
<script>
(function () {
    /* Status Toggle */
    const statusActive = document.getElementById('statusActive');
    const statusInactive = document.getElementById('statusInactive');
    const statusActiveLabel = document.getElementById('statusActiveLabel');
    const statusInactLabel = document.getElementById('statusInactiveLabel');

    function syncStatus() {
        const isActive = statusActive?.checked;
        statusActiveLabel?.classList.toggle('selected', !!isActive);
        statusInactLabel?.classList.toggle('selected', !isActive);
    }
    statusActive?.addEventListener('change', syncStatus);
    statusInactive?.addEventListener('change', syncStatus);

    /* Form Submission Feedback */
    const form = document.getElementById('createProductForm');
    const submitBtn = document.getElementById('submitBtn');
    const btnLoader = document.getElementById('btnLoader');

    form?.addEventListener('submit', function (e) {
        if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.querySelector('span').textContent = '@Localizer["Create"]…';
            if (btnLoader) btnLoader.style.display = 'block';
        }
    });

    /* Input focus styling */
    document.querySelectorAll('.field-input, .field-textarea').forEach(el => {
        el.addEventListener('focus', () => el.closest('.form-field')?.classList.add('focused'));
        el.addEventListener('blur',  () => el.closest('.form-field')?.classList.remove('focused'));
    });

    /* Entrance animation */
    document.querySelectorAll('.create-card').forEach((card, i) => {
        card.style.opacity   = '0';
        card.style.transform = 'translateY(16px)';
        setTimeout(() => {
            card.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
            card.style.opacity    = '1';
            card.style.transform  = 'translateY(0)';
        }, 80 + i * 80);
    });

    /* Image Previews */
    const mainImgInput = document.getElementById('mainImgInput');
    const mainImgPreviewContainer = document.getElementById('mainImgPreviewContainer');
    const mainImgPreview = document.getElementById('mainImgPreview');

    mainImgInput?.addEventListener('change', function (e) {
        if (this.files && this.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                mainImgPreview.src = e.target.result;
                mainImgPreviewContainer.style.display = 'block';
            }
            reader.readAsDataURL(this.files[0]);
        } else {
            mainImgPreview.src = '';
            mainImgPreviewContainer.style.display = 'none';
        }
    });

    const subImgsInput = document.getElementById('subImgsInput');
    const subImgsPreviewContainer = document.getElementById('subImgsPreviewContainer');
    let subImgsDataTransfer = new DataTransfer();

    function renderSubImages() {
        subImgsPreviewContainer.innerHTML = '';
        Array.from(subImgsDataTransfer.files).forEach((file, index) => {
            const reader = new FileReader();
            reader.onload = function(e) {
                const imgWrap = document.createElement('div');
                imgWrap.style.position = 'relative';
                imgWrap.style.display = 'inline-block';
                
                const img = document.createElement('img');
                img.src = e.target.result;
                img.style.width = '60px';
                img.style.height = '60px';
                img.style.borderRadius = '6px';
                img.style.border = '1px solid var(--border-color)';
                img.style.objectFit = 'cover';
                
                const removeBtn = document.createElement('span');
                removeBtn.innerHTML = '<i class="bx bx-x"></i>';
                removeBtn.style.position = 'absolute';
                removeBtn.style.top = '-6px';
                removeBtn.style.right = '-6px';
                removeBtn.style.background = '#EF4444';
                removeBtn.style.color = 'white';
                removeBtn.style.borderRadius = '50%';
                removeBtn.style.width = '18px';
                removeBtn.style.height = '18px';
                removeBtn.style.display = 'flex';
                removeBtn.style.alignItems = 'center';
                removeBtn.style.justifyContent = 'center';
                removeBtn.style.fontSize = '14px';
                removeBtn.style.cursor = 'pointer';
                removeBtn.style.boxShadow = '0 2px 4px rgba(0,0,0,0.2)';
                
                removeBtn.onclick = function(ev) {
                    ev.preventDefault();
                    const dt = new DataTransfer();
                    Array.from(subImgsDataTransfer.files).forEach((f, i) => {
                        if (i !== index) dt.items.add(f);
                    });
                    subImgsDataTransfer = dt;
                    subImgsInput.files = subImgsDataTransfer.files;
                    renderSubImages();
                };

                imgWrap.appendChild(img);
                imgWrap.appendChild(removeBtn);
                subImgsPreviewContainer.appendChild(imgWrap);
            }
            reader.readAsDataURL(file);
        });
    }

    subImgsInput?.addEventListener('change', function (e) {
        if (this.files && this.files.length > 0) {
            Array.from(this.files).forEach(file => {
                // Prevent duplicate files by name and size
                const exists = Array.from(subImgsDataTransfer.files).some(f => f.name === file.name && f.size === file.size);
                if (!exists) {
                    subImgsDataTransfer.items.add(file);
                }
            });
            this.files = subImgsDataTransfer.files;
            renderSubImages();
        } else {
            // If browser cleared the input (e.g. user clicked cancel), restore the old files
            this.files = subImgsDataTransfer.files;
        }
    });
})();

let specIndex = 0;
function addSpecRow(key = '', val = '', isHighlight = false) {
    document.getElementById('noSpecsHint').style.display = 'none';
    const tbody = document.getElementById('specsTableBody');
    
    const tr = document.createElement('tr');
    tr.id = `spec-row-${specIndex}`;
    tr.style.borderBottom = '1px solid var(--border-color)';
    
    tr.innerHTML = `
        <td style="padding: 8px;">
            <input type="text" name="Specifications[${specIndex}].Key" value="${key}" class="field-input" style="padding: 6px 10px;" placeholder="e.g. Speed / السرعة" required />
        </td>
        <td style="padding: 8px;">
            <input type="text" name="Specifications[${specIndex}].Value" value="${val}" class="field-input" style="padding: 6px 10px;" placeholder="e.g. 12 ppm" required />
        </td>
        <td style="padding: 8px; text-align: center; vertical-align: middle;">
            <input type="checkbox" name="Specifications[${specIndex}].IsHighlight" value="true" ${isHighlight ? 'checked' : ''} style="width: 18px; height: 18px; cursor: pointer; vertical-align: middle;" />
            <input type="hidden" name="Specifications[${specIndex}].IsHighlight" value="false" />
        </td>
        <td style="padding: 8px; text-align: center;">
            <button type="button" class="btn btn-sm btn-danger" onclick="removeSpecRow(${specIndex})" style="background: #EF4444; color: #fff; border: none; padding: 4px 8px; border-radius: 4px; cursor: pointer; display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; margin: 0 auto;">
                <i class='bx bx-trash' style="font-size: 1.1rem;"></i>
            </button>
        </td>
    `;
    tbody.appendChild(tr);
    specIndex++;
}

function removeSpecRow(idx) {
    const row = document.getElementById(`spec-row-${idx}`);
    if (row) {
        row.remove();
    }
    const tbody = document.getElementById('specsTableBody');
    if (tbody.children.length === 0) {
        document.getElementById('noSpecsHint').style.display = 'block';
    }
    reindexSpecRows();
}

function reindexSpecRows() {
    const tbody = document.getElementById('specsTableBody');
    const rows = tbody.children;
    specIndex = 0;
    for (let i = 0; i < rows.length; i++) {
        const row = rows[i];
        row.id = `spec-row-${specIndex}`;
        
        const keyInput = row.querySelector(`input[name^="Specifications"][name$=".Key"]`);
        const valInput = row.querySelector(`input[name^="Specifications"][name$=".Value"]`);
        const hlCheckbox = row.querySelector(`input[type="checkbox"][name^="Specifications"]`);
        const hlHidden = row.querySelector(`input[type="hidden"][name^="Specifications"]`);
        const deleteBtn = row.querySelector(`button[onclick^="removeSpecRow"]`);
        
        keyInput.name = `Specifications[${specIndex}].Key`;
        valInput.name = `Specifications[${specIndex}].Value`;
        hlCheckbox.name = `Specifications[${specIndex}].IsHighlight`;
        hlHidden.name = `Specifications[${specIndex}].IsHighlight`;
        deleteBtn.setAttribute('onclick', `removeSpecRow(${specIndex})`);
        
        specIndex++;
    }
}
</script>
}
