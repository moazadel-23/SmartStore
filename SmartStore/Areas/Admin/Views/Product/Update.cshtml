@model SmartStore.Models.Product
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Update Product";
    ViewData["PageTitle"] = "Product Management";
    var categories = ViewBag.category as IEnumerable<SmartStore.Models.Category>;
    var brands = ViewBag.brand as IEnumerable<SmartStore.Models.Brand>;
}

<link rel="stylesheet" href="~/css/category-admin.css">
<style>
    /* Additional layout helpers for Product */
    .grid-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }
    
    .file-input-wrapper {
        padding: 12px;
        border: 1px dashed var(--border-color);
        border-radius: 8px;
        background: var(--bg-color);
        transition: all 0.3s ease;
    }
    .file-input-wrapper:hover {
        border-color: var(--primary-color);
        background: rgba(var(--primary-rgb), 0.02);
    }
    .file-input-wrapper input[type="file"] {
        width: 100%;
        color: transparent;
        font-family: inherit;
        font-size: 0.9rem;
    }
    .file-input-wrapper input[type="file"]::file-selector-button {
        background: var(--primary-color);
        color: white;
        border: none;
        padding: 6px 12px;
        border-radius: 6px;
        margin-right: 12px;
        cursor: pointer;
        font-family: inherit;
        transition: opacity 0.3s ease;
    }
    .file-input-wrapper input[type="file"]::file-selector-button:hover {
        opacity: 0.9;
    }
    
    @@media (max-width: 768px) {
        .grid-2 { grid-template-columns: 1fr; }
    }
</style>

<div class="home-content">
    <!-- Breadcrumb -->
    <div class="breadcrumb-bar">
        <span class="bc-home"><i class='bx bxs-home-alt-2'></i> Home</span>
        <i class='bx bx-chevron-right bc-sep'></i>
        <a asp-action="Index" class="bc-link">Products</a>
        <i class='bx bx-chevron-right bc-sep'></i>
        <span class="bc-current">Update Product</span>
        <span class="bc-date">
            <i class='bx bx-calendar'></i>
            @DateTime.Now.ToString("dddd, MMMM dd yyyy")
        </span>
    </div>

    <!-- Page Title Row -->
    <div class="create-page-header">
        <div class="create-page-title">
            <div class="create-icon-wrap" style="background: rgba(16, 185, 129, 0.1); color: #10B981;">
                <i class='bx bx-box'></i>
            </div>
            <div>
                <h2>Update Product</h2>
                <p>Update the product details below</p>
            </div>
        </div>
    </div>

    <!-- Form -->
    <form asp-action="Update" asp-controller="Product" asp-area="Admin"
          method="post" id="updateProductForm" enctype="multipart/form-data" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="create-layout">

            <!-- LEFT: Main Details -->
            <div class="create-main">

                <!-- Basic Info Card -->
                <div class="create-card">
                    <div class="create-card-header">
                        <i class='bx bx-info-circle'></i>
                        <span>Basic Information</span>
                    </div>
                    <div class="create-card-body">

                        <!-- Name -->
                        <div class="form-field" id="field-name">
                            <label asp-for="Name" class="field-label">
                                Product Name <span class="field-required">*</span>
                            </label>
                            <div class="field-input-wrap">
                                <i class='bx bx-box field-icon'></i>
                                <input asp-for="Name" class="field-input" placeholder="e.g. Samsung Galaxy S23" autocomplete="off" id="nameInput">
                            </div>
                            <span asp-validation-for="Name" class="field-error"></span>
                        </div>

                        <!-- Description -->
                        <div class="form-field" id="field-desc">
                            <label asp-for="description" class="field-label">
                                Description
                            </label>
                            <div class="field-textarea-wrap">
                                <textarea asp-for="description" class="field-textarea" placeholder="Detailed product description..." rows="5" id="descInput"></textarea>
                            </div>
                            <span asp-validation-for="description" class="field-error"></span>
                        </div>

                    </div>
                </div>

                <!-- Pricing & Inventory Card -->
                <div class="create-card">
                    <div class="create-card-header">
                        <i class='bx bx-dollar-circle'></i>
                        <span>Pricing & Inventory</span>
                    </div>
                    <div class="create-card-body">
                        <div class="grid-2">
                            <!-- Price -->
                            <div class="form-field">
                                <label asp-for="Price" class="field-label">Price <span class="field-required">*</span></label>
                                <div class="field-input-wrap">
                                    <i class='bx bx-dollar field-icon'></i>
                                    <input asp-for="Price" type="number" step="0.01" class="field-input" placeholder="0.00">
                                </div>
                                <span asp-validation-for="Price" class="field-error"></span>
                            </div>

                            <!-- Quantity -->
                            <div class="form-field">
                                <label asp-for="Quantity" class="field-label">Quantity <span class="field-required">*</span></label>
                                <div class="field-input-wrap">
                                    <i class='bx bx-layer field-icon'></i>
                                    <input asp-for="Quantity" type="number" step="1" class="field-input" placeholder="0">
                                </div>
                                <span asp-validation-for="Quantity" class="field-error"></span>
                            </div>

                            <!-- Discount -->
                            <div class="form-field">
                                <label asp-for="Discount" class="field-label">Discount (%)</label>
                                <div class="field-input-wrap">
                                    <i class='bx bxs-discount field-icon'></i>
                                    <input asp-for="Discount" type="number" step="0.01" class="field-input" placeholder="0%">
                                </div>
                                <span asp-validation-for="Discount" class="field-error"></span>
                            </div>

                            <!-- Rate -->
                            <div class="form-field">
                                <label asp-for="Rate" class="field-label">Initial Rate (0-5)</label>
                                <div class="field-input-wrap">
                                    <i class='bx bxs-star field-icon'></i>
                                    <input asp-for="Rate" type="number" step="0.1" min="0" max="5" class="field-input" placeholder="e.g. 4.5">
                                </div>
                                <span asp-validation-for="Rate" class="field-error"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Media Card -->
                <div class="create-card">
                    <div class="create-card-header">
                        <i class='bx bx-image-add'></i>
                        <span>Product Media</span>
                    </div>
                    <div class="create-card-body">

                        <!-- Main Image -->
                        <label class="field-label">Main Image</label>
                        <div class="upload-area" id="imageUpload" style="position: relative; cursor: pointer; padding: 15px; border: 1px dashed var(--border-color); border-radius: 8px; text-align: center; background: rgba(0,0,0,0.02); margin-bottom: 20px;">
                            <input type="file" hidden id="mainImgInput" name="Img" accept="image/*" />
                            @if (!string.IsNullOrEmpty(Model.MainImg))
                            {
                                <img id="previewImg" src="~/ProductImg/@Model.MainImg"
                                     style="max-width:150px; border-radius:8px; display:block; margin: 0 auto;" />
                                <p style="color:#999; margin-top:6px; font-size:0.85em;">Click to change main image</p>
                            }
                            else
                            {
                                <i class='bx bx-image' style="font-size:28px; color:var(--primary-color);"></i>
                                <p style="color:#999; margin: 5px 0 0; font-size:0.9em;">Click to select main image</p>
                            }
                        </div>

                        <!-- Sub Images -->
                        <label class="field-label">Gallery Images</label>
                        <div class="upload-area" id="subImgsUpload" style="position: relative; cursor: pointer; padding: 15px; border: 1px dashed var(--border-color); border-radius: 8px; text-align: center; background: rgba(0,0,0,0.02);">
                            <input type="file" hidden id="subImgsInput" name="SubImgFiles" accept="image/*" multiple />
                            <i class='bx bx-images' style="font-size: 24px; color: var(--primary-color);"></i>
                            <p style="margin: 5px 0 0; font-size: 0.9em; color: var(--text-color);">Click here to add sub-images</p>
                        </div>

                        <div id="subImgsPreviewContainer" style="margin-top: 12px; display: flex; gap: 10px; flex-wrap: wrap;"></div>

                        @if (Model.ProductSubImgs != null && Model.ProductSubImgs.Count > 0)
                        {
                            <div style="margin-top: 12px; display: flex; gap: 10px; flex-wrap: wrap;">
                            @foreach (var item in Model.ProductSubImgs)
                            {
                                <div class="gallery-item existing-item" id="existing-@item.Id" style="position: relative; display: inline-block;">
                                    <img src="@Url.Content("~/ProductSubImges/" + item.SubImg)" style="width:110px; height:110px; object-fit:cover; border-radius:10px; border:2px solid #eee;" />
                                    <button type="button" onclick="removeExistingImage('@item.Id')"
                                            style="position:absolute; top:-8px; right:-8px; background:#ff4757; color:white; border:none; border-radius:50%; width:24px; height:24px; cursor:pointer; display:flex; align-items:center; justify-content:center; box-shadow: 0 2px 5px rgba(0,0,0,0.2);">
                                        <i class="bx bx-x" style="font-size: 16px;"></i>
                                    </button>
                                </div>
                            }
                            </div>
                        }

                    </div>
                </div>

            </div>

            <!-- RIGHT: Sidebar Panels -->
            <div class="create-sidebar">

                <!-- Organization Card -->
                <div class="create-card">
                    <div class="create-card-header">
                        <i class='bx bx-sitemap'></i>
                        <span>Organization</span>
                    </div>
                    <div class="create-card-body">

                        <!-- Category -->
                        <div class="form-field">
                            <label class="field-label">Category <span class="field-required">*</span></label>
                            <div class="field-input-wrap" style="padding-left: 0;">
                                <select name="CategoryId" class="field-input" style="padding-left: 14px;" required>
                                    <option value="" disabled selected>Select Category...</option>
                                    @if(categories != null)
                                    {
                                        foreach(var cat in categories)
                                        {
                                            if (Model.CategoryId == cat.Id)
                                            {
                                                <option value="@cat.Id" selected>@cat.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@cat.Id">@cat.Name</option>
                                            }
                                        }
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- Brand -->
                        <div class="form-field">
                            <label class="field-label">Brand <span class="field-required">*</span></label>
                            <div class="field-input-wrap" style="padding-left: 0;">
                                <select name="BrandId" class="field-input" style="padding-left: 14px;" required>
                                    <option value="" disabled selected>Select Brand...</option>
                                    @if(brands != null)
                                    {
                                        foreach(var brand in brands)
                                        {
                                            if (Model.BrandId == brand.Id)
                                            {
                                                <option value="@brand.Id" selected>@brand.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@brand.Id">@brand.Name</option>
                                            }
                                        }
                                    }
                                </select>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Publish Card -->
                <div class="create-card">
                    <div class="create-card-header">
                        <i class='bx bx-send'></i>
                        <span>Publish</span>
                    </div>
                    <div class="create-card-body">

                        <!-- Status Toggle -->
                        <div class="form-field">
                            <label class="field-label">Status</label>
                            <div class="status-toggle-group" id="statusToggle">
                                <label class="status-option status-active-opt @(Model.Status == true ? "selected" : "")" id="statusActiveLabel">
                                    <input type="radio" name="Status" value="true" id="statusActive" @(Model.Status == true ? "checked" : "")>
                                    <i class='bx bx-check-circle'></i>
                                    <div>
                                        <span class="st-title">Active</span>
                                        <span class="st-desc">Visible to customers</span>
                                    </div>
                                </label>
                                <label class="status-option status-inactive-opt @(Model.Status == false ? "selected" : "")" id="statusInactiveLabel">
                                    <input type="radio" name="Status" value="false" id="statusInactive" @(Model.Status == false ? "checked" : "")>
                                    <i class='bx bx-x-circle'></i>
                                    <div>
                                        <span class="st-title">Inactive</span>
                                        <span class="st-desc">Hidden from store</span>
                                    </div>
                                </label>
                            </div>
                        </div>

                        <div class="publish-divider"></div>

                        <!-- Actions -->
                        <div class="publish-actions">
                            <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="pub-cancel-btn">
                                <i class='bx bx-x'></i> Cancel
                            </a>
                            <button type="submit" class="pub-submit-btn" id="submitBtn">
                                <i class='bx bx-check'></i>
                                <span>Update Product</span>
                                <div class="btn-loader" id="btnLoader"></div>
                            </button>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </form>
</div>

@section Scripts {
<script>
(function () {
    /* Status Toggle */
    const statusActive = document.getElementById('statusActive');
    const statusInactive = document.getElementById('statusInactive');
    const statusActiveLabel = document.getElementById('statusActiveLabel');
    const statusInactLabel = document.getElementById('statusInactiveLabel');

    function syncStatus() {
        const isActive = statusActive?.checked;
        statusActiveLabel?.classList.toggle('selected', !!isActive);
        statusInactLabel?.classList.toggle('selected', !isActive);
    }
    statusActive?.addEventListener('change', syncStatus);
    statusInactive?.addEventListener('change', syncStatus);

    /* Form Submission Feedback */
    const form = document.getElementById('updateProductForm');
    const submitBtn = document.getElementById('submitBtn');
    const btnLoader = document.getElementById('btnLoader');

    form?.addEventListener('submit', function (e) {
        if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.querySelector('span').textContent = 'Updating...';
            if (btnLoader) btnLoader.style.display = 'block';
        }
    });

    /* Input focus styling */
    document.querySelectorAll('.field-input, .field-textarea').forEach(el => {
        el.addEventListener('focus', () => el.closest('.form-field')?.classList.add('focused'));
        el.addEventListener('blur',  () => el.closest('.form-field')?.classList.remove('focused'));
    });

    /* Entrance animation */
    document.querySelectorAll('.create-card').forEach((card, i) => {
        card.style.opacity   = '0';
        card.style.transform = 'translateY(16px)';
        setTimeout(() => {
            card.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
            card.style.opacity    = '1';
            card.style.transform  = 'translateY(0)';
        }, 80 + i * 80);
    });

    /* Image Previews */
    const mainImgInput = document.getElementById('mainImgInput');
    const mainImgPreviewContainer = document.getElementById('imageUpload');
    const mainImgPreview = document.getElementById('previewImg');
    
    // Allow clicking the main upload area to trigger file input
    mainImgPreviewContainer?.addEventListener('click', function() {
        mainImgInput?.click();
    });

    mainImgInput?.addEventListener('change', function (e) {
        if (this.files && this.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                if (mainImgPreview) {
                    mainImgPreview.src = e.target.result;
                } else {
                    // Create preview img element if it doesn't exist
                    const newImg = document.createElement('img');
                    newImg.id = 'previewImg';
                    newImg.src = e.target.result;
                    newImg.width = 150;
                    newImg.style.marginTop = '10px';
                    newImg.style.borderRadius = '8px';
                    
                    // Remove existing paragraph text
                    const p = mainImgPreviewContainer.querySelector('p');
                    if (p) p.remove();
                    
                    mainImgPreviewContainer.appendChild(newImg);
                }
            }
            reader.readAsDataURL(this.files[0]);
        }
    });

    const subImgsUploadArea = document.getElementById('subImgsUpload');
    subImgsUploadArea?.addEventListener('click', function() {
        subImgsInput?.click();
    });

    const subImgsInput = document.getElementById('subImgsInput');
    const subImgsPreviewContainer = document.getElementById('subImgsPreviewContainer');
    let subImgsDataTransfer = new DataTransfer();

    function renderSubImages() {
        subImgsPreviewContainer.innerHTML = '';
        Array.from(subImgsDataTransfer.files).forEach((file, index) => {
            const reader = new FileReader();
            reader.onload = function(e) {
                const imgWrap = document.createElement('div');
                imgWrap.style.position = 'relative';
                imgWrap.style.display = 'inline-block';
                
                const img = document.createElement('img');
                img.src = e.target.result;
                img.style.width = '60px';
                img.style.height = '60px';
                img.style.borderRadius = '6px';
                img.style.border = '1px solid var(--border-color)';
                img.style.objectFit = 'cover';
                
                const removeBtn = document.createElement('span');
                removeBtn.innerHTML = '<i class="bx bx-x"></i>';
                removeBtn.style.position = 'absolute';
                removeBtn.style.top = '-6px';
                removeBtn.style.right = '-6px';
                removeBtn.style.background = '#EF4444';
                removeBtn.style.color = 'white';
                removeBtn.style.borderRadius = '50%';
                removeBtn.style.width = '18px';
                removeBtn.style.height = '18px';
                removeBtn.style.display = 'flex';
                removeBtn.style.alignItems = 'center';
                removeBtn.style.justifyContent = 'center';
                removeBtn.style.fontSize = '14px';
                removeBtn.style.cursor = 'pointer';
                removeBtn.style.boxShadow = '0 2px 4px rgba(0,0,0,0.2)';
                
                removeBtn.onclick = function(ev) {
                    ev.preventDefault();
                    ev.stopPropagation(); // prevent triggering upload area click
                    const dt = new DataTransfer();
                    Array.from(subImgsDataTransfer.files).forEach((f, i) => {
                        if (i !== index) dt.items.add(f);
                    });
                    subImgsDataTransfer = dt;
                    subImgsInput.files = subImgsDataTransfer.files;
                    renderSubImages();
                };

                imgWrap.appendChild(img);
                imgWrap.appendChild(removeBtn);
                subImgsPreviewContainer.appendChild(imgWrap);
            }
            reader.readAsDataURL(file);
        });
    }

    subImgsInput?.addEventListener('change', function (e) {
        if (this.files && this.files.length > 0) {
            Array.from(this.files).forEach(file => {
                // Prevent duplicate files by name and size
                const exists = Array.from(subImgsDataTransfer.files).some(f => f.name === file.name && f.size === file.size);
                if (!exists) {
                    subImgsDataTransfer.items.add(file);
                }
            });
            this.files = subImgsDataTransfer.files;
            renderSubImages();
        } else {
            this.files = subImgsDataTransfer.files;
        }
    });
    
    window.removeExistingImage = function(id) {
        const el = document.getElementById('existing-' + id);
        if (el) {
            el.style.display = 'none';
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'DeletedSubImgIds';
            input.value = id;
            document.getElementById('updateProductForm').appendChild(input);
        }
    };
})();
</script>
}
